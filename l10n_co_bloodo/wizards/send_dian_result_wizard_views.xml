<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="send_dian_result_form" model="ir.ui.view">
            <field name="name">l10n.co.bloodo.send.dian.result.form</field>
            <field name="model">l10n.co.bloodo.send.dian.result</field>
            <field name="arch" type="xml">
                <form string="Resultado: Envío a la DIAN">
                    <sheet>
                        <group>
                            <group>
                                <field name="count_success"/>
                            </group>
                            <group>
                                <field name="count_failed"/>
                            </group>
                        </group>
                        <field name="result_line_ids" readonly="1" nolabel="1">
                            <list create="0" edit="0" delete="0">
                                <field name="move_name"/>
                                <field name="success" widget="boolean_toggle"/>
                                <field name="message"/>
                                <button name="open_move" type="object" string="Ver" icon="fa-external-link" class="btn-link" invisible="not move_id"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button string="Cerrar" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
