<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_dian_invoice_intake_list" model="ir.ui.view">
            <field name="name">dian.invoice.intake.list</field>
            <field name="model">dian.invoice.intake</field>
            <field name="arch" type="xml">
                <list decoration-danger="state == 'error'"
                      decoration-warning="state == 'partial'"
                      decoration-muted="state == 'skipped'"
                      decoration-success="state == 'processed'">
                    <field name="name"/>
                    <field name="received_date"/>
                    <field name="email_from"/>
                    <field name="email_subject"/>
                    <field name="dian_document_ids" widget="many2many_tags"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="view_dian_invoice_intake_form" model="ir.ui.view">
            <field name="name">dian.invoice.intake.form</field>
            <field name="model">dian.invoice.intake</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_retry" string="Reintentar"
                                type="object" class="btn-primary"
                                groups="account.group_account_manager"
                                invisible="state in ('processed', 'skipped')"/>
                        <button name="action_view_dian_document"
                                string="Ver en Facturas DIAN"
                                type="object" class="btn-secondary"
                                invisible="not dian_document_ids"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="new,processed"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="email_from"/>
                                <field name="email_subject"/>
                                <field name="received_date"/>
                            </group>
                            <group>
                                <field name="company_id"/>
                                <field name="dian_document_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="Detalle" invisible="not error_message">
                            <field name="error_message" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_dian_invoice_intake_search" model="ir.ui.view">
            <field name="name">dian.invoice.intake.search</field>
            <field name="model">dian.invoice.intake</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="email_from"/>
                    <field name="dian_document_ids"/>
                    <filter name="error" string="Error"
                            domain="[('state', '=', 'error')]"/>
                    <filter name="partial" string="Parcial"
                            domain="[('state', '=', 'partial')]"/>
                    <filter name="processed" string="Procesadas"
                            domain="[('state', '=', 'processed')]"/>
                    <separator/>
                    <filter name="group_state" string="Estado"
                            context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <record id="action_dian_invoice_intake" model="ir.actions.act_window">
            <field name="name">Bandeja FE Proveedor (correo)</field>
            <field name="res_model">dian.invoice.intake</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_dian_invoice_intake_search"/>
            <field name="context">{'search_default_error': 1, 'search_default_partial': 1}</field>
        </record>

        <menuitem id="menu_dian_invoice_intake"
                  name="Bandeja FE Proveedor (correo)"
                  parent="l10n_co_dian_invoice_synchronizer.dian_invoices_menu_categ"
                  action="action_dian_invoice_intake"
                  groups="l10n_co_bloodo.group_dian_invoice_intake"
                  sequence="60"/>

    </data>
</odoo>
