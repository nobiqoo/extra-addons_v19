<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Multi-company: XML detail of dian.document (same rule as the document) -->
        <record id="rule_dian_document_tax_total_company_comp" model="ir.rule">
            <field name="name">DIAN Document Tax Total: multi-company</field>
            <field name="model_id" ref="model_dian_document_tax_total"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_dian_document_invoice_line_company_comp" model="ir.rule">
            <field name="name">DIAN Document Invoice Line: multi-company</field>
            <field name="model_id" ref="model_dian_document_invoice_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Multi-company: mail intake of supplier e-invoices -->
        <record id="rule_dian_invoice_intake_company_comp" model="ir.rule">
            <field name="name">DIAN Invoice Intake: multi-company</field>
            <field name="model_id" ref="model_dian_invoice_intake"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
