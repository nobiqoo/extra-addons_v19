#. module: l10n_co_bloodo
#: model:mail.template,body_html:l10n_co_bloodo.dian_email_template
msgid ""
"\n"
"            <div style=\"font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: #222222; background-color: #FFF; \">\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    Señor(es),\n"
"                    <br>\n"
"                    <t t-out=\"object.partner_id.name\"></t>\n"
"                </p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    Le informamos que ha recibido una factura/nota electrónica de <t t-out=\"object.company_id.name\"></t>:\n"
"                </p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    Número de factura: <strong t-out=\"object.fe_invoice_name\" style=\"box-sizing:border-box;font-weight:500;\"></strong><br>\n"
"                    A nombre de: <strong t-out=\"object.partner_id.name\" style=\"box-sizing:border-box;font-weight:500;\"></strong><br>\n"
"                    Valor Total: <strong t-out=\"object.amount_total\" style=\"box-sizing:border-box;font-weight:500;\"></strong> <strong t-out=\"object.currency_id.name\" style=\"box-sizing:border-box;font-weight:500;\"></strong>\n"
"                </p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    Si tiene inquietud respecto a la información contenida en la factura/nota electrónica, \n"
"                    responda este correo electrónico.\n"
"                </p>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">\n"
"                    Si pasados tres (3) días hábiles siguientes a la recepción de la factura/nota electrónica, no se ha recibido un correo indicando rechazo de la factura/nota electrónica, el sistema la dará por aceptada.\n"
"                    <br>\n"
"                    <br>\n"
"                    Escriba a <t t-out=\"object.company_id.edi_email\"></t> si desea modificar sus datos para el envío de la factura/nota electrónica.\n"
"                </p>\n"
"                <br>\n"
"                <p style=\"margin:0px 0 12px 0;box-sizing:border-box;\">Cordialmente,</p>\n"
"                <t t-out=\"object.invoice_user_id.signature\"></t>\n"
"                <!-- <p><strong><t t-out=\"object.company_id.name\"></t></strong></p> -->\n"
"            </div>\n"
"            "
msgstr ""

#. module: l10n_co_bloodo
#: model:mail.template,body_html:l10n_co_bloodo.dian_event_email_template
msgid ""
"\n"
"            <div style=\"font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; \">\n"
"                <p>\n"
"                    Señor(es),\n"
"                    <br>\n"
"                    <t t-out=\"object.partner_id.name\"/>\n"
"                </p>\n"
"                <p t-if=\"object.is_supplier_ei\">\n"
"                    Le informamos que se ha generado el evento <strong t-out=\"object.ie_event_active_id.ev_id.display_name\"/><br>\n"
"                    a la factura/nota electrónica <strong t-out=\"object.name_ei_ref\"/>.\n"
"                </p>\n"
"                <p t-else=\"\">\n"
"                    Le informamos que se ha generado el evento <strong t-out=\"object.ie_event_active_id.ev_id.display_name\"/><br>\n"
"                    a la factura/nota electrónica <strong t-out=\"object.name\"/>.\n"
"                </p>\n"
"                <p t-if=\"object.ie_event_active_id.notes\">\n"
"                    <strong>NOTA:</strong> <t t-out=\"object.ie_event_active_id.notes\"/>\n"
"                </p>\n"
"                <p>\n"
"                    <!-- Si pasados tres (3) días hábiles siguientes a la recepción de la factura/nota electrónica, no se ha recibido un correo indicando rechazo de la factura/nota electrónica, el sistema la dará por aceptada. -->\n"
"                    <br>\n"
"                    <br>\n"
"                    Escriba a <t t-out=\"object.company_id.edi_email\"/> si desea modificar sus datos para el envío de la factura/nota electrónica.\n"
"                </p>\n"
"                <br>\n"
"                <p>Cordialmente,</p>\n"
"                <t t-out=\"object.invoice_user_id.signature\"/>\n"
"                <!-- <p><strong><t t-out=\"object.company_id.name\"/></strong></p> -->\n"
"            </div>\n"
"            "
msgstr ""

