<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Fetches the XML of received DIAN documents (GetXmlByDocumentKey).
             The batch size is read from the system parameter
             l10n_co_bloodo.dian_document_xml_batch_size (default 10). -->
        <record id="cron_dian_document_fetch_xml" model="ir.cron">
            <field name="name">DIAN: Obtener XML de documentos recibidos</field>
            <field name="model_id" ref="l10n_co_dian_invoice_synchronizer.model_dian_document"/>
            <field name="state">code</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="code">model._cron_fetch_xml()</field>
        </record>

    </data>
</odoo>
