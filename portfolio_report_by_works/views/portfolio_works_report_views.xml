<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="portfolio_works_report_view_form" model="ir.ui.view">
            <field name="name">portfolio.works.report.view.form</field>
            <field name="model">portfolio.works.report</field>
            <field name="arch" type="xml">
                <form string="Create portfolio detail">
                <sheet>
                    <group>
                        <field name="customer_ids" context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"/>
                        <field name="cut_date"/>
                        <field name="work_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Generate report" name="create_report" type="object" class="oe_highlight"/>
                </footer>
                </form>
            </field>
        </record>

        <record id="portfolio_works_report_xlsx_form" model="ir.ui.view">
            <field name="name">portfolio.works.report.xlsx.form</field>
            <field name="model">portfolio.works.report.xlsx</field>
            <field name="arch" type="xml">
                <form string="Download File">
                    <group>
                        <field name="file_name" readonly="1" invisible="1"/>
                        <field name="file_binary" filename="file_name" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="portfolio_works_report_action" model="ir.actions.act_window">
            <field name="name">Portfolio works report</field>
            <field name="res_model">portfolio.works.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="portfolio_works_report_menu" 
            action="portfolio_works_report_action" 
            parent="account.menu_finance_reports" 
            sequence="8"/>

    </data>
</odoo>