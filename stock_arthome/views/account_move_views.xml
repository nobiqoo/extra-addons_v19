<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_delivery_comment_arthome" model="ir.ui.view">
        <field name="name">account.move.form.delivery.comment.arthome</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']//field[@name='narration']/../.." position="before">
                <group name="delivery_comment_group" invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="delivery_comment"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
