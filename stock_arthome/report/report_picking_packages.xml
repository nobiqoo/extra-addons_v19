<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_picking_packages_order_info_arthome" inherit_id="stock.report_picking_packages">
        <xpath expr="//t[@t-set='docs']" position="before">
            <t t-set="package_pickings" t-value="{package.id: picking for picking in docs.filtered('order_info_applicable') for package in picking._get_packages_for_print()}"/>
        </xpath>
    </template>

    <template id="report_package_barcode_order_info_arthome" inherit_id="stock.report_package_barcode">
        <xpath expr="//div[@t-if='o.package_type_id']/.." position="after">
            <t t-set="package_picking" t-value="package_pickings and package_pickings.get(o.id)"/>
            <t t-if="package_picking">
                <div class="row mt-3" name="package_order_info">
                    <div t-if="package_picking.order_reference" class="col" name="div_order_reference">
                        <strong>Order Number:</strong>
                        <span t-field="package_picking.order_reference"/>
                    </div>
                    <div t-if="package_picking.salesperson_name" class="col" name="div_salesperson">
                        <strong>Salesperson:</strong>
                        <span t-field="package_picking.salesperson_name"/>
                    </div>
                </div>
                <div t-if="package_picking.delivery_comment" class="mt-3" name="div_delivery_comment">
                    <strong>Dispatch Note/Instruction:</strong>
                    <div t-field="package_picking.delivery_comment" class="border rounded p-2 fw-bold" style="background-color: #e9ecef;"/>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
