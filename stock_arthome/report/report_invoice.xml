<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Factura: comentarios de despacho -->
    <template id="report_invoice_document_delivery_comment_arthome" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@name='comment']" position="after">
            <div t-if="o.delivery_comment" class="mb-3" name="delivery_comment">
                <strong>Dispatch Note/Instruction</strong>
                <div t-field="o.delivery_comment"/>
            </div>
        </xpath>
    </template>

    <!-- Factura electrónica: comentarios de despacho -->
    <template id="report_einvoicing_document_delivery_comment_arthome" inherit_id="l10n_co_bloodo.report_account_move_einvoicing_document">
        <xpath expr="//t[@t-if='doc.narration']" position="after">
            <div t-if="doc.delivery_comment" class="p_info" name="delivery_comment">
                <strong>Dispatch Note/Instruction:</strong>
                <span t-field="doc.delivery_comment"/>
            </div>
        </xpath>
    </template>

</odoo>
