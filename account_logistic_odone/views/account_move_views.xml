<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="city" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="position" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="hbl" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="volume" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="motor_ship" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="networks_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="container_number" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="origin" string="Origin" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="destination" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="customer_order" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
                <field name="text_weight" invisible="move_type not in ('out_invoice','out_refund','in_invoice','in_refund')"/>
            </xpath>
            <xpath expr="//notebook/page[@id='invoice_tab']/field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="city"/>
                <field name="code"/>
            </xpath>
            <xpath expr="//notebook/page[@id='aml_tab']/field[@name='line_ids']/list/field[@name='account_internal_group']" position="after">
                <field name="city" invisible="1"/>
                <field name="code" invisible="1"/>
            </xpath>
            <xpath expr="//notebook/page[@id='invoice_tab']/field[@name='invoice_line_ids']/form/sheet/group[1]" position="inside">
                <field name="city"/>
                <field name="code"/>
            </xpath>
        </field>
    </record>

</odoo>
