<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dian_sync_tree" model="ir.ui.view">
        <field name="name">dian.sync.tree</field>
        <field name="model">dian.sync</field>
        <field name="arch" type="xml">
            <list string="Synchronizations" create="0">
                <field name="name" />
                <field name="sync_date" />
                <field name="sync_period" />
                <field name="user_id" />
                <field name="document_count" />
                <field name="already_in_system_count" />
                <field name="application_response_count" />
                <field name="mapping_error_count" />
                <field name="dian_records_filtered" />
                <field name="unaccounted_count" decoration-danger="unaccounted_count != 0" />
            </list>
        </field>
    </record>

    <record id="view_dian_sync_form" model="ir.ui.view">
        <field name="name">dian.sync.form</field>
        <field name="model">dian.sync</field>
        <field name="arch" type="xml">
            <form string="Synchronization">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <h1><field name="name" readonly="1" class="oe_inline" /></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="sync_date" />
                            <field name="sync_period" />
                            <field name="sync_duration_seconds" />
                            <field name="user_id" />
                        </group>
                        <group string="Summary">
                            <field name="document_count" readonly="1" />
                            <field name="already_in_system_count" readonly="1" />
                            <field name="application_response_count" readonly="1" />
                            <field name="mapping_error_count" readonly="1" />
                            <field name="dian_records_filtered" readonly="1" />
                            <field name="unaccounted_count" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents" name="documents">
                            <field name="document_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="name" />
                                    <field name="cufe" />
                                    <field name="reception" />
                                    <field name="sender" />
                                    <field name="receiver" />
                                    <field name="total_amount" />
                                </list>
                            </field>
                        </page>
                        <page string="Discarded" name="discarded">
                            <field name="discarded_html" nolabel="1" readonly="1" />
                        </page>
                        <page string="Mapping Errors" name="mapping_errors">
                            <field name="mapping_errors_html" nolabel="1" readonly="1" />
                        </page>
                        <page string="Error Summary" name="error_summary">
                            <field name="error_summary_html" nolabel="1" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dian_sync" model="ir.actions.act_window">
        <field name="name">Synchronizations</field>
        <field name="res_model">dian.sync</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_order': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No synchronizations yet.
            </p>
            <p>
                Use the DIAN Invoice Synchronizer wizard to fetch invoices from the DIAN catalog.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_dian_sync"
        name="Synchronizations"
        parent="dian_invoices_menu_categ"
        action="action_dian_sync"
        sequence="10" />

</odoo>