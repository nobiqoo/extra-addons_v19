<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dian_document_no_invoice_list" model="ir.ui.view">
        <field name="name">dian.document.no.invoice.list</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <list string="Documents without Invoice" create="0" delete="0">
                <field name="name" />
                <field name="reception" />
                <field name="cufe" />
                <field name="sender" />
                <field name="sender_vat" />
                <field name="result" />
                <field name="total_amount" />
                <field name="invoice_type" />
                <field name="payment_means_code" />
            </list>
        </field>
    </record>

    <record id="view_dian_document_no_purchase_list" model="ir.ui.view">
        <field name="name">dian.document.no.purchase.list</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <list string="Documents without Purchase Order" create="0" delete="0">
                <field name="name" />
                <field name="reception" />
                <field name="cufe" />
                <field name="sender" />
                <field name="sender_vat" />
                <field name="order_reference" />
                <field name="result" />
                <field name="total_amount" />
                <field name="invoice_type" />
                <field name="move_id" />
            </list>
        </field>
    </record>

    <record id="view_dian_document_all_list" model="ir.ui.view">
        <field name="name">dian.document.all.list</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <list string="All Documents" create="0" delete="0">
                <field name="name" />
                <field name="reception" />
                <field name="cufe" />
                <field name="sender" />
                <field name="sender_vat" />
                <field name="order_reference" />
                <field name="result" />
                <field name="total_amount" />
                <field name="invoice_type" />
                <field name="move_id" />
                <field name="purchase_id" />
            </list>
        </field>
    </record>

    <record id="view_dian_document_search" model="ir.ui.view">
        <field name="name">dian.document.search</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <search string="DIAN Documents">
                <field name="name" />
                <field name="cufe" />
                <field name="sender" />
                <field name="sender_vat" />
                <field name="sender_id" />
                <field name="purchase_id" />
                <field name="order_reference" />
                <field name="invoice_type" />
                <field name="payment_means_code" />
                <field name="reception" />
                <filter name="reception_date" string="Reception Date" date="reception" />
                <separator />
                <filter string="Without vendor" name="filter_no_sender"
                    domain="[('sender_id', '=', False), ('sender_vat', '!=', False)]" />
                <filter string="Without Purchase Order" name="filter_no_po"
                    domain="[('purchase_id', '=', False), ('order_reference', '!=', False)]" />
                <filter string="Sender VAT mismatch" name="filter_sender_vat_mismatch"
                    domain="[('sender_vat_match', '=', False), ('sender_vat_xml', '!=', False)]" />
                <separator />
                <filter string="Invalid / Unspecified" name="filter_invoice_type_invalid"
                    domain="[('invoice_type', '=', '')]" />
                <filter string="01 - Electronic sales invoice" name="filter_invoice_type_01"
                    domain="[('invoice_type', '=', '01')]" />
                <filter string="02 - Electronic export sales invoice" name="filter_invoice_type_02"
                    domain="[('invoice_type', '=', '02')]" />
                <filter string="03 - Electronic transmission instrument - type 03"
                    name="filter_invoice_type_03" domain="[('invoice_type', '=', '03')]" />
                <filter string="04 - Electronic sales invoice - type 04"
                    name="filter_invoice_type_04" domain="[('invoice_type', '=', '04')]" />
                <filter string="91 - Credit note" name="filter_invoice_type_91"
                    domain="[('invoice_type', '=', '91')]" />
                <filter string="92 - Debit note" name="filter_invoice_type_92"
                    domain="[('invoice_type', '=', '92')]" />
                <filter string="96 - Events (ApplicationResponse)" name="filter_invoice_type_96"
                    domain="[('invoice_type', '=', '96')]" />
                <filter string="20 - Electronic equivalent of POS cash register receipt"
                    name="filter_invoice_type_20" domain="[('invoice_type', '=', '20')]" />
                <filter string="25 - Cinema admission ticket" name="filter_invoice_type_25"
                    domain="[('invoice_type', '=', '25')]" />
                <filter string="27 - Public show admission ticket" name="filter_invoice_type_27"
                    domain="[('invoice_type', '=', '27')]" />
                <filter string="30 - Localized and non-localized gaming"
                    name="filter_invoice_type_30" domain="[('invoice_type', '=', '30')]" />
                <filter string="35 - Land passenger transport ticket" name="filter_invoice_type_35"
                    domain="[('invoice_type', '=', '35')]" />
                <filter string="40 - Toll collection document" name="filter_invoice_type_40"
                    domain="[('invoice_type', '=', '40')]" />
                <filter string="45 - Statement issued by financial institutions"
                    name="filter_invoice_type_45" domain="[('invoice_type', '=', '45')]" />
                <filter string="50 - Air passenger transport ticket" name="filter_invoice_type_50"
                    domain="[('invoice_type', '=', '50')]" />
                <filter string="55 - Stock exchange, agricultural and commodities"
                    name="filter_invoice_type_55" domain="[('invoice_type', '=', '55')]" />
                <filter string="60 - Public and residential utilities document"
                    name="filter_invoice_type_60" domain="[('invoice_type', '=', '60')]" />
                <separator />
                    <filter string="Invoice Type" name="group_invoice_type"
                        context="{'group_by': 'invoice_type'}" />
                    <filter string="Payment Means" name="group_payment_means_code"
                        context="{'group_by': 'payment_means_code'}" />
                    <filter string="Result" name="group_result" context="{'group_by': 'result'}" />
                    <filter string="Sender" name="group_sender" context="{'group_by': 'sender'}" />
                    <filter string="Vendor" name="group_sender_id" context="{'group_by': 'sender_id'}" />
            </search>
        </field>
    </record>

    <record id="view_dian_document_form" model="ir.ui.view">
        <field name="name">dian.document.form</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <form string="DIAN Document" create="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <group>
                        <group string="Identification">
                            <field name="name" readonly="1" />
                            <field name="cufe" readonly="1" options="{'no_create': True}" />
                            <field name="reception" readonly="1" />
                            <field name="type" readonly="1" />
                            <field name="order_reference" readonly="1" />
                            <field name="sync_id" readonly="1" options="{'no_create': True}" />
                            <field name="document_type" invisible="1" />
                        </group>
                        <group string="Status">
                            <field name="result" readonly="1" />
                            <field name="radina_result" readonly="1" />
                            <field name="has_xml_info" readonly="1" />
                            <field name="move_id" options="{'no_create': True}" />
                            <field name="purchase_id" options="{'no_create': True}" />
                        </group>
                    </group>
                    <group>
                        <group string="Sender">
                            <field name="sender" readonly="1" placeholder="Sender name" />
                            <field name="sender_vat" readonly="1" placeholder="NIT / VAT" />
                            <field name="sender_vat_xml" readonly="1" placeholder="NIT / VAT (XML)" />
                            <field name="sender_vat_match" readonly="1" />
                            <field name="sender_id" readonly="1" options="{'no_create': True}" />
                            <div colspan="2" class="text-warning" invisible="sender_id or not sender_vat">
                                <span class="fa fa-exclamation-triangle" title="Warning" />
                                No contact found with identification number <field name="sender_vat" readonly="1" class="oe_inline" nolabel="1" />.
                            </div>
                        </group>
                        <group string="Receiver">
                            <field name="receiver" readonly="1" placeholder="Receiver name" />
                            <field name="receiver_vat" readonly="1" placeholder="NIT / VAT" />
                        </group>
                    </group>
                    <group>
                        <group string="Amounts (from API)">
                            <field name="total_amount" readonly="1" />
                            <field name="tax_amount_5_percent" readonly="1" />
                            <field name="tax_amount_19_percent" readonly="1" />
                            <field name="tax_amount_iva" readonly="1" />
                            <field name="tax_amount_ica" readonly="1" />
                            <field name="tax_amount_ipc" readonly="1" />
                        </group>
                        <group string="Amounts (from XML)" invisible="not has_xml_info">
                            <field name="currency_id" readonly="1" options="{'no_create': True}" />
                            <field name="invoice_type" readonly="1" />
                            <field name="payment_means_code" readonly="1" />
                            <field name="line_extension_amount" readonly="1" />
                            <field name="tax_exclusive_amount" readonly="1" />
                            <field name="tax_inclusive_amount" readonly="1" />
                            <field name="payable_amount" readonly="1" />
                        </group>
                    </group>
                    <group string="Credit note (from XML)"
                        invisible="invoice_type != '91' or not has_xml_info">
                        <field name="discrepancy_reference_id" readonly="1"
                            placeholder="Reference to adjusted invoice" />
                        <field name="discrepancy_response_code" readonly="1"
                            placeholder="Response code" />
                    </group>
                    <notebook>
                        <page string="Invoice Lines" name="invoice_lines">
                            <field name="invoice_line_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="sellers_item_identification"
                                        column_invisible="parent.invoice_type == '91'" />
                                    <field name="manufacturers_item_identification"
                                        column_invisible="parent.invoice_type != '91'" />
                                    <field name="standard_item_identification" />
                                    <field name="description" />
                                    <field name="line_number" />
                                    <field name="invoiced_quantity"
                                        column_invisible="parent.invoice_type == '91'" />
                                    <field name="credited_quantity"
                                        column_invisible="parent.invoice_type != '91'" />
                                    <field name="quantity_unit_code" />
                                    <field name="price_amount" />
                                    <field name="line_extension_amount" />
                                </list>
                            </field>
                        </page>
                        <page string="Tax Summary" name="tax_totals">
                            <field name="tax_total_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="tax_scheme_name" />
                                    <field name="tax_scheme_id" />
                                    <field name="taxable_amount" />
                                    <field name="percent" />
                                    <field name="tax_amount" />
                                </list>
                            </field>
                        </page>
                        <page string="XML / Errors" name="xml_errors"
                            invisible="not xml_query_error_message">
                            <group>
                                <field name="xml_query_error_message" nolabel="1" readonly="1"
                                    placeholder="No error message." />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dian_document_tax_total_form" model="ir.ui.view">
        <field name="name">dian.document.tax.total.form</field>
        <field name="model">dian.document.tax.total</field>
        <field name="arch" type="xml">
            <form string="Tax Total" create="0" delete="0">
                <sheet>
                    <group>
                        <group string="Context">
                            <field name="name" readonly="1" />
                            <field name="document_id" readonly="1" options="{'no_create': True}" />
                            <field name="invoice_line_id" readonly="1" options="{'no_create': True}" />
                        </group>
                        <group string="Tax details">
                            <field name="tax_scheme_name" readonly="1" />
                            <field name="tax_scheme_id" readonly="1" />
                            <field name="percent" readonly="1" />
                            <field name="taxable_amount" readonly="1" />
                            <field name="tax_amount" readonly="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dian_document_invoice_line_form" model="ir.ui.view">
        <field name="name">dian.document.invoice.line.form</field>
        <field name="model">dian.document.invoice.line</field>
        <field name="arch" type="xml">
            <form string="Invoice Line" create="0" delete="0">
                <sheet>
                    <group>
                        <group string="Line">
                            <field name="name" readonly="1" />
                            <field name="document_id" readonly="1" options="{'no_create': True}" />
                            <field name="line_number" readonly="1" />
                            <field name="description" readonly="1" nolabel="0" />
                        </group>
                        <group string="Quantity and price">
                            <field name="invoiced_quantity" readonly="1"
                                invisible="document_id.invoice_type == '91'" />
                            <field name="credited_quantity" readonly="1"
                                invisible="document_id.invoice_type != '91'" />
                            <field name="quantity_unit_code" readonly="1" />
                            <field name="line_extension_amount" readonly="1" />
                            <field name="price_amount" readonly="1" />
                            <field name="base_quantity" readonly="1" />
                            <field name="base_quantity_unit_code" readonly="1" />
                        </group>
                    </group>
                    <group string="Item identification">
                        <field name="sellers_item_identification" readonly="1"
                            invisible="document_id.invoice_type == '91'" />
                        <field name="manufacturers_item_identification" readonly="1"
                            invisible="document_id.invoice_type != '91'" />
                        <field name="standard_item_identification" readonly="1" />
                    </group>
                    <group string="Notes" invisible="not note">
                        <field name="note" readonly="1" nolabel="1" />
                    </group>
                    <notebook>
                        <page string="Tax Totals" name="tax_totals">
                            <field name="tax_total_ids" readonly="1" nolabel="1">
                                <list create="0" delete="0">
                                    <field name="tax_scheme_name" />
                                    <field name="tax_scheme_id" />
                                    <field name="taxable_amount" />
                                    <field name="percent" />
                                    <field name="tax_amount" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dian_document_no_invoice" model="ir.actions.act_window">
        <field name="name">Without Invoice</field>
        <field name="res_model">dian.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_dian_document_no_invoice_list')})]"/>
        <field name="search_view_id" ref="view_dian_document_search" />
        <field name="domain">[('move_id', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents without an invoice.</p>
            <p>These documents have not yet been linked to an invoice in Odoo.</p>
        </field>
    </record>

    <record id="action_dian_document_no_purchase" model="ir.actions.act_window">
        <field name="name">Without Purchase Order</field>
        <field name="res_model">dian.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_dian_document_no_purchase_list')})]"/>
        <field name="search_view_id" ref="view_dian_document_search" />
        <field name="domain">[('purchase_id', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents without a purchase order.</p>
            <p>These documents have not yet been linked to a purchase order in Odoo.</p>
        </field>
    </record>

    <record id="action_dian_document_all" model="ir.actions.act_window">
        <field name="name">All Documents</field>
        <field name="res_model">dian.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_dian_document_all_list')})]"/>
        <field name="search_view_id" ref="view_dian_document_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents yet.</p>
            <p>Shows all DIAN documents synchronized so far, regardless of their invoice or purchase order link status.</p>
        </field>
    </record>

    <record id="action_match_dian_documents" model="ir.actions.server">
        <field name="name">Link to Invoices</field>
        <field name="model_id" ref="model_dian_document" />
        <field name="binding_model_id" ref="model_dian_document" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_match_account_moves()</field>
    </record>

    <record id="action_find_purchase_order_dian_documents" model="ir.actions.server">
        <field name="name">Find Purchase Order</field>
        <field name="model_id" ref="model_dian_document" />
        <field name="binding_model_id" ref="model_dian_document" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_find_purchase_order()</field>
    </record>

    <menuitem
        id="menu_dian_document"
        name="Documents"
        parent="dian_invoices_menu_categ"
        sequence="15" />

    <menuitem
        id="menu_dian_document_no_invoice"
        name="Without Invoice"
        parent="menu_dian_document"
        action="action_dian_document_no_invoice"
        sequence="10" />

    <menuitem
        id="menu_dian_document_no_purchase"
        name="Without Purchase Order"
        parent="menu_dian_document"
        action="action_dian_document_no_purchase"
        sequence="20" />

    <menuitem
        id="menu_dian_document_all"
        name="All Documents"
        parent="menu_dian_document"
        action="action_dian_document_all"
        sequence="30" />

</odoo>
