<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dian_document_no_invoice_list" model="ir.ui.view">
        <field name="name">dian.document.no.invoice.list</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <list string="Documents without Invoice" create="0" delete="0">
                <field name="name" />
                <field name="emission_date" optional="show" />
                <field name="reception" />
                <field name="cufe" />
                <field name="sender" />
                <field name="sender_vat" />
                <field name="result" />
                <field name="total_amount" />
            </list>
        </field>
    </record>

    <record id="view_dian_document_no_purchase_list" model="ir.ui.view">
        <field name="name">dian.document.no.purchase.list</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <list string="Documents without Purchase Order" create="0" delete="0">
                <field name="name" />
                <field name="emission_date" optional="show" />
                <field name="reception" />
                <field name="cufe" />
                <field name="sender" />
                <field name="sender_vat" />
                <field name="order_reference" />
                <field name="result" />
                <field name="total_amount" />
                <field name="move_id" />
            </list>
        </field>
    </record>

    <record id="view_dian_document_all_list" model="ir.ui.view">
        <field name="name">dian.document.all.list</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <list string="All Documents" create="0" delete="0">
                <field name="name" />
                <field name="emission_date" optional="show" />
                <field name="reception" />
                <field name="cufe" />
                <field name="sender" />
                <field name="sender_vat" />
                <field name="order_reference" />
                <field name="result" />
                <field name="total_amount" />
                <field name="move_id" />
                <field name="purchase_id" />
            </list>
        </field>
    </record>

    <record id="view_dian_document_search" model="ir.ui.view">
        <field name="name">dian.document.search</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <search string="DIAN Documents">
                <field name="name" />
                <field name="cufe" />
                <field name="sender" />
                <field name="sender_vat" />
                <field name="purchase_id" />
                <field name="order_reference" />
                <field name="reception" />
                <filter name="reception_date" string="Reception Date" date="reception" />
                <filter name="emission_date" string="Emission Date" date="emission_date" />
                <separator />
                <filter string="Without Purchase Order" name="filter_no_po"
                    domain="[('purchase_id', '=', False), ('order_reference', '!=', False)]" />
                <separator />
                <filter string="Result" name="group_result" context="{'group_by': 'result'}" />
                <filter string="Sender" name="group_sender" context="{'group_by': 'sender'}" />
            </search>
        </field>
    </record>

    <record id="view_dian_document_form" model="ir.ui.view">
        <field name="name">dian.document.form</field>
        <field name="model">dian.document</field>
        <field name="arch" type="xml">
            <form string="DIAN Document" create="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <group>
                        <group string="Identification">
                            <field name="name" readonly="1" />
                            <field name="cufe" readonly="1" options="{'no_create': True}" />
                            <field name="emission_date" readonly="1" />
                            <field name="reception" readonly="1" />
                            <field name="type" readonly="1" />
                            <field name="type_code" readonly="1" />
                            <field name="order_reference" readonly="1" />
                            <field name="sync_id" readonly="1" options="{'no_create': True}" />
                            <field name="document_type" invisible="1" />
                        </group>
                        <group string="Status" name="status">
                            <field name="result" readonly="1" />
                            <field name="status_code" readonly="1" />
                            <field name="radina_result" readonly="1" />
                            <field name="move_id" options="{'no_create': True}" />
                            <field name="purchase_id" options="{'no_create': True}" />
                        </group>
                    </group>
                    <group>
                        <group string="Sender" name="sender">
                            <field name="sender" readonly="1" placeholder="Sender name" />
                            <field name="sender_vat" readonly="1" placeholder="NIT / VAT" />
                        </group>
                        <group string="Receiver">
                            <field name="receiver" readonly="1" placeholder="Receiver name" />
                            <field name="receiver_vat" readonly="1" placeholder="NIT / VAT" />
                        </group>
                    </group>
                    <group>
                        <group string="Amounts (from API)" name="amounts_api">
                            <field name="total_amount" readonly="1" />
                            <field name="tax_amount_5_percent" readonly="1" />
                            <field name="tax_amount_19_percent" readonly="1" />
                            <field name="tax_amount_iva" readonly="1" />
                            <field name="tax_amount_ica" readonly="1" />
                            <field name="tax_amount_ipc" readonly="1" />
                        </group>
                    </group>
                    <notebook />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dian_document_no_invoice" model="ir.actions.act_window">
        <field name="name">Without Invoice</field>
        <field name="res_model">dian.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_dian_document_no_invoice_list')})]"/>
        <field name="search_view_id" ref="view_dian_document_search" />
        <field name="domain">[('move_id', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents without an invoice.</p>
            <p>These documents have not yet been linked to an invoice in Odoo.</p>
        </field>
    </record>

    <record id="action_dian_document_no_purchase" model="ir.actions.act_window">
        <field name="name">Without Purchase Order</field>
        <field name="res_model">dian.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_dian_document_no_purchase_list')})]"/>
        <field name="search_view_id" ref="view_dian_document_search" />
        <field name="domain">[('purchase_id', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents without a purchase order.</p>
            <p>These documents have not yet been linked to a purchase order in Odoo.</p>
        </field>
    </record>

    <record id="action_dian_document_all" model="ir.actions.act_window">
        <field name="name">All Documents</field>
        <field name="res_model">dian.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_dian_document_all_list')})]"/>
        <field name="search_view_id" ref="view_dian_document_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No documents yet.</p>
            <p>Shows all DIAN documents synchronized so far, regardless of their invoice or purchase order link status.</p>
        </field>
    </record>

    <record id="action_find_purchase_order_dian_documents" model="ir.actions.server">
        <field name="name">Find Purchase Order</field>
        <field name="model_id" ref="model_dian_document" />
        <field name="binding_model_id" ref="model_dian_document" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_find_purchase_order()</field>
    </record>

    <menuitem
        id="menu_dian_document"
        name="Documents"
        parent="dian_invoices_menu_categ"
        sequence="15" />

    <menuitem
        id="menu_dian_document_no_invoice"
        name="Without Invoice"
        parent="menu_dian_document"
        action="action_dian_document_no_invoice"
        sequence="10" />

    <menuitem
        id="menu_dian_document_no_purchase"
        name="Without Purchase Order"
        parent="menu_dian_document"
        action="action_dian_document_no_purchase"
        sequence="20" />

    <menuitem
        id="menu_dian_document_all"
        name="All Documents"
        parent="menu_dian_document"
        action="action_dian_document_all"
        sequence="30" />

</odoo>
