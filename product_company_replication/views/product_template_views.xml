<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_replication" model="ir.ui.view">
        <field name="name">product.template.form.replication</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- El formulario de producto no trae <header>; se crea aquí. -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_open_replicate_wizard" type="object"
                            string="Replicar producto" class="btn-primary"
                            invisible="not id"
                            groups="base.group_multi_company"/>
                    <button name="action_open_sync_wizard" type="object"
                            string="Sincronizar a compañías"
                            invisible="not id or replica_count == 0"
                            groups="base.group_multi_company"/>
                </header>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_replicas" type="object"
                        class="oe_stat_button" icon="fa-building-o"
                        invisible="replica_count == 0"
                        groups="base.group_multi_company">
                    <field name="replica_count" widget="statinfo" string="Compañías"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='general_information']//group[@name='group_general']" position="inside">
                <field name="replica_origin_id" readonly="1"
                       invisible="not replica_origin_id"
                       groups="base.group_multi_company"
                       options="{'no_open': False}"/>
            </xpath>
        </field>
    </record>
</odoo>
