<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form" model="ir.ui.view">
        <field name="name">view.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]/group[1]/field[@name='partner_id']" position="after">
                <field name="city_id" options="{'no_create': True}" groups="account.group_account_user" readonly="state in ('done','cancel')" />
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <label for="base_calculate" groups="account.group_account_user" />
                <div class="o_row" groups="account.group_account_user">
                    <field name="base_calculate" readonly="state in ('done','cancel')" />
                    <button string="Calculate" name="calculate_base" type="object" class="btn-outline-warning mb-2 px-2" icon="fa-refresh" invisible="not base_calculate or state in ('posted', 'cancel')" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>