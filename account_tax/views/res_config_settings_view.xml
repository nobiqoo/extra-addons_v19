<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.ica</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Insertar en el bloque de facturación (Customer Invoices) -->
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="calculate_ica_by_line_setting" string="Calcular ICA por líneas" company_dependent="1" help="Permite calcular ICA por líneas en facturas de venta.">
                    <div class="content-group">
                        <field name="calculate_ica_by_line"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
