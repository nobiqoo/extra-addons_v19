<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_res_city_list">
        <field name="name">view.res.city.list</field>
        <field name="model">res.city</field>
        <field name="arch" type="xml">
            <list string="Cities">
                <field name="name" />
                <field name="zipcode" />
                <field name="state_id" />
                <field name="country_id" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_res_city_form">
        <field name="name">view.res.city.form</field>
        <field name="model">res.city</field>
        <field name="arch" type="xml">
            <form string="City">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="zipcode" />
                        </group>
                        <group>
                            <field name="country_id" />
                            <field name="state_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Taxes">
                            <group>
                                <group>
                                    <field name="base_value_service" />
                                </group>
                                <group>
                                    <field name="base_value_consu" />
                                </group>
                            </group>
                            <label for="classification_ids" />
                            <field name="classification_ids" nolabel="True">
                                <list string="Rates" editable="top">
                                    <field name="city_id" invisible="True" />
                                    <field name="classification_id" />
                                    <field name="tax_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_res_city">
        <field name="name">Cities</field>
        <field name="res_model">res.city</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_res_city_list" model="ir.actions.act_window.view">
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_res_city_list" />
        <field name="act_window_id" ref="action_res_city" />
    </record>

    <record id="action_res_city_form" model="ir.actions.act_window.view">
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_res_city_form" />
        <field name="act_window_id" ref="action_res_city" />
    </record>

    <record id="menu_res_city" model="ir.ui.menu">
        <field name="name">Cities</field>
        <field name="action" ref="action_res_city" />
        <field name="parent_id" ref="menu_account_configuration_isic" />
        <field name="sequence" eval="10" />
        <field name="active" eval="True" />
    </record>
</odoo>