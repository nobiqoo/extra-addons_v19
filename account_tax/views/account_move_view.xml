<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']/field[@name='partner_shipping_id']" position="before">
                <field name="city_id" options="{'no_create': True}" groups="account.group_account_user,account_tax.group_account_taxes_in_invoice" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')" readonly="state in ('posted','cancel')"/>
            </xpath>
            <xpath expr="//field[@name='tax_totals']" position="before">
                <label for="base_calculate" groups="account.group_account_user,account_tax.group_account_taxes_in_invoice" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
                <div class="o_row" groups="account.group_account_user,account_tax.group_account_taxes_in_invoice" invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')">
                    <field name="base_calculate" readonly="state in ('posted','cancel')" />
                    <button string="Calculate" name="calculate_base" type="object" class="btn-outline-warning mb-2 px-2" icon="fa-refresh" invisible="not base_calculate or state in ('posted', 'cancel')" />
                </div>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']//field[@name='product_id']" position="after">
                <field name="city_id" options="{'no_create': True}"  optional="show"/>
            </xpath>
            <xpath expr="//page[@id='aml_tab']//field[@name='debit']" position="before">
                <field name="city_id" optional='hide'/>
            </xpath>
        </field>
    </record>
</odoo>