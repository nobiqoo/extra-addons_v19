<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_tax_form" model="ir.ui.view">
        <field name="name">view.account.tax.form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_options']/group[1]" position="inside">
                <group string="Retention">
                    <field name="base_minimum" />
                    <field name="base_city" invisible="not base_minimum" />
                    <field name="base_value" invisible="not base_minimum or base_city == True" />
                    <field name="base_type" invisible="not base_minimum or not base_city" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>