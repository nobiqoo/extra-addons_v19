<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- PDF REPORTS : paperformat -->
    <record id="report_qweb_paperformat" model="report.paperformat">
        <field name="name">Colombian Report qweb paperformat</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">10</field>
        <field name="dpi">110</field>
    </record>

    <record id="tax_certificate_management_tmpl_action" model="ir.actions.report">
      <field name="name">Withholding certificate report</field>
      <field name="model">withholding.certificate.report</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_file">tax_certificate_management.withholding_certificate_report_template</field>
      <field name="report_name">tax_certificate_management.withholding_certificate_report_template</field>
      <field name="binding_model_id" eval="False"/>
      <field name="binding_type">report</field>
      <field name="paperformat_id" ref="report_qweb_paperformat" />
    </record>

</odoo>