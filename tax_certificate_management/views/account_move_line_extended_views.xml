<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_line_extended_view_form" model="ir.ui.view">
        <field name="name">account.move.line.extended.view.form</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_currency']" position="after">
                <field name="tax_base_amount"/>
            </xpath>
        </field>
    </record>

    <record id="account_move_extended_view_tree" model="ir.ui.view">
        <field name="name">account.move.extended.view.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='currency_id']" position="after">
                <field name="tax_base_amount" optional="show" readonly="0"/>
            </xpath>
        </field>
    </record>

</odoo>