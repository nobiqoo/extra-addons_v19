<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="tax_certificate_management_group" model="res.groups">
            <field name="name">Tax certificate management</field>
            <!-- <field name="category_id" ref="base.module_category_accounting"/> -->
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">All access to tax certificate management.</field>
        </record>

        <record id="tax_certificate_management_report_secuence" model="ir.sequence">
            <field name="name">Tax certificate management report sequence</field>
            <field name="code">withholding.certificate.report</field>
            <field name="prefix">TAXR/</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="True" name="company_id"/>
            <field name="padding">6</field>
        </record>

    </data>
</odoo>