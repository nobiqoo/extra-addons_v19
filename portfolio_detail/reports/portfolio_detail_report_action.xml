<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- PDF REPORTS : paperformat -->
    <record id="report_qweb_paperformat" model="report.paperformat">
        <field name="name">Portfolio detail paperformat</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">50</field>
        <field name="dpi">110</field>
    </record>

    <record id="portfolio_detail_template_action" model="ir.actions.report">
      <field name="name">Portfolio detail</field>
      <field name="model">portfolio.detail.wizard</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_file">portfolio_detail.portfolio_detail_template</field>
      <field name="report_name">portfolio_detail.portfolio_detail_template</field>
      <field name="binding_model_id" eval="False"/>
      <field name="binding_type">report</field>
      <field name="paperformat_id" ref="report_qweb_paperformat" />
    </record>

    <record id="portfolio_detail_xlsx_template_action" model="ir.actions.report">
        <field name="name">Portfolio detail</field>
        <field name="model">portfolio.detail.wizard</field>
        <field name="report_type">xlsx</field>
      <field name="report_name">portfolio_detail.account_balance_xlsx_template</field>
      <field name="report_file">portfolio_detail.account_balance_xlsx_template</field>
    </record>

</odoo>