<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="income_and_withholding_certificate_paperformat" model="report.paperformat">
            <field name="name">Formato Papel para cetificados de ingresos y retenciones</field>
            <field name="default" eval="True" />
            <field name="format">Letter</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>

        <record id="income_and_withholding_certificate_action_report" model="ir.actions.report">
            <field name="name">Cetificado de ingresos y retenciones</field>
            <field name="model">income.and.withholding.certificate</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hr_payroll_co.income_and_withholding_certificate_template_report</field>
            <field name="report_file">hr_payroll_co.income_and_withholding_certificate_template_report</field>
            <field name="paperformat_id" ref="income_and_withholding_certificate_paperformat" />
            <field name="binding_type">report</field>
            <field name="binding_model_id"
                ref="hr_payroll_co.model_income_and_withholding_certificate" />
        </record>
    </data>
</odoo>
