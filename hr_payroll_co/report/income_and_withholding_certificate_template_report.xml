<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="income_and_withholding_certificate_template_report">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <style>
                        .image-background {
                        position:absolute;
                        top:0px;
                        left:0px;
                        width:99%;
                        height:auto;
                        z-index:-1;
                        }
                        .basic-field{
                        position:absolute;
                        height:8px;
                        }
                        .social-reason-field{
                        position:absolute;
                        height:8px;
                        width:800px;
                        }
                        .retainer-field{
                        position:absolute;
                        height:8px;
                        width:490px;
                        }
                        .payment-field{
                        position:absolute;
                        height:8px;
                        width:150px;
                        text-align: right;
                        }
                    </style>
                    <div class="container-fluid">
                        <t t-set="decimal_precision" t-value="doc.company_id.decimal_in_income_cert_pdf or 0"/>
                        <span
                            class="basic-field"
                            t-field="doc.year"
                            t-attf-style="top: {{ doc.template_id.year_top }}px; left: {{ doc.template_id.year_left }}px;" />
                        <span
                            class="basic-field"
                            t-field="doc.form_number"
                            t-attf-style="top: {{ doc.template_id.form_number_top }}px; left: {{ doc.template_id.form_number_left }}px;" />
                        <span
                            class="basic-field"
                            t-field="doc.nit"
