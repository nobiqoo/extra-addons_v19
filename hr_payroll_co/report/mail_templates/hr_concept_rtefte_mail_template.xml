<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_concept_rtefte_mail_template" model="mail.template">
            <field name="name">Certificado de Retención en la Fuente</field>
            <field name="model_id" ref="hr_payroll_co.model_hr_concept_rtefte" />
            <field name="subject">Certificado de Retención en la Fuente {{object.period_id.name}}</field>
            <field name="partner_to"></field>
            <field name="email_to">{{object.employee_id.payroll_mail_notifier or object.employee_id.partner_id.email}}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 15px;"> Estimado/a <strong
                            t-out="object.employee_id.partner_id.name" />.<br /><br /> Adjunto se
                        envía su certificado de retención en la fuente del periodo <strong
                            t-out="object.period_id.name" />.<br /><br /> Atentamente <strong
                            t-out="object.company_id.name" />. </p>
                </div>
            </field>
            <field name="report_template_ids"
                eval="[(4, ref('hr_payroll_co.hr_concept_rtefte_action_report'))]" />
            <field name="auto_delete" eval="True" />
        </record>
    </data>
</odoo> 
