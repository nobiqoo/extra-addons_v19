<odoo>
    <data noupdate="1">
        <record id="cron_update_holiday_lines" model="ir.cron">
            <field name="name">Nómina: Actualizar líneas de vacaciones</field>
            <field name="model_id" ref="hr_payroll_co.model_hr_contract"/>
            <field name="state">code</field>
            <field name="code">model.recreate_book_lines()</field>
            <field eval="True" name="active" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <record id="cron_update_days_left" model="ir.cron">
            <field name="name">Nómina: Actualizar días restantes vacaciones</field>
            <field name="model_id" ref="hr_payroll_co.model_hr_contract"/>
            <field name="state">code</field>
            <field name="code">model.update_massive_days_contract()</field>
            <field eval="True" name="active" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
