<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="hr_contract_type_view_tree" model="ir.ui.view">
            <field name="name">hr.contract.type.view.tree</field>
            <field name="model">hr.contract.type</field>
            <field name="inherit_id" ref="hr.hr_contract_type_view_tree" />
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="editable"></attribute>
                </xpath>
                <field name="sequence" position="replace" />
                <field name="name" position="after">
                    <field name="term" />
                    <field name="type_class" />
                    <field name="section" />
                </field>
            </field>
        </record>

        <record id="hr_contract_type_view_form" model="ir.ui.view">
            <field name="name">hr.contract.type.view.form</field>
            <field name="model">hr.contract.type</field>
            <field name="inherit_id" ref="hr.hr_contract_type_view_form" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="term" />
                    <field name="type_class" />
                    <field name="section" />
                </field>
            </field>
        </record>

        <record id="hr.hr_contract_type_action" model="ir.actions.act_window">
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="hr_contract_type_menu_act"
            name="Tipos de Contrato"
            parent="hr_payroll_co.hr_contract_menu_categ"
            action="hr.hr_contract_type_action"
            sequence="1" />
    </data>
</odoo>