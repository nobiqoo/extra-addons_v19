<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="view_disciplinary_type_tree" model="ir.ui.view">
            <field name="name">disciplinary.type.list</field>
            <field name="model">disciplinary.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_disciplinary_type_form" model="ir.ui.view">
            <field name="name">disciplinary.type.form</field>
            <field name="model">disciplinary.type</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name" required="1"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="hr_disciplinary_type_action" model="ir.actions.act_window">
            <field name="name">Tipos de Procesos Disciplinarios</field>
            <field name="res_model">disciplinary.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="hr_disciplinary_type_menu_act"
            name="Tipos de Procesos Disciplinarios"
            parent="hr_payroll_co.hr_contract_menu_categ"
            action="hr_disciplinary_type_action"
            sequence="10" />
    </data>
</odoo>
