<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="resource_calendar_co_form" model="ir.ui.view">
            <field name="name">resource.calendar.co.form</field>
            <field name="model">resource.calendar</field>
            <field name="inherit_id" ref="resource.resource_calendar_form" />
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[@name='button_box']" position="replace" />
                <xpath expr="/form/sheet/group[@name='resource_details']/group[2]/group[@name='flex_details']/div/field[@name='hours_per_day']"
                    position="attributes">
                    <attribute name="string">Promedio de horas</attribute>
                    <attribute name="help">Promedio semanal de horas trabajadas</attribute>
                </xpath>
            </field>
        </record>

        <record id="resource_calendar_action" model="ir.actions.act_window">
            <field name="name">Horario laboral</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">resource.calendar</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Crear horario laboral
                </p>
            </field>
        </record>

        <menuitem
            id="resource_calendar_menu_act"
            name="Horario laboral"
            parent="hr_payroll_co.hr_contract_menu_categ"
            action="hr_payroll_co.resource_calendar_action" sequence="4" />

    </data>
</odoo>