<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="hr_contribution_form_form" model="ir.ui.view">
            <field name="name">hr.contribution.form.form</field>
            <field name="model">hr.contribution.form</field>
            <field name="arch" type="xml">
                <form string="Planilla de aportes">
                    <header>
                        <button name="load_contracts_ids" string="Cargar contratos" type="object"
                            invisible="state != 'draft'" />
                        <button name="compute_pila" string="Calcular" type="object"
                            invisible="state != 'draft'" />
                        <button name="set_file_pila" string="Generar archivo" type="object" />
                        <button name="to_paid" string="Causar" type="object"
                            invisible="state != 'draft'" />
                        <button name="to_draft" string="Pasar a borrador" type="object"
                            invisible="state != 'paid'" />
                        <field name="state" widget="statusbar" statusbar_visible="draft,paid" />
                    </header>
                    <sheet>
                        <div name="title">
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="period_id"
                                    readonly="state != 'draft'" />
                                <field name="contract_group_id"
                                    readonly="state != 'draft'" />
                                <field name="branch_code"
                                    readonly="state != 'draft'" />
                                <field name="journal_id"
                                    readonly="state != 'draft'" />
                            </group>
                            <group>
                                <field name="company_id"
                                    readonly="state != 'draft'" />
                                <field name="file_name" invisible="1" />
                                <field name="file_pila" filename="file_name" />
                                <field name="move_id" />
                            </group>
                        </group>
                        <notebook>
                            <page name="page_contracts" string="Contratos">
                                <field name="contracts_ids" domain="[('state', '=', 'open')]"
                                    readonly="state != 'draft'">
                                    <list>
                                        <field name="name" />
                                        <field name="employee_id" />
                                        <field name="wage" />
                                    </list>
                                </field>
                            </page>
                            <page name="page_contribution_line_ids" string="Detalle de planilla">
                                <field name="contribution_line_ids">
                                    <list>
                                        <field name="contract_id" />
                                        <field name="employee_id" />
                                        <field name="main" />
                                        <field name="pens_cot" />
                                        <field name="eps_cot" />
                                        <field name="arl_cot" />
                                        <field name="ccf_cot" />
                                        <field name="sena_cot" />
                                        <field name="icbf_cot" />
                                        <field name="esap_cot" />
                                        <field name="men_cot" />
                                    </list>
                                </field>
                            </page>
                            <page name="page_error_log" string="Detalle error">
                                <field name="error_log" />
                            </page>
                            <page name="page_totals" string="Totales">
                                <group>
                                    <field name="pens_cot_total" />
                                    <field name="ap_vol_contributor_total" />
                                    <field name="ap_vol_company_total" />
                                    <field name="fsol_total" />
                                    <field name="fsub_total" />
                                    <field name="eps_cot_total" />
                                    <field name="arl_cot_total" />
                                    <field name="ccf_cot_total" />
                                    <field name="sena_cot_total" />
                                    <field name="icbf_cot_total" />
                                    <field name="contribution_total" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_contribution_form_tree" model="ir.ui.view">
            <field name="name">hr.contribution.form.tree</field>
            <field name="model">hr.contribution.form</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="period_id" />
                    <field name="contract_group_id" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="hr_contribution_form_search" model="ir.ui.view">
            <field name="name">hr.contribution.form.search</field>
            <field name="model">hr.contribution.form</field>
            <field name="arch" type="xml">
                <search string="Search contribution form">
                    <field name="name" />
                    <field name="period_id" />
                    <field name="contract_group_id" />
                    <field name="state" />

                    <separator />
                    <filter name="paid_filter" string="Pagada" domain="[('state', '=', 'paid')]" />
                    <filter name="draft_filter" string="Borrador" domain="[('state', '=', 'draft')]" />

                    <separator />
                    <filter name="state_group" string="Estado" context="{'group_by': 'state'}" />
                    <filter name="contract_group_group" string="Grupo de contrato"
                        context="{'group_by': 'contract_group_id'}" />
                </search>
            </field>
        </record>

        <record id="hr_contribution_form_action" model="ir.actions.act_window">
            <field name="name">Planillas de aportes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.contribution.form</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="hr_contribution_form_menu_act" name="Planillas de aportes"
            parent="contribution_menu_categ" action="hr_contribution_form_action" sequence="1" />
    </data>

    <data noupdate="1">
        <record id="seq_hr_contribution_form" model="ir.sequence">
            <field name="name">Número planillas de aportes</field>
            <field name="code">seq.hr.contribution.form</field>
            <field name="prefix">PILA-</field>
            <field name="padding">10</field>
        </record>
    </data>
</odoo>