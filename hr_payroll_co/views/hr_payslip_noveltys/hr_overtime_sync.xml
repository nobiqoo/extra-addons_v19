<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="hr_overtime_sync_tree" model="ir.ui.view">
            <field name="name">hr.overtime.sync.tree</field>
            <field name="model">hr.overtime.sync</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="send_date" />
                    <field name="line_count" />
                </list>
            </field>
        </record>

        <record id="hr_overtime_sync_form" model="ir.ui.view">
            <field name="name">hr.overtime.sync.form</field>
            <field name="model">hr.overtime.sync</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="send_date" />
                                <field name="line_count" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Horas extras">
                                <field name="line_ids" readonly="1">
                                    <list>
                                        <field name="name" />
                                        <field name="employee_id" />
                                        <field name="contract_id" />
                                        <field name="overtime_type_id" />
                                        <field name="qty" />
                                        <field name="state" />
                                    </list>
                                </field>
                            </page>
                            <page string="Auditoría JSON">
                                <field name="payload_json" widget="text" readonly="1" />
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_overtime_sync_action" model="ir.actions.act_window">
            <field name="name">Horas Extras Sincronización</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.overtime.sync</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="hr_overtime_sync_menu_act"
            name="Horas Extras Sincronización"
            parent="novelty_menu_categ"
            action="hr_overtime_sync_action"
            groups="hr_payroll_co.payroll_service_admin_group"
            sequence="2" />

    </data>

    <data noupdate="1">
        <record id="seq_hr_overtime_sync" model="ir.sequence">
            <field name="name">Número sincronización hora extra</field>
            <field name="code">seq.hr.overtime.sync</field>
            <field name="prefix">SHE-</field>
            <field name="padding">10</field>
        </record>
    </data>
</odoo>
