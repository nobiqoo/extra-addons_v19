
<odoo>
    <record id="action_medical_exam_report" model="ir.actions.act_window">
        <field name="name">Medical Examinations</field>
        <field name="res_model">medical.exam</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_medical_exam_tree" model="ir.ui.view">
        <field name="name">medical.exam.tree</field>
        <field name="model">medical.exam</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="expiration_days"/>
                <field name="document_url" widget="html" readonly="1"/>
                <field name="insurance_type"/>
                <field name="insurance_name"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_medical_exam_report"
            name="Exámenes Médicos"
            parent="hr.hr_menu_hr_reports" 
            action="action_medical_exam_report"
            sequence="20"/>
</odoo>