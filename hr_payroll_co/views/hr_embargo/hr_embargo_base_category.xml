<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="hr_embargo_base_category_form" model="ir.ui.view">
            <field name="name">hr.embargo.base.category.form</field>
            <field name="model">hr.embargo.base.category</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Garnishment Base Category">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="active" />
                            <field name="company_id" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_embargo_base_category_tree" model="ir.ui.view">
            <field name="name">hr.embargo.base.category.tree</field>
            <field name="model">hr.embargo.base.category</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="code" />
                    <field name="active" />
                </list>
            </field>
        </record>

        <record id="hr_embargo_base_category_action" model="ir.actions.act_window">
            <field name="name">Garnishment Base Categories</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.embargo.base.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="hr_embargo_base_category_menu_act" name="Categorías"
            parent="setup_embargo_menu_categ" action="hr_embargo_base_category_action"
            sequence="2" />

    </data>
</odoo>
