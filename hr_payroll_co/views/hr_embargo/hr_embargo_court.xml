<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="hr_embargo_court_form" model="ir.ui.view">
            <field name="name">hr.embargo.court.form</field>
            <field name="model">hr.embargo.court</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Garnishment Court">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="judicial_account" />
                            <field name="destination_code" />
                            <field name="active" />
                            <field name="company_id" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_embargo_court_tree" model="ir.ui.view">
            <field name="name">hr.embargo.court.tree</field>
            <field name="model">hr.embargo.court</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="code" />
                    <field name="judicial_account" />
                    <field name="destination_code" />
                    <field name="active" />
                </list>
            </field>
        </record>

        <record id="hr_embargo_court_action" model="ir.actions.act_window">
            <field name="name">Garnishment Courts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.embargo.court</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="hr_embargo_court_menu_act" name="Código Juzgado Embargo"
            parent="setup_embargo_menu_categ" action="hr_embargo_court_action" sequence="4" />

    </data>
</odoo>
