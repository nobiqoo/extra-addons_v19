<odoo>
    <data>

        <record id="hr_payslip_report_setting_form" model="ir.ui.view">
            <field name="name">hr.payslip.report.setting.form</field>
            <field name="model">hr.payslip.report.setting</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" class="oe_inline"/>
                            </h1>
                        </div>

                        <group>
                            <field name="company_id"/>
                        </group>
                        <notebook>
                            <page string="Devengos">
                                <field name="earning_lines_ids" context="{'default_line_type':'earning'}">
                                    <list editable="bottom">
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="name"/>
                                        <field name="is_basic"/>
                                        <field name="int" readonly="is_basic == False" />
                                        <field name="sen_ele" readonly="is_basic == False" />
                                        <field name="sen_prod" readonly="is_basic == False" />
                                        <field name="concepts_ids" widget="many2many_tags"/>
                                        <field name="line_type" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Deducciones">
                                <field name="deduction_lines_ids" context="{'default_line_type':'deduction'}">
                                    <list editable="bottom">
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="name"/>
                                        <field name="concepts_ids" widget="many2many_tags"/>
                                        <field name="line_type" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Netos">
                                <field name="net_lines_ids" context="{'default_line_type':'net'}">
                                    <list editable="bottom">
                                        <field name="company_id" column_invisible="1"/>
                                        <field name="name"/>
                                        <field name="concepts_ids" widget="many2many_tags"/>
                                        <field name="line_type" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_payslip_report_setting_tree" model="ir.ui.view">
            <field name="name">hr.payslip.report.setting.tree</field>
            <field name="model">hr.payslip.report.setting</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                </list>
            </field>
        </record>

        <record id="hr_payslip_report_setting_action" model="ir.actions.act_window">
            <field name="name">Configuración reporte de nómina</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.payslip.report.setting</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="hr_payslip_report_setting_menu_act"
            name="Configuración reporte de nómina"
            action="hr_payslip_report_setting_action"
            parent="hr.menu_human_resources_configuration"
            sequence="5" />
    </data>
</odoo>