        <record id="income_and_withholding_certificate_template_tree" model="ir.ui.view">
            <field name="name">income.and.withholding.certificate.template.tree</field>
            <field name="model">income.and.withholding.certificate.template</field>
            <field name="arch" type="xml">
                <list>
