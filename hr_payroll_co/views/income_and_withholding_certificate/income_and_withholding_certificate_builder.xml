<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="income_and_withholding_certificate_builder_form" model="ir.ui.view">
            <field name="name">income.and.withholding.certificate.builder.form</field>
            <field name="model">income.and.withholding.certificate.builder</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <h1>
                            <field name="company_id" widget="selection" />
                        </h1>
                        <group>
                            <group>
                                <field name="city_id" />
                                <field name="template_id" />
                            </group>
                            <group>
                                <field name="date" />
                                <field name="unify_by_employee"/>
                            </group>
                        </group>
                        <group>
                            <field name="contracts_ids">
                                <list>
                                    <field name="name" />
                                    <field name="state" />
                                    <field name="employee_id" />
                                </list>
                            </field>
                        </group>
                    </sheet>
                    <footer>
                        <button name="create_certificate" string="Generar"
                            class="btn btn-primary" type="object" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="income_and_withholding_certificate_builder_action" model="ir.actions.act_window">
            <field name="name">Generador de certificados</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">income.and.withholding.certificate.builder</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="income_and_withholding_certificate_builder_form" />
            <field name="target">new</field>
        </record>

        <menuitem
            id="income_and_withholding_certificate_builder_menu_act"
            name="Generador de certificados"
            parent="income_and_withholding_certificate_menu_categ"
            action="income_and_withholding_certificate_builder_action"
            sequence="2" />

    </data>
</odoo>