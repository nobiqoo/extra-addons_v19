<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_contract_work_certificate_wizard_form" model="ir.ui.view">
            <field name="name">hr.contract.work.certificate.wizard.form</field>
            <field name="model">hr.contract.work.certificate.wizard</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Certificado laboral">
                    <sheet>
                        <group>
                            <group>
                                <field name="certificate_type" required="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button 
                            name="send_certificate"
                            string="Enviar Certificado"
                            class="btn btn-primary"
                            type="object" />
                        <button 
                            name="download_certificate_pdf"
                            string="Descargar Certificado"
                            class="btn btn-primary"
                            type="object" />
                        <button 
                            string="Cancelar"
                            class="btn-secondary"
                            special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_hr_contract_work_certificate" model="ir.actions.act_window">
            <field name="name">Enviar/Descargar Certificado Laboral</field>
            <field name="res_model">hr.contract.work.certificate.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="hr_payroll_co.hr_contract_work_certificate_wizard_form"/>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_hr_contract"/>
            <field name="binding_view_types">form</field>
        </record>
    </data>
</odoo>