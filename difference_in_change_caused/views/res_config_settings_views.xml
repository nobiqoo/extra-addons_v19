<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.difference.in.change.caused</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']/setting[@invisible='not group_multi_currency']" position="attributes">
                <attribute name="string">Asientos de diferencia en cambio causada:</attribute>
            </xpath>
            <xpath expr="//block[@id='default_accounts']/setting[@invisible='not group_multi_currency']" position="after">
                <setting invisible="not group_multi_currency" string="Asientos de diferencia en cambio realizada:">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="income_currency_exchange_account_made_id" string="Ganancia" class="col-lg-4 o_light_label" />
                            <field name="income_currency_exchange_account_made_id" />
                        </div>
                        <div class="row mt8">
                            <label for="expense_currency_exchange_account_made_id" string="Pérdida" class="col-lg-4 o_light_label" />
                            <field name="expense_currency_exchange_account_made_id" />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
