<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mrp_bom_form_view_copy_components" model="ir.ui.view">
        <field name="name">mrp.bom.form.copy.components</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']/list/control" position="inside">
                <button name="copy_existing_components" string="Copiar componentes existentes" type="object" class="px-4 btn-link" context="{'bom_id': parent.id}"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_bom_line_copy_to_bom_list_view" model="ir.ui.view">
        <field name="name">mrp.bom.line.copy_to_bom.list</field>
        <field name="model">mrp.bom.line</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <list string="Componentes de listas de materiales" create="0" edit="0" delete="0" multi_edit="0" export_xlsx="0">
                <header>
                    <button name="copy_to_bom" type="object" string="Copiar componentes seleccionados"/>
                </header>
                <field name="product_id"/>
                <field name="bom_id" string="Lista de materiales principal"/>
                <field name="bom_product_tmpl_id" optional="hide"/>
                <field name="bom_type" optional="hide"/>
                <field name="product_qty"/>
                <field name="product_uom_id" groups="uom.group_uom"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="mrp_bom_line_copy_to_bom_search_view" model="ir.ui.view">
        <field name="name">mrp.bom.line.copy_to_bom.search</field>
        <field name="model">mrp.bom.line</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <search string="Buscar componentes">
                <field name="product_id"/>
                <field name="bom_id" string="Lista de materiales principal" filter_domain="['|', ('bom_id.code', 'ilike', self), ('bom_id.product_tmpl_id', 'ilike', self)]"/>
                <filter string="Fabricación" name="normal" domain="[('bom_type', '=', 'normal')]"/>
                <filter string="Kit" name="phantom" domain="[('bom_type', '=', 'phantom')]"/>
                <group>
                    <filter string="Lista de materiales principal" name="group_by_bom" context="{'group_by': 'bom_id'}"/>
                    <filter string="Componente" name="group_by_component" context="{'group_by': 'product_id'}"/>
                    <filter string="Producto" name="product" context="{'group_by': 'bom_product_tmpl_id'}"/>
                    <filter string="Tipo de lista de materiales" name="group_by_type" context="{'group_by': 'bom_type'}"/>
                    <filter string="Unidad" name="default_unit_of_measure" context="{'group_by': 'product_uom_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
