            <record id="account_statement_report_col_move_number" model="account.report.column">
                <field name="name">Factura</field>
                <field name="expression_label">move_number</field>
                <field name="figure_type">string</field>
                <field name="sortable" eval="True"/>
            </record>
            <record id="account_statement_report_col_move_currency" model="account.report.column">
                <field name="name">Moneda</field>
                <field name="expression_label">move_currency</field>
                <field name="figure_type">string</field>
            </record>
            <record id="account_statement_report_col_analytic_account" model="account.report.column">
