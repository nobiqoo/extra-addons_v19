<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="magnetic_media_view_form_view" model="ir.ui.view">
            <field name="name">Formulario Medios Magnéticos</field>
            <field name="model">mag.media</field>
            <field name="arch" type="xml">
                <form string="Magnetic media">
                    <header>
                        <button name="confirm" type="object" string="Confirm" invisible="state != 'draft'"/>
                        <button name="cancel" type="object" string="Cancel" invisible="state != 'confirm'"/>
                        <button name="to_draft" type="object" string="To draft" invisible="state != 'cancel'"/>
                        <button name="export" type="object" string="Export" invisible="state != 'confirm'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm,cancel'"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="smaller_amount"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids">
                                    <list string="Lines">
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="concept_ids"/>
                                    </list>
                                    <form>
                                        <group>
                                            <field name="code"/>
                                            <field name="name"/>
                                        </group>
                                        <notebook>
                                            <page string="Concepts">
                                                <group>
                                                    <field name="concept_ids">
                                                        <list string="Concepts">
                                                            <field name="sequence"/>
                                                            <field name="name"/>
                                                            <field name="type"/>
                                                        </list>
                                                        <form>
                                                            <group string="Concepts">
                                                                <group>
                                                                    <field name="line_id" invisible="1"/>
                                                                    <field name="sequence"/>
                                                                    <field name="name"/>
                                                                    <field name="type"/>
                                                                    <field name="by_concept"/>
                                                                    <field name="sum_concepts" invisible="by_concept == False" />
                                                                </group>
                                                                <group>
                                                                    <field name="sum_concepts_ids" widget="many2many_tags" options="{'no_create': True}" invisible="by_concept == False or sum_concepts == False" />
                                                                    <field name="journal_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                                                </group>
                                                                <field name="account_ids" invisible="by_concept == True" />
                                                                <field name="concepts_ids" invisible="by_concept == False" />
                                                                <field name="tag_ids" widget="many2many_tags" invisible="by_concept == True" placeholder="Tags"/>
                                                            </group>
                                                        </form>
                                                    </field>
                                                </group>
                                            </page>
                                        </notebook>
                                    </form>
                                </field>
                            </page>

                        </notebook>
                    </sheet>
                    <chatter reload_on_attachment="True"/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="magnetic_media_view_tree_view">
            <field name="name">Medios Magnéticos tree</field>
            <field name="model">mag.media</field>
            <field name="arch" type="xml">
                <list string="Magnetic media">
                    <field name="name"/>
                    <field name="line_ids"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="magnetic_media_view_action">
            <field name="name">Medios Magnéticos</field>
            <field name="res_model">mag.media</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="magnetic_media_cat" sequence="20" name="Información Exógena"
                parent="account.menu_finance_reports"/>
        
        <menuitem id="magnetic_media_menu_act" sequence="10" name="Medios Magnéticos"
                parent="magnetic_media_cat"
                action="magnetic_media_view_action"/>

        <!-- WIZARD -->
        <record id="magnetic_media_wizard_view" model="ir.ui.view">
            <field name="name">Wizard Medios Magnéticos</field>
            <field name="model">mag.media.wizard</field>
            <field name="arch" type="xml">
                <form string="Magnetic media">
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="city_id"/>
                        </group>
                    </group>
                    <footer>
                        <button name="export" string="Export" type="object" class="oe_highlight"/>
                        <button string="Cancelar" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
