<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Tarea 10340: el usuario operativo solo ve la sede. La ciudad y los
         impuestos viven en el maestro y no se muestran aquí. -->
    <record id="view_move_form_operation_site" model="ir.ui.view">
        <field name="name">account.move.form.operation.site</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="operation_site_id"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"
                       readonly="state != 'draft'"
                       options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_operation_site" model="ir.ui.view">
        <field name="name">account.move.list.operation.site</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <!-- invoice_date aparece dos veces en la lista (una por tipo de
                 documento), por eso el xpath se ancla en la primera. -->
            <xpath expr="//field[@name='invoice_date'][1]" position="after">
                <field name="operation_site_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
