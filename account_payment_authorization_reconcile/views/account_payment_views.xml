<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_authorization_number" model="ir.ui.view">
        <field name="name">account.payment.form.authorization.number</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <field name="memo" position="after">
                <field name="authorization_number_required" invisible="1"/>
                <field name="authorization_number"
                       required="authorization_number_required"
                       readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

</odoo>
