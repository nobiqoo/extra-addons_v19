#. module: account_payment_authorization_reconcile
#: model:ir.model.fields,help:account_payment_authorization_reconcile.field_account_reconcile_model__match_authorization_number
msgid ""
"If enabled, the automatic bank reconciliation will match a bank statement "
"line with the customer payment or receipt voucher sharing the exact same "
"Authorization Number, and reconcile them without any user intervention."
msgstr ""
"Si se activa, la conciliación bancaria automática emparejará una partida "
"del extracto bancario con el comprobante de pago o de ingreso del cliente "
"que comparta exactamente el mismo número de autorización, y los conciliará "
"sin necesidad de intervención por parte del usuario."

#. module: account_payment_authorization_reconcile
#: model:ir.model,name:account_payment_authorization_reconcile.model_account_move
msgid "Journal Entry"
msgstr "Asiento contable"

#. module: account_payment_authorization_reconcile
#: model:ir.model.fields,field_description:account_payment_authorization_reconcile.field_account_reconcile_model__match_authorization_number
msgid "Match Authorization Number"
msgstr "Coincidir con el número de autorización"

#. module: account_payment_authorization_reconcile
#: model:ir.model,name:account_payment_authorization_reconcile.model_account_payment
msgid "Payments"
msgstr "Pagos"

#. module: account_payment_authorization_reconcile
#. odoo-python
#: code:addons/account_payment_authorization_reconcile/models/pos_payment_method.py:0
msgid ""
"Please enable \"Identify Customer\" on the payment method \"%(method)s\". "
"Non-cash payment methods must keep a separate journal entry per transaction "
"so each one can carry its own Authorization Number and be reconciled "
"individually against the bank statement."
msgstr ""
"Por favor, activa la opción «Identificar cliente» en el método de pago «%"
"(method)s». Los métodos de pago que no sean en efectivo deben llevar un "
"asiento contable independiente por cada transacción, de modo que cada una "
"de ellas pueda tener su propio número de autorización y se pueda conciliar "
"individualmente con el extracto bancario."

#. module: account_payment_authorization_reconcile
