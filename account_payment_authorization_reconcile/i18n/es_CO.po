msgstr ""
"Introduzca el número de autorización antes de validar los siguientes pagos "
"de clientes: %(payments)s"

#. module: account_payment_authorization_reconcile
#. odoo-python
#: code:addons/account_payment_authorization_reconcile/models/account_voucher.py:0
msgid ""
"Please set the Authorization Number before validating the following "
