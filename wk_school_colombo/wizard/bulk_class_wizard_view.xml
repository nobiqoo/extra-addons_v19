<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bulk_class_wizard_view_form" model="ir.ui.view">
        <field name="name">wk.school.colombo.bulk.class.wizard.form</field>
        <field name="model">wk.school.colombo.bulk.class.wizard</field>
        <field name="arch" type="xml">
            <form string="Creación masiva de clases">
                <group string="Datos generales">
                    <group>
                        <field name="academic_year_id" options="{'no_create': True}"/>
                        <field name="company_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="class_modality"/>
                        <field name="term_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" string="Clases a crear">
                        <field name="grade_id" options="{'no_create': True}"/>
                        <field name="subject_id" options="{'no_create': True}"/>
                        <field name="teacher_id" options="{'no_create': True}"/>
                        <field name="teacher_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="weekday"/>
                        <field name="timeslot_id" options="{'no_create': True}"/>
                        <field name="location_id" options="{'no_create': True}"/>
                        <field name="capacity"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="book_id" options="{'no_create': True}"/>
                        <field name="is_active_line" widget="boolean_toggle"/>
                    </list>
                </field>
                <footer>
                    <button name="action_create_classes" type="object"
                            string="Crear clases" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bulk_class_wizard_action" model="ir.actions.act_window">
        <field name="name">Programación masiva</field>
        <field name="res_model">wk.school.colombo.bulk.class.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="bulk_class_wizard_menu"
              name="Programación masiva"
              parent="wk_school_management.class_main_menu"
              groups="wk_school_management.wk_school_management_officer_group"
              sequence="11"
              action="bulk_class_wizard_action"/>

</odoo>
