<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="student_postpone_wizard_view_form" model="ir.ui.view">
        <field name="name">wk.school.colombo.student.postpone.wizard.form</field>
        <field name="model">wk.school.colombo.student.postpone.wizard</field>
        <field name="arch" type="xml">
            <form string="Aplazar estudiante">
                <p>¿Está seguro de aplazar al estudiante <strong><field name="student_id" readonly="1" nolabel="1" class="oe_inline"/></strong>?</p>
                <field name="reason" placeholder="Motivo del aplazamiento (obligatorio)"/>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirmar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="student_postpone_wizard_action" model="ir.actions.act_window">
        <field name="name">Aplazar estudiante</field>
        <field name="res_model">wk.school.colombo.student.postpone.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
