<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wk_school_colombo_certificate_wizard_form" model="ir.ui.view">
        <field name="name">wk.school.colombo.certificate.wizard.form</field>
        <field name="model">wk.school.colombo.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Certificados Académicos">
                <field name="is_advanced" invisible="1"/>
                <field name="eligible_student_ids" invisible="1"/>
                <group string="Información del certificado">
                    <group>
                        <field name="program_type_id" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"/>
                        <field name="population_type" invisible="is_advanced"
                               required="not is_advanced"/>
                        <field name="grade_id" invisible="is_advanced"
                               required="not is_advanced"/>
                        <field name="sede_id" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"/>
                        <field name="populate_class_id" invisible="not is_advanced"
                               required="is_advanced"/>
                    </group>
                    <group>
                        <field name="generation_mode" widget="radio"/>
                        <field name="intensidad_horaria"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="fecha_expedicion"/>
                        <field name="lugar_expedicion"/>
                    </group>
                </group>

                <group string="Estudiantes">
                    <field name="student_ids" nolabel="1" colspan="2"
                           widget="many2many_tags"/>
                </group>

                <group string="Datos de registro (manuales)" invisible="is_advanced">
                    <field name="libro_folio_mode" widget="radio"/>
                    <group invisible="libro_folio_mode == 'individual'">
                        <field name="libro"/>
                        <field name="folio"/>
                        <field name="consecutivo"/>
                    </group>
                    <field name="line_ids" nolabel="1" colspan="2"
                           invisible="libro_folio_mode != 'individual'">
                        <list editable="bottom">
                            <field name="student_id" readonly="1"/>
                            <field name="libro"/>
                            <field name="folio"/>
                            <field name="consecutivo"/>
                        </list>
                    </field>
                </group>

                <footer>
                    <button name="action_generate_certificate" type="object"
                            string="Generar Certificado(s)" class="btn-primary"/>
                    <button name="action_view_history" type="object"
                            string="Ver histórico generado" class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wk_school_colombo_certificate_wizard_action" model="ir.actions.act_window">
        <field name="name">Certificados</field>
        <field name="res_model">wk.school.colombo.certificate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
