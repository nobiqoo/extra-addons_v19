<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="academic_analysis_wizard_view_form" model="ir.ui.view">
        <field name="name">wk.school.colombo.academic.analysis.wizard.form</field>
        <field name="model">wk.school.colombo.academic.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Reportes de Análisis Académico">
                <group>
                    <group>
                        <field name="report_type" widget="radio"/>
                        <field name="academic_year_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="program_type_id" options="{'no_create': True}"/>
                        <field name="sede_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_excel" type="object"
                            string="Generar Excel" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="academic_analysis_wizard_action" model="ir.actions.act_window">
        <field name="name">Reportes de Análisis Académico</field>
        <field name="res_model">wk.school.colombo.academic.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
