<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Nivel: modalidades y sedes en las que se dicta (obligatorias). Con
         esto la programación masiva filtra los niveles según la modalidad y
         la sede elegidas. -->
    <record id="wk_school_grade_form_colombo" model="ir.ui.view">
        <field name="name">wk.school.grade.form.colombo</field>
        <field name="model">wk.school.grade</field>
        <field name="inherit_id" ref="wk_school_management.wk_school_grade_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='scale_id']" position="after">
                <field name="modality_ids" widget="many2many_tags" required="1"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="sede_ids" widget="many2many_tags" required="1"
                       options="{'no_create': True, 'no_edit': True}"/>
            </xpath>
            <!-- Materias creadas desde el Nivel: también exigen modalidad y
                 sede (models/grade_subject.py). -->
            <xpath expr="//field[@name='subject_ids']/list/field[@name='scale_id']" position="after">
                <field name="modality_ids" widget="many2many_tags" required="1"
                       options="{'no_create': True, 'no_edit': True}"/>
                <field name="sede_ids" widget="many2many_tags" required="1"
                       options="{'no_create': True, 'no_edit': True}"/>
            </xpath>
        </field>
    </record>

    <record id="wk_school_grade_tree_colombo" model="ir.ui.view">
        <field name="name">wk.school.grade.list.colombo</field>
        <field name="model">wk.school.grade</field>
        <field name="inherit_id" ref="wk_school_management.wk_school_grade_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='section_ids']" position="after">
                <field name="modality_ids" widget="many2many_tags" optional="show"/>
                <field name="sede_ids" widget="many2many_tags" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="wk_school_grade_search_colombo" model="ir.ui.view">
        <field name="name">wk.school.grade.search.colombo</field>
        <field name="model">wk.school.grade</field>
        <field name="inherit_id" ref="wk_school_management.wk_school_grade_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="modality_ids"/>
                <field name="sede_ids"/>
            </xpath>
        </field>
    </record>

</odoo>
