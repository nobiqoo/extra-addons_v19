<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wk_school_colombo_health_regime_form" model="ir.ui.view">
        <field name="name">wk.school.colombo.health.regime.form</field>
        <field name="model">wk.school.colombo.health.regime</field>
        <field name="arch" type="xml">
            <form string="Régimen de salud">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="code"/>
                        <h1>
                            <field name="code" placeholder="Ej. 21"/>
                        </h1>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="name" placeholder="Ej. EPS Sura"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wk_school_colombo_health_regime_tree" model="ir.ui.view">
        <field name="name">wk.school.colombo.health.regime.list</field>
        <field name="model">wk.school.colombo.health.regime</field>
        <field name="arch" type="xml">
            <list string="Regímenes de salud">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="wk_school_colombo_health_regime_search" model="ir.ui.view">
        <field name="name">wk.school.colombo.health.regime.search</field>
        <field name="model">wk.school.colombo.health.regime</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="active" string="Activo" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archivado" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="wk_school_colombo_health_regime_action" model="ir.actions.act_window">
        <field name="name">Regímenes de salud</field>
        <field name="res_model">wk.school.colombo.health.regime</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="wk_school_colombo_health_regime_tree"/>
        <field name="search_view_id" ref="wk_school_colombo_health_regime_search"/>
    </record>

</odoo>
