<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="class_timeslot_form_colombo" model="ir.ui.view">
        <field name="name">wk.class.timeslot.form.colombo</field>
        <field name="model">wk.class.timeslot</field>
        <field name="inherit_id" ref="wk_school_management.class_timeslot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='end_time']/.." position="after">
                <group>
                    <field name="sede_id" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="class_timeslot_tree_colombo" model="ir.ui.view">
        <field name="name">wk.class.timeslot.list.colombo</field>
        <field name="model">wk.class.timeslot</field>
        <field name="inherit_id" ref="wk_school_management.class_timeslot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="sede_id" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
