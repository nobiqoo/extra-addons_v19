<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wk_school_colombo_program_type_form" model="ir.ui.view">
        <field name="name">wk.school.colombo.program.type.form</field>
        <field name="model">wk.school.colombo.program.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de programa">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ej. Inglés, Técnico, Diplomado..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="company_id" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}" groups="base.group_multi_company"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wk_school_colombo_program_type_tree" model="ir.ui.view">
        <field name="name">wk.school.colombo.program.type.list</field>
        <field name="model">wk.school.colombo.program.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de programa">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="wk_school_colombo_program_type_search" model="ir.ui.view">
        <field name="name">wk.school.colombo.program.type.search</field>
        <field name="model">wk.school.colombo.program.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Activo" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archivado" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="wk_school_colombo_program_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de programa</field>
        <field name="res_model">wk.school.colombo.program.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="wk_school_colombo_program_type_tree"/>
        <field name="search_view_id" ref="wk_school_colombo_program_type_search"/>
    </record>

</odoo>
