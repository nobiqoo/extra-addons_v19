<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wk_school_colombo_sede_form" model="ir.ui.view">
        <field name="name">wk.school.colombo.sede.form</field>
        <field name="model">wk.school.colombo.sede</field>
        <field name="arch" type="xml">
            <form string="Sede">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ej. Norte, Centro, Sur..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wk_school_colombo_sede_tree" model="ir.ui.view">
        <field name="name">wk.school.colombo.sede.list</field>
        <field name="model">wk.school.colombo.sede</field>
        <field name="arch" type="xml">
            <list string="Sedes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="wk_school_colombo_sede_search" model="ir.ui.view">
        <field name="name">wk.school.colombo.sede.search</field>
        <field name="model">wk.school.colombo.sede</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Activo" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archivado" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="wk_school_colombo_sede_action" model="ir.actions.act_window">
        <field name="name">Sedes</field>
        <field name="res_model">wk.school.colombo.sede</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="wk_school_colombo_sede_tree"/>
        <field name="search_view_id" ref="wk_school_colombo_sede_search"/>
    </record>

</odoo>
