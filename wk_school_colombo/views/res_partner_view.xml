<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ronda de ajustes post-prueba: los campos generales del aspirante
         (models/res_partner.py) solo se muestran para contactos que son
         estudiantes -evita ensuciar el formulario de un contacto cualquiera
         con 17 campos que no le aplican-. -->
    <record id="view_partner_form_colombo_aspirant_fields" model="ir.ui.view">
        <field name="name">res.partner.form.colombo.aspirant.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='students']" position="after">
                <page name="colombo_aspirant_info" string="Información del aspirante"
                      invisible="not is_student">
                    <group>
                        <group>
                            <field name="program_type_id"/>
                            <field name="tipo_persona"/>
                            <field name="estado_civil"/>
                            <field name="nivel_formacion"/>
                            <field name="idioma_nativo"/>
                            <field name="idioma_nativo_otro" invisible="idioma_nativo != 'otro'"/>
                            <field name="ocupacion_actual"/>
                            <field name="estrato"/>
                            <field name="jornada" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"/>
                            <field name="regimen_salud" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"/>
                        </group>
                        <group>
                            <field name="barrio"/>
                            <field name="city_id" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"/>
                            <field name="issuance_city_id" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"/>
                            <field name="origin_city_id" options="{'no_create_edit': True, 'no_create': True, 'no_edit': True}"/>
                            <field name="origin_city_dian_code" readonly="1"/>
                            <field name="landline_phone"/>
                            <field name="additional_phone"/>
                            <field name="additional_mobile"/>
                            <field name="email_dian"/>
                            <field name="contact_preference"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
