<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wk_school_colombo_certificate_form" model="ir.ui.view">
        <field name="name">wk.school.colombo.certificate.form</field>
        <field name="model">wk.school.colombo.certificate</field>
        <field name="arch" type="xml">
            <form string="Certificado académico">
                <header>
                    <button name="action_download_pdf" type="object"
                            string="Descargar PDF" class="btn-primary"
                            invisible="attachment_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="student_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="program_type_id" readonly="1"/>
                            <field name="grade_id" readonly="1"/>
                            <field name="sede_id" readonly="1"/>
                            <field name="population_type" readonly="1"/>
                            <field name="populate_class_id" readonly="1"
                                   invisible="not populate_class_id"/>
                            <field name="generation_mode" readonly="1"/>
                        </group>
                        <group>
                            <field name="intensidad_horaria" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                            <field name="fecha_expedicion" readonly="1"/>
                            <field name="lugar_expedicion" readonly="1"/>
                        </group>
                    </group>
                    <group string="Datos de registro (manuales)">
                        <field name="libro" readonly="1"/>
                        <field name="folio" readonly="1"/>
                        <field name="consecutivo" readonly="1"/>
                    </group>
                    <field name="attachment_count" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wk_school_colombo_certificate_tree" model="ir.ui.view">
        <field name="name">wk.school.colombo.certificate.list</field>
        <field name="model">wk.school.colombo.certificate</field>
        <field name="arch" type="xml">
            <list string="Certificados generados" create="0" edit="0">
                <field name="create_date" string="Fecha de generación"/>
                <field name="student_id"/>
                <field name="program_type_id"/>
                <field name="grade_id"/>
                <field name="sede_id"/>
                <field name="population_type"/>
                <field name="generation_mode"/>
                <field name="fecha_expedicion"/>
                <field name="libro"/>
                <field name="folio"/>
                <field name="consecutivo"/>
                <field name="create_uid" string="Generado por"/>
            </list>
        </field>
    </record>

</odoo>
