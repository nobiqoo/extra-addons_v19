<odoo>
    <data>
        <!-- explicit list view definition -->

        <record id="helpdesk_zone_list" model="ir.ui.view">
            <field name="name">Helpdesk zone list</field>
            <field name="model">helpdesk.zone</field>
            <field name="arch" type="xml">
                <list string="Zonas">
                    <field name="name" />
                    <field name="partner_company_ids" widget="many2many_tags" />
                    <field name="description" />
                </list>
            </field>
        </record>

        <record id="helpdesk_zone_form" model="ir.ui.view">
            <field name="name">Helpdesk zone form</field>
            <field name="model">helpdesk.zone</field>
            <field name="arch" type="xml">
                <form string="Zonas">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" />
                            <h1>
                                <field name="name" placeholder="Ej: zona norte, zona bananera, etc" />
                            </h1>
                        </div>
                        <group>
                            <field name="partner_company_ids" widget="many2many_tags" />
                            <field name="description" />
                            <field name="rule_ids">
                                <list editable="bottom">
                                    <field name="partner_ids" widget="many2many_tags" />
                                    <field name="team_id" />
                                    <field name="priority" widget="priority" />
                                    <field name="user_rule_id" />
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>

            </field>
        </record>


        <!-- Action for menu -->
        <record id="action_helpdesk_zone" model="ir.actions.act_window">
            <field name="name">Zonas</field>
            <field name="res_model">helpdesk.zone</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aún no hay registros.
                </p>
            </field>
        </record>


        <!-- Menuitem, inside of "Configuración" -->
        <menuitem
            id="menu_helpdesk_zone"
            name="Zonas"
            parent="helpdesk.helpdesk_menu_config"
            action="action_helpdesk_zone"
            groups="helpdesk.group_helpdesk_manager"
            sequence="99" />

    </data>
</odoo>