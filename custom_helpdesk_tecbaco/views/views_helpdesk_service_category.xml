<odoo>
    <data>
        <!-- explicit list view definition -->

        <record id="helpdesk_service_category_list" model="ir.ui.view">
            <field name="name">Helpdesk service category list</field>
            <field name="model">helpdesk.service.category</field>
            <field name="arch" type="xml">
                <list string="Categorías">
                    <field name="name" />
                    <field name="partner_company_ids" widget="many2many_tags"/>
                    <field name="sub_category_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="helpdesk_service_category_form" model="ir.ui.view">
            <field name="name">Helpdesk service category form</field>
            <field name="model">helpdesk.service.category</field>
            <field name="arch" type="xml">
                <form string="Categorías">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" />
                            <h1>
                                <field name="name" placeholder="Ej: redes, ofimática, etc" />
                            </h1>
                        </div>
                        <group>
                            <field name="partner_company_ids" widget="many2many_tags"/>
                            <field name="description" />
                            <field name="sub_category_ids">
                                <list>
                                    <field name="name" />
                                    <field name="description" />
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>

            </field>
        </record>


        <!-- Action for menu -->
        <record id="action_helpdesk_service_category" model="ir.actions.act_window">
            <field name="name">Categorías de soporte al cliente</field>
            <field name="res_model">helpdesk.service.category</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aún no hay registros.
                </p>
            </field>
        </record>


        <!-- Menuitem, inside of "Configuración" -->
        <menuitem
            id="menu_helpdesk_service_category"
            name="Categorías de soporte al cliente"
            parent="helpdesk.helpdesk_menu_config"
            action="action_helpdesk_service_category"
            groups="helpdesk.group_helpdesk_manager"
            sequence="95" />

    </data>
</odoo>