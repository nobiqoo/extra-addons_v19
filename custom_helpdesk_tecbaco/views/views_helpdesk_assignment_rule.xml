<odoo>
<data>
<record id="helpdesk_assignment_rule_from" model="ir.ui.view">
    <field name="name">Helpdesk assignment rule form</field>
    <field name="model">helpdesk.assignment.rule</field>
    <field name="arch" type="xml">
        <form string="Reglas de asignación del equipo">
            <sheet>
                <group>
                <group>
                    <field name="name"/>
                    <field name="team_id"/>
                    <field name="sub_category_id"/>
                    <field name="zone_id"/>
                </group>
                <group>
                    <field name="support_type_id"/>
                    <field name="priority" widget="priority"/>
                    <field name="user_ids" widget="many2many_avatar_user"/>
                </group>
                </group>
            </sheet>
        </form>
    </field>
</record>

        <record id="helpdesk_assignment_rule_list" model="ir.ui.view">
            <field name="name">Helpdesk assignment rule list</field>
            <field name="model">helpdesk.assignment.rule</field>
            <field name="arch" type="xml">
                <list string="Reglas de asignación del equipo">
                    <field name="name"/>
                    <field name="team_id"/>
                    <field name="sub_category_id"/>
                    <field name="zone_id"/>
                    <field name="support_type_id"/>
                    <field name="priority" widget="priority"/>
                    <field name="user_ids" widget="many2many_avatar_user"/>
                </list>
            </field>
        </record>

        <!-- Action for menu -->
        <record id="action_helpdesk_assignment_rule" model="ir.actions.act_window">
            <field name="name">Reglas de asignación del equipo</field>
            <field name="res_model">helpdesk.assignment.rule</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aún no hay registros.
                </p>
            </field>
        </record>


        <!-- Menuitem, inside of "Configuración" -->
        <menuitem
            id="menu_helpdesk_assignment_rule"
            name="Reglas de asignación de los equipos"
            parent="helpdesk.helpdesk_menu_config"
            action="action_helpdesk_assignment_rule"
            groups="helpdesk.group_helpdesk_manager"
            sequence="100"/>

</data>
</odoo>