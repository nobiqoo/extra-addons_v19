<odoo>
    <data>
        <!-- explicit list view definition -->

        <record id="helpdesk_service_type_list" model="ir.ui.view">
            <field name="name">Helpdesk service type list</field>
            <field name="model">helpdesk.service.type</field>
            <field name="arch" type="xml">
                <list string="Servicios">
                    <field name="name"/>
                    <field name="priority" widget="priority"/>
                    <field name="partner_company_ids" widget="many2many_tags"/>
                    <field name="category_id"/>
                    <field name="sub_category_id"/>
                </list>
            </field>
        </record>

        <record id="helpdesk_service_type_form" model="ir.ui.view">
            <field name="name">Helpdesk service type form</field>
            <field name="model">helpdesk.service.type</field>
            <field name="arch" type="xml">
                <form string="Servicios">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" />
                            <h1>
                                <field name="name" placeholder="Ej: falla de conexión remota, etc" />
                            </h1>
                        </div>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="partner_company_ids" widget="many2many_tags"/>
                            <field name="description"/>
                            <field name="category_id" domain="[('id', 'in', allowed_category_ids)]"/>
                            <field name="sub_category_id" domain="[('category_id', '=?', category_id)]"/>
                            <field name="team_ids" widget="many2many_tags"/>
                        </group>
                    </sheet>
                </form>

            </field>
        </record>


        <!-- Action for menu -->
        <record id="action_helpdesk_service_type" model="ir.actions.act_window">
            <field name="name">Servicios</field>
            <field name="res_model">helpdesk.service.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Aún no hay registros.
                </p>
            </field>
        </record>


        <!-- Menuitem, inside of "Configuración" -->
        <menuitem
            id="menu_helpdesk_service_type"
            name="Servicios"
            parent="helpdesk.helpdesk_menu_config"
            action="action_helpdesk_service_type"
            groups="helpdesk.group_helpdesk_manager"
            sequence="97" />

    </data>
</odoo>