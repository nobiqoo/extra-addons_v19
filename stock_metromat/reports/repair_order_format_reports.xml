<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_repair_order_format" model="report.paperformat">
        <field name="name">Formatos de ingreso y remisión</field>
        <field name="format">Letter</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">37</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">32</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_repair_order_reception" model="ir.actions.report">
        <field name="name">Formato de ingreso de equipos</field>
        <field name="model">repair.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_metromat.report_repair_order_reception</field>
        <field name="report_file">stock_metromat.report_repair_order_reception</field>
        <field name="print_report_name">'Ingreso - %s' % (object.name or '').replace('/', '-')</field>
        <field name="paperformat_id" ref="paperformat_repair_order_format"/>
        <field name="binding_model_id" ref="repair.model_repair_order"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_repair_order_delivery" model="ir.actions.report">
        <field name="name">Formato de remisión de equipos</field>
        <field name="model">repair.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">stock_metromat.report_repair_order_delivery</field>
        <field name="report_file">stock_metromat.report_repair_order_delivery</field>
        <field name="print_report_name">'Remisión - %s' % (object.name or '').replace('/', '-')</field>
        <field name="paperformat_id" ref="paperformat_repair_order_format"/>
        <field name="binding_model_id" ref="repair.model_repair_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
