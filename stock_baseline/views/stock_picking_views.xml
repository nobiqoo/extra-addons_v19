<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_stock" model="ir.ui.view">
        <field name="name">stock.picking.view.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="analytic_account_id" context="{'default_partner_id':partner_id, 'default_name':name}" readonly="state != 'draft'" groups="analytic.group_analytic_accounting" />
            </xpath>
        </field>
    </record>
</odoo>