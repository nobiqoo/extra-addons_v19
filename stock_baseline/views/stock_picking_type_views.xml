<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="stock_picking_type_view_form" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hardware']/group/group[3]/div" position="after">
                <field name="package_label_report_template_pdf" options="{'no_create': 1, 'no_create_edit':1}"/>
                <field name="package_label_report_template_zpl" options="{'no_create': 1, 'no_create_edit':1}"/>
            </xpath>
        </field>
    </record>

</odoo>