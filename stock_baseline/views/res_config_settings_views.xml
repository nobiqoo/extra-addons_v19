<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="80" />
            <field name="inherit_id" ref="stock.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//setting[@id='reception_report']" position="after">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="note_sale_to_picking" widget="upgrade_boolean" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="note_sale_to_picking" />
                            <div class="text-muted">
                                Allows you to keep the sales order note to the delivery order note.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="negative_inventory" widget="upgrade_boolean" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="negative_inventory" />
                            <div class="text-muted">
                                Allow negative inventory.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="picking_analytic" widget="upgrade_boolean" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="picking_analytic" />
                            <div class="text-muted">
                                Create analytical lines on the transfer.
                            </div>
                        </div>
                    </div>
                </xpath>
                <xpath expr="//block[@name='operations_setting_container']" position="inside">
                    <setting id="validate_incoming_receptions" help="Users will need permissions to validate incoming receptions. This setting requires to assign users to warehouses.">
                        <field name="validate_incoming_receptions"/>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>