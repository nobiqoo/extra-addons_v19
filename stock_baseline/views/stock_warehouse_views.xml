<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_warehouse_view_form_inherit" model="ir.ui.view">
        <field name="name">stock.warehouse.view.form.inherit</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='warehouse_config']" position="inside">
                <group>
                    <group name="validation" string="Validation">
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}" placeholder="Add a user..."/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
