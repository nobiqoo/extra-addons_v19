<odoo>
  <record id="action_task_open_requirements" model="ir.actions.act_window">
    <field name="name">Requisiciones</field>
    <field name="res_model">approval.request</field>
    <field name="view_mode">list,form</field>
    <field name="views" eval="[
      (ref('project_approvals_integration.approval_request_list_for_task'), 'list'),
      (ref('approvals.approval_request_view_form'), 'form')
    ]"/>
    <field name="domain">[('project_id', '=', context.get('task_project_id'))]</field>
  </record>

  <record id="server_action_task_requirements_ctx" model="ir.actions.server">
    <field name="name">Requisiciones</field>
    <field name="state">code</field>
    <field name="model_id" ref="project.model_project_task"/>
    <field name="code"><![CDATA[
task = records[:1]
proj_id = task.project_id.id if task.project_id else False
action = {
    'type': 'ir.actions.act_window',
    'name': 'Requisiciones',
    'res_model': 'approval.request',
    'view_mode': 'list,form',
    'views': [
        (env.ref('project_approvals_integration.approval_request_list_for_task').id, 'list'),
        (env.ref('approvals.approval_request_view_form').id, 'form'),
    ],
    'domain': [('project_id', '=', proj_id)],
    'context': {'default_project_id': proj_id},
}
action
    ]]></field>
    <field name="binding_model_id" ref="project.model_project_task"/>
    <field name="binding_type">action</field>
  </record>

  <record id="task_form_inherit_requirements_button" model="ir.ui.view">
    <field name="name">project.task.form.inherit.requirements.button</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button class="oe_stat_button" type="action"
                name="%(project_approvals_integration.server_action_task_requirements_ctx)d"
                icon="fa-check-square">
          <span class="o_stat_text">Requisiciones</span>
        </button>
      </xpath>
    </field>
  </record>
</odoo>
