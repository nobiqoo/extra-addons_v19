<odoo>
    <record id="category_report_company" model="ir.rule">
        <field name="name">Análisis de categorías: compañías permitidas</field>
        <field name="model_id" ref="model_sale_budget_category_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="category_report_own" model="ir.rule">
        <field name="name">Análisis de categorías: asesor</field>
        <field name="model_id" ref="model_sale_budget_category_report"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="category_report_manager" model="ir.rule">
        <field name="name">Análisis de categorías: gerencia</field>
        <field name="model_id" ref="model_sale_budget_category_report"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
