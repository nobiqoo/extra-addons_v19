<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_form_customer_activity" model="ir.ui.view">
        <field name="name">res.partner.form.customer.activity</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="x_last_sale_date"/>
                <field name="x_customer_activity_status" widget="badge"
                       decoration-success="x_customer_activity_status == 'active'"
                       decoration-muted="x_customer_activity_status == 'inactive'"/>
            </field>
        </field>
    </record>

    <record id="partner_list_customer_activity" model="ir.ui.view">
        <field name="name">res.partner.list.customer.activity</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="x_last_sale_date" optional="show"/>
                <field name="x_customer_activity_status" optional="show" widget="badge"
                       decoration-success="x_customer_activity_status == 'active'"
                       decoration-muted="x_customer_activity_status == 'inactive'"/>
            </field>
        </field>
    </record>

    <record id="partner_search_customer_activity" model="ir.ui.view">
        <field name="name">res.partner.search.customer.activity</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="x_last_sale_date"/>
                <field name="x_customer_activity_status"/>
            </field>
            <filter name="inactive" position="before">
                <filter name="customer_active" string="Clientes activos"
                        domain="[('x_customer_activity_status', '=', 'active')]"/>
                <filter name="customer_inactive" string="Clientes inactivos"
                        domain="[('x_customer_activity_status', '=', 'inactive')]"/>
                <separator/>
            </filter>
            <filter name="group_country" position="after">
                <filter name="group_customer_activity" string="Estado del cliente"
                        context="{'group_by': 'x_customer_activity_status'}"/>
                <filter name="group_last_sale" string="Fecha de última venta"
                        context="{'group_by': 'x_last_sale_date'}"/>
            </filter>
        </field>
    </record>

    <record id="sale_order_form_customer_activity" model="ir.ui.view">
        <field name="name">sale.order.form.customer.activity</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='partner_details']/field[@name='partner_id']" position="after">
                <field name="x_last_sale_date"/>
                <field name="x_customer_activity_status" widget="badge"
                       decoration-success="x_customer_activity_status == 'active'"
                       decoration-muted="x_customer_activity_status == 'inactive'"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_list_customer_activity" model="ir.ui.view">
        <field name="name">sale.order.list.customer.activity</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_last_sale_date" optional="show"/>
                <field name="x_customer_activity_status" optional="show" widget="badge"
                       decoration-success="x_customer_activity_status == 'active'"
                       decoration-muted="x_customer_activity_status == 'inactive'"/>
            </field>
        </field>
    </record>

    <record id="sale_order_search_customer_activity" model="ir.ui.view">
        <field name="name">sale.order.search.customer.activity</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="x_last_sale_date"/>
                <field name="x_customer_activity_status"/>
            </field>
            <filter name="my_sale_orders_filter" position="before">
                <filter name="active_customers" string="Clientes activos"
                        domain="[('x_customer_activity_status', '=', 'active')]"/>
                <filter name="inactive_customers" string="Clientes inactivos"
                        domain="[('x_customer_activity_status', '=', 'inactive')]"/>
                <separator/>
            </filter>
            <filter name="customer" position="after">
                <filter name="group_customer_activity" string="Estado del cliente"
                        context="{'group_by': 'x_customer_activity_status'}"/>
            </filter>
        </field>
    </record>

    <record id="settings_customer_activity" model="ir.ui.view">
        <field name="name">res.config.settings.customer.activity</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting id="customer_inactivity_period"
                         string="Inactividad de clientes"
                         help="Cantidad de meses sin pedidos confirmados para marcar un cliente como inactivo.">
                    <div class="content-group">
                        <label for="customer_inactivity_months" string="Periodo" class="o_light_label"/>
                        <field name="customer_inactivity_months" class="oe_inline"/>
                        <span class="ms-1">meses</span>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
