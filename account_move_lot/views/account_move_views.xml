<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_view_id_inherit_account_move" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']"
                position="before">
                <field name="available_lot_ids"
                       column_invisible="1"/>
                <field name="lot_ids"
                       readonly="parent.move_type not in ('out_refund', 'in_refund')"
                       domain="[('id', 'in', available_lot_ids)]"
                       widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

</odoo>
