<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_maintenance_mail_user_input_invite" model="mail.template">
            <field name="name">Invitación a encuesta</field>
            <field name="model_id" ref="survey.model_survey_user_input" />
            <field name="subject">Encuesta {{ object.survey_id.display_name }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to">{{ (object.partner_id.email_formatted or object.email) }}</field>
            <field name="description"></field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Apreciado <t t-out="object.partner_id.name or 'cliente'">cliente</t><br/><br/>
        <t t-if="object.survey_id.certification">
            Lo invitamos a realizar la siguiente encuesta.
        </t>
        <t t-else="">
            Lo invitamos a realizar la siguiente encuesta.
        </t>
        <div style="margin: 16px 0px 16px 0px;">
            <a t-att-href="(object.get_start_url())"
                style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                <t t-if="object.survey_id.certification">
                    Iniciar Encuesta
                </t>
                <t t-else="">
                    Iniciar Encuesta
                </t>
            </a>
        </div>
        <t t-if="object.deadline">
            Responde a la encuesta lo antes posible.<br/><br/>
        </t>
    </p>
</div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
