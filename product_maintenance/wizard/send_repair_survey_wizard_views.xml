<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="send_repair_survey_wizard_view_form" model="ir.ui.view">
        <field name="name">send.repair.survey.wizard.view.form</field>
        <field name="model">send.repair.survey.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field
                                name="survey_id"
                                required="1"
                                domain="[('is_maintenance_survey', '=', True)]"
                                options="{'no_open': True, 'no_create': True, 'no_edit': True}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="share" string="Compartir" type="object" class="oe_highlight"/>
                    o
                    <button name="action_cancel" string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_server_product_maintenance_wizard" model="ir.actions.server">
        <field name="name">Enviar Encuesta</field>
        <field name="model_id" ref="repair.model_repair_order"/>
        <field name="binding_model_id" ref="repair.model_repair_order"/>
        <field name="state">code</field>
        <field name="code">
ctx = env.context
action = {
    'name': 'Enviar Encuesta',
    'type': 'ir.actions.act_window',
    'res_model': 'send.repair.survey.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': ctx,
}
        </field>
    </record>
</odoo>