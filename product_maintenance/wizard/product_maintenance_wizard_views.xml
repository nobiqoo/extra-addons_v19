<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_maintenance_wizard_view_form" model="ir.ui.view">
        <field name="name">product.maintenance.wizard.view.form</field>
        <field name="model">product.maintenance.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="date_to" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="update_maintenance_details" string="Actualizar Cronograma de Mantenimiento" type="object" />
                    o
                    <button name="action_cancel" string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_maintenance_wizard" model="ir.actions.server">
        <field name="name">Extender Contrato de Mantenimiento</field>
        <field name="model_id" ref="product_maintenance.model_product_maintenance"/>
        <field name="binding_model_id" ref="product_maintenance.model_product_maintenance"/>
        <field name="state">code</field>
        <field name="code">
ctx = env.context
action = {
    'name': 'Extender Contrato de Mantenimiento',
    'type': 'ir.actions.act_window',
    'res_model': 'product.maintenance.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': ctx,
}
        </field>
    </record>
</odoo>