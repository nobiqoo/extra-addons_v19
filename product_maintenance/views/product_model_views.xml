<odoo>
    <record id="view_product_model_list" model="ir.ui.view">
        <field name="name">product.model.list</field>
        <field name="model">product.model</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="codigo"/>
            </list>
        </field>
    </record>

    <record id="view_product_model_form" model="ir.ui.view">
        <field name="name">product.model.form</field>
        <field name="model">product.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="codigo"/>
                    </group>
                    <notebook>
                        <page string="Temparios Asociados">
                            <field name="tempario_ids" nolabel="1" create="false" delete="false">
                                <list editable="bottom">
                                    <field name="tempario_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menú raíz propio -->
    <menuitem id="menu_product_maintenance_root" name="Mantenimiento de Productos"/>

    <!-- Acción -->
    <record id="action_product_model" model="ir.actions.act_window">
        <field name="name">Modelos de Producto</field>
        <field name="res_model">product.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú -->
    <menuitem
        id="menu_product_model_root"
        name="Modelos de producto"
        parent="repair.menu_repair_order"
        action="action_product_model"
        sequence="30"
    />
</odoo>
