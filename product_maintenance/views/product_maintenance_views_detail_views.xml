<odoo>
    <!-- Vista tipo lista (ya existente) -->
    <record id="product_maintenance_detail_view_list" model="ir.ui.view">
        <field name="name">product.maintenance.detail.view.list</field>
        <field name="model">product.template.maintenance.detail</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" import="false">
                <field name="product_maintenance_id"/>
                <field name="repair_date"/>
                <field name="repair_id"/>
                <field name="repair_state"/>
                <button name="create_repair" string="Crear Orden" type="object" invisible="1"/>
            </list>
        </field>
    </record>
    <record id="product_maintenance_detail_view_gantt" model="ir.ui.view">
        <field name="name">product.maintenance.detail.view.gantt</field>
        <field name="model">product.template.maintenance.detail</field>
        <field name="arch" type="xml">
            <gantt string="Gantt de Mantenimientos"
                date_start="repair_date"
                date_stop="repair_end_date"
                default_group_by="product_maintenance_id"
                color="product_maintenance_id">
                <field name="repair_id"/>
                <field name="repair_state"/>
                <field name="product_maintenance_id"/>
            </gantt>
        </field>
    </record>

    <record id="action_product_maintenance_detail" model="ir.actions.act_window">
        <field name="name">Detalles de Mantenimiento</field>
        <field name="res_model">product.template.maintenance.detail</field>
        <field name="view_mode">list,gantt</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('product_maintenance_detail_view_list')}),
            (0, 0, {'view_mode': 'gantt', 'view_id': ref('product_maintenance_detail_view_gantt')}),
        ]"/>
    </record>

    <menuitem
        id="product_maintenance_detail_menu"
        name="Detalles de Mantenimiento"
        sequence="0"
        action="action_product_maintenance_detail"
        parent="repair.menu_repair_order"/>

    <record id="action_product_maintenance_detail_create_repair" model="ir.actions.server">
        <field name="name">Crear Orden de Mantenimiento</field>
        <field name="model_id" ref="product_maintenance.model_product_template_maintenance_detail"/>
        <field name="binding_model_id" ref="product_maintenance.model_product_template_maintenance_detail"/>
        <field name="state">code</field>
        <field name="code">
if records:
    records.filtered(lambda x: not x.repair_id).create_repair()
        </field>
    </record>
</odoo>
