<odoo>
    <record id="product_maintenance_repair_view" model="ir.ui.view">
        <field name="name">product.maintenance.repair.view</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="domain_product_ids" invisible="1"/>
                <field name="technical_user_id" required="1" readonly="state == 'cancel' or state == 'done'"/>
                <field name="alternate_technical_user_id" readonly="state == 'cancel' or state == 'done'"/>
                <field name="use_native_parts_in_maintenance" invisible="1"/>
                <field name="require_product_to_repair_in_maintenance" invisible="1"/>
                <field name="maintenance_product_id" invisible="1"/>
            </field>
            <field name="schedule_date" position="after">
                <field name="close_date" readonly="1"/>
            </field>
            <field name="under_warranty" position="after">
                <field name="city_id" readonly="state == 'cancel' or state == 'done'"/>
                <field name="maintenance_type" readonly="state == 'cancel' or state == 'done'"/>
                <field name="workcenter_id" readonly="state == 'cancel' or state == 'done'" options="{'no_create': True, 'no_open': True}"/>
                <field name="production_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                <field name="workorder_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                <field name="origin" readonly="1"/>
                <field name="analytic_precision" invisible="1"/>
                <field name="account_analytic_id" invisible="1"/>
                <!-- Integración activos fijos: cuenta analítica obligatoria según política de la compañía -->
                <field name="analytic_distribution" widget="analytic_distribution"
                       required="require_analytic_in_maintenance"
                       readonly="state == 'cancel' or state == 'done'"/>
                <field name="require_analytic_in_maintenance" invisible="1"/>
                <field name="is_presential" readonly="state == 'cancel' or state == 'done'"/>
            </field>
            <field name="picking_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="under_warranty" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <page name="repair_notes" position="after">
                <page name="page_work_detail" string="Trabajos">
                    <group>
                        <group>
                            <field name="excuter_type" readonly="state == 'cancel' or state == 'done'"/>
                        </group>
                        <group>
                            <field name="excuter_user_id" readonly="state == 'cancel' or state == 'done'"/>
                        </group>
                    </group>
                    <field name="work_detail_ids" readonly="state == 'cancel' or state == 'done'">
                        <list editable="bottom">
                            <field name="activity_id"
                                string="Actividad"/>
                            <field name="name" required="1"/>
                            <field name="description" required="1"/>
                            <field name="date" required="1"/>
                            <field name="duration" required="1"/>
                        </list>
                    </field>
                </page>
            </page>
            <field name="tag_ids" position="after">
                <field name="service_reasons" readonly="state == 'cancel' or state == 'done'"/>
                <field name="survey_id" invisible="1" readonly="1"/>
                <field name="survey_response_id" readonly="1"/>
            </field>
            <field name="product_id" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </field>
            <field name="product_id" position="after">
                <field name="maintenance_equipment_ids" widget="many2many_tags" readonly="state == 'cancel' or state == 'done'" options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"/>
                <field name="is_maintenance_product" invisible="1"/>
                <field name="domain_maintenance_product_ids" invisible="1"/>
            </field>
            <field name="move_ids" position="before">
                <field name="maintenance_product_ids" readonly="state == 'cancel' or state == 'done'" invisible="use_native_parts_in_maintenance == True">
                    <list editable="bottom">
                        <field name="allowed_uom_ids" column_invisible="True"/>
                        <field name="product_id" required="1"/>
                        <field name="product_uom_id" required="1"/>
                        <field name="product_uom_qty" required="1"/>
                    </list>
                </field>
            </field>
            <field name="move_ids" position="attributes">
                <attribute name="readonly">state == 'cancel' or state == 'done'</attribute>
                <attribute name="invisible">use_native_parts_in_maintenance == False</attribute>
            </field>
            <field name="lot_id" position="attributes">
                <attribute name="required">0</attribute>
            </field>
            <field name="parts_availability" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
    <record id="view_repair_order_form_inherit_enable_survey" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.enable.survey</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
        <xpath expr="//field[@name='survey_response_id']" position="before">
            <field name="enable_survey"/>
        </xpath>
        </field>
    </record>
</odoo>
