<odoo>
    <record id="view_equipment_utilization_list" model="ir.ui.view">
        <field name="name">equipment.utilization.list</field>
        <field name="model">equipment.utilization</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_utilization_form" model="ir.ui.view">
        <field name="name">equipment.utilization.form</field>
        <field name="model">equipment.utilization</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_equipment_utilization" model="ir.actions.act_window">
        <field name="name">Tipos de Utilización</field>
        <field name="res_model">equipment.utilization</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_equipment_utilization_root"
              name="Utilización"
              parent="menu_product_maintenance_root"
              action="action_equipment_utilization"/>
</odoo>
