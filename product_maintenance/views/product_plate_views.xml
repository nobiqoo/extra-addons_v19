<odoo>
    <record id="view_product_plate_list" model="ir.ui.view">
        <field name="name">product.plate.list</field>
        <field name="model">product.plate</field>  <!-- ← CORREGIDO: "model" -->
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="codigo"/>
            </list>
        </field>
    </record>

    <record id="view_product_plate_form" model="ir.ui.view">
        <field name="name">product.plate.form</field>
        <field name="model">product.plate</field>  <!-- ← CORREGIDO: "model" -->
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="codigo"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
