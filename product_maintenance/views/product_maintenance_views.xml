<odoo>
    <record id="product_maintenance_action_from_product" model="ir.actions.act_window">
        <field name="name">Ordenes</field>
        <field name="res_model">repair.order</field>
        <field name="binding_model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            'default_maintenance_product_id': active_id,
        }</field>
        <field name="domain">[('maintenance_product_id', '=', active_id)]</field>
    </record>

    <record id="product_maintenance_view_form" model="ir.ui.view">
        <field name="name">product.maintenance.view.form</field>
        <field name="model">product.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_maintenance_detailed" string="Crear Detalle de Mantenimiento" type="object"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="show_maintenance_tab_in_product_maintenance" invisible="1"/>
                    <field name="require_analytic_in_maintenance" invisible="1"/>
                    <field name="id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(product_maintenance_action_from_product)d"
                            type="action"
                            class="oe_stat_button"
                            context="{'search_default_active': True, 'default_company_id': company_id, 'default_maintenance_product_id': id}"
                            icon="fa-wrench">
                            <field string="Ordenes" name="product_maintenance_open_count" widget="statinfo"/>
                        </button>
                        <!-- Integración activos fijos: botón para navegar al activo asociado -->
                        <button name="action_view_asset" type="object"
                            class="oe_stat_button"
                            icon="fa-building"
                            invisible="not asset_id">
                            <span class="o_stat_text">Activo Fijo</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Por Ejemplo, Monitor LED" required="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" invisible="1"/>
                            <field name="warranty_end_date" required="1"/>
                            <!-- Integración activos fijos: asociación equipo – activo fijo -->
                            <field name="asset_id"
                                   required="require_analytic_in_maintenance"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   context="{'default_company_id': company_id}"/>
                        </group>
                        <group>
                            <field name="partner_id" required="1"/>
                            <!-- Integración activos fijos: cuenta analítica heredada del activo (solo lectura) -->
                            <field name="analytic_precision" invisible="1"/>
                            <field name="analytic_distribution"
                                   widget="analytic_distribution"
                                   readonly="1"
                                   groups="analytic.group_analytic_accounting"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Información" name="product_info">
                            <group>
                                <group>
                                    <field name="provider_id"/>
                                    <field name="brand_id" required="1"/>
                                    <field name="city_id"
                                           required="1"
                                           options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                                    <field name="workcenter_id"
                                           options="{'no_create': True, 'no_create_edit': True}"
                                           context="{'default_company_id': company_id}"/>
                                    <field name="health_registration" invisible="1"/>
                                    <field name="utilization_type" required="1"/>
                                    <field name="daily_use" required="1"/>
                                    <field name="current_mileage" required="1"/>
                                </group>
                                <group>
                                    <field name="model" invisible="1"/>
                                    <field name="model_id" required="1"/>
                                    <field name="serial_no" invisible="1"/>
                                    <field name="placa"/>
                                    <field name="lot_id" string="Número de serie" invisible="1"/>
                                    <field name="have_catalog" invisible="1"/>
                                    <field name="manufacturing" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Mantenimiento" name="maintenance_statistics" invisible="not show_maintenance_tab_in_product_maintenance">
                            <group>
                                <group name="statistics">
                                    <label for="effective_date"/>
                                    <div class="o_row">
                                        <field name="effective_date" />
                                    </div>
                                    <label for="expected_mtbf"/>
                                    <div class="o_row">
                                        <field name="expected_mtbf"/> días
                                    </div>
                                    <label for="mtbf"/>
                                    <div class="o_row">
                                        <field name="mtbf"/> días
                                    </div>
                                    <label for="estimated_next_failure"/>
                                    <div class="o_row">
                                        <field name="estimated_next_failure"/>
                                    </div>
                                    <field name="latest_failure_date"/>
                                    <label for="mttr"/>
                                    <div class="o_row">
                                        <field name="mttr"/> días
                                    </div>
                                </group>
                            </group>
                        </page>
                        <!--
                        <page string="Contratos" name="maintenance_contracts">
                            <group>
                                <field name="contract_name"/>
                                <field name="contract_number"/>
                                <field name="contract_partner_id"/>
                                <field name="contract_period"/>
                                <field name="contract_start_date"/>
                                <field name="contract_end_date"/>
                                <field name="maintenance_type"/>
                            </group>
                        </page>
                        
                        <page string="Estrategia de Generación">
                            <header>
                                <button name="action_create_maintenance_detailed_period"
                                        string="Generar Mantenimientos (Periodo)"
                                        type="object"
                                        invisible="strategy_type != 'period'"/>
                                <button name="action_create_maintenance_detailed_tempario"
                                        string="Generar Mantenimientos (Tempario)"
                                        type="object"
                                        class="btn-primary"
                                        invisible="strategy_type != 'tempario'"/>
                            </header>
                            <group>
                                <field name="strategy_type"/>
                            </group>
                            <group name="period_fields" invisible="strategy_type != 'period'">
                                <field name="period_start_date"/>
                                <field name="period_end_date"/>
                                <field name="period_frequency"/>
                                <field name="period_interval"/>
                                <field name="period_tempario_id"/>
                            </group>
                            <group name="tempario_fields" invisible="strategy_type != 'tempario'">
                                <field name="tempario_start_date"/>
                                <field name="tempario_end_date"/>
                                <field name="period_tempario_id"/>
                                <field name="contract_equipment_ids"/>
                            </group>
                        </page>
                        -->
                        <page string="Horómetro">
                            <field name="mileage_log_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="date" readonly="1"/>
                                    <field name="user_id" readonly="1"/>
                                    <field name="old_value" readonly="1"/>
                                    <field name="new_value" readonly="1"/>
                                    <field name="delta" readonly="1"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="date" readonly="1"/>
                                        <field name="user_id" readonly="1"/>
                                        <field name="old_value" readonly="1"/>
                                        <field name="new_value" readonly="1"/>
                                        <field name="delta" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Detalle Mantenimiento" name="maintenance_detail" >
                            <field name="maintenance_detail_ids">
                                <list editable="bottom">
                                    <field name="repair_date" readonly="is_weekend == False"/>
                                    <field name="repair_id" readonly="1"/>
                                    <field name="repair_state" readonly="1"/>
                                    <field name="period_tempario_ids" widget="many2many_tags" readonly="1"/>
                                    <button name="create_repair" string="Crear Orden" type="object" invisible="1"/>
                                    <button name="create_repair_with_tempario" string="Crear Orden" type="object" invisible="repair_id != False"/>
                                    <field name="is_weekend" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <!-- <page string="Datos Tecnicos" name="technical_data" >
                            <group>
                                <group>
                                    <field name="risk_type"/>
                                    <field name="voltage"/>
                                    <field name="current"/>
                                    <field name="frequency"/>
                                    <field name="power"/>
                                </group>
                                <group>
                                    <field name="pretion"/>
                                    <field name="temperature"/>
                                    <field name="weight"/>
                                    <field name="flow"/>
                                    <field name="other"/>
                                </group>
                            </group>
                        </page>
                        <page string="Aditamientos" name="maintenance_products" >
                            <field name="maintenance_product_ids">
                                <list editable="bottom">
                                    <field name="product_id" required="1"/>
                                    <field name="product_uom_id" required="1"/>
                                    <field name="product_uom_qty" required="1"/>
                                    <field name="allowed_uom_ids" column_invisible="True"/>
                                </list>
                            </field>
                        </page> -->
                        <page string="Temparios">
                            <field name="tempario_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <!-- <field name="utilization_type"/>
                                    <field name="daily_use"/> -->
                                    <field name="frequency"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_maintenance_view_tree" model="ir.ui.view">
        <field name="name">product.maintenance.view.tree</field>
        <field name="model">product.maintenance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="warranty_end_date"/>
                <!-- Integración activos fijos: columna de activo fijo en lista -->
                <field name="asset_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_product_maintenance" model="ir.actions.act_window">
        <field name="name">Productos de Mantenimiento</field>
        <field name="res_model">product.maintenance</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="product_maintenance_menu"
        name="Productos de Mantenimiento"
        sequence="0"
        action="action_product_maintenance"
        parent="repair.menu_repair_order"/>
</odoo>
