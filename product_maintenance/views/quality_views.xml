<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quality_product_maintenance_view_form" model="ir.ui.view">
        <field name="name">quality.product.maintenance.view.form</field>
        <field name="model">quality.point</field>
        <field name="inherit_id" ref="quality_control_worksheet.quality_point_view_form_inherit_quality_control_worksheet"/>
        <field name="arch" type="xml">
            <field name="worksheet_template_id" position="attributes">
                <attribute name="invisible">test_type not in ('worksheet', 'maintenance', 'maintenance_preinst')</attribute>
            </field>
            <field name="worksheet_success_conditions" position="attributes">
                <attribute name="invisible">test_type not in ('worksheet', 'maintenance', 'maintenance_preinst')</attribute>
            </field>
        </field>
    </record>

    <record id="quality_check_product_maintenance_view_form" model="ir.ui.view">
        <field name="name">quality.check.product.maintenance.view.form</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control_worksheet.quality_check_view_form_inherit_worksheet"/>
        <field name="arch" type="xml">
            <field name="worksheet_template_id" position="attributes">
                <attribute name="invisible">test_type not in ('worksheet', 'maintenance', 'maintenance_preinst')</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="repair_id" readonly="1" invisible="test_type not in ('maintenance', 'maintenance_preinst')"/>
            </field>
            <button name="action_worksheet_check" position="attributes">
                <attribute name="invisible">test_type not in ('worksheet', 'maintenance', 'maintenance_preinst')</attribute>
            </button>
        </field>
    </record>
</odoo>
