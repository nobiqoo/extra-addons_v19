<odoo>
    <!-- Vista tipo árbol -->
    <record id="maintenance_activity_view_list" model="ir.ui.view">
        <field name="name">maintenance.activity.view.list</field>
        <field name="model">maintenance.activity</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="average_time"/>
            </list>
        </field>
    </record>

    <!-- Vista tipo formulario -->
    <record id="maintenance_activity_view_form" model="ir.ui.view">
        <field name="name">maintenance.activity.view.form</field>
        <field name="model">maintenance.activity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="average_time"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menú raíz: Maestros de Mantenimiento -->
    <menuitem
        id="menu_maintenance_masters_root"
        name="Maestros de Mantenimiento"
        parent="repair.menu_repair_order"
        sequence="10"
    />

    <!-- Acción para abrir el modelo de actividades -->
    <record id="action_maintenance_activity" model="ir.actions.act_window">
        <field name="name">Actividades</field>
        <field name="res_model">maintenance.activity</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú Actividades dentro de Maestros -->
    <menuitem
        id="menu_maintenance_activity"
        name="Actividades"
        parent="menu_maintenance_masters_root"
        action="action_maintenance_activity"
        sequence="10"
    />
</odoo>
