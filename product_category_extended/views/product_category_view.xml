<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_extended_form_view" model="ir.ui.view">
        <field name="name">product.category.references</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="reference"/>
            </xpath>
        </field>
    </record>

    <record id="product_category_extended_add_reference_tree_view" model="ir.ui.view">
        <field name="name">product.category.reference.tree</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="reference"/>
            </xpath>
        </field>
    </record>

</odoo>