<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_attribute_add_number_to_line_form_view" model="ir.ui.view">
        <field name="name">product.attribute.add.number.to.line.form.view</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_ids']/list/field[@name='name']" position="after">
                <field name="number"/>
            </xpath>
            <xpath expr="//field[@name='value_ids']/list/field[@name='is_custom']" position="after">
                <field name="attribute_id" invisible="1"/>
                <field name="secondary_value" domain="[('attribute_id', '=', attribute_id)]"/>
            </xpath>
        </field>
    </record>

</odoo>