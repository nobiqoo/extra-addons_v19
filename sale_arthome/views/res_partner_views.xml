<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_sale_arthome" model="ir.ui.view">
        <field name="name">res.partner.form.sale.arthome</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']//group[@name='sale']" position="inside">
                <field name="is_carrier"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_filter_inherit_sale_arthome" model="ir.ui.view">
        <field name="name">res.partner.select.sale.arthome</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_company']" position="after">
                <filter string="Carriers" name="carriers" domain="[('is_carrier', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
