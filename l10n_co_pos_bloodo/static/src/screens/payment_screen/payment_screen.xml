<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_co_pos_bloodo.PaymentScreenButtons" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('js_invoice')]" position="before">
            <button class="button js_einvoice btn btn-light btn-lg d-flex justify-content-between align-items-baseline w-100 w-md-50 lh-lg"
                t-att-class="{ 'highlight active': currentOrder.is_to_einvoice() }"
                t-on-click="toggleIsToEinvoice">
            <span><i class="fa fa-qrcode me-2"/>Electronic invoice</span>
            <i class="fa me-2" t-attf-class="{{ currentOrder.is_to_einvoice() ? 'fa-check-square text-action' : 'fa-square-o' }}" />
            </button>
        </xpath>
    </t>
</templates>