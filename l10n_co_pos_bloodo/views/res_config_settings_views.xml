<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.l10n_co_pos_bloodo</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//setting[@id='pos_default_journals']/div" position="inside">
                    <div class="row">
                        <label string="Electronic invoice" for="pos_einvoice_journal_id" class="col-lg-3 o_light_label"/>
                        <field name="pos_einvoice_journal_id"
                            domain="[('company_id', '=', company_id), ('type', '=', 'sale'), ('is_einvoicing', '=', True)]"
                            required="pos_company_has_template"
                            context="{'default_company_id': company_id, 'default_type': 'sale', 'default_is_einvoicing': True}"/>
                    </div>
                    <div class="row">
                        <label string="Create default invoice" for="pos_default_check_invoice" class="col-lg-3 o_light_label"/>
                        <field name="pos_default_check_invoice"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='pos_journal_id']" position="attributes">
                    <attribute name="domain">[('company_id', '=', company_id), ('type', 'in', ('general', 'sale')), ('is_einvoicing', '=', False)]</attribute>
                </xpath>
                <xpath expr="//field[@name='pos_invoice_journal_id']" position="attributes">
                    <attribute name="domain">[('company_id', '=', company_id), ('type', '=', 'sale'), ('is_einvoicing', '=', False)]</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>