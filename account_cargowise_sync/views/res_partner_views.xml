<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="view_partner_form_cw" model="ir.ui.view">
            <field name="name">res.partner.cw.inherit.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page name="cw_partner" string="CargoWise">
                        <group>
                            <group>
                                <field name="code_cw"/>
                                <field name="org_cw"/>
                            </group>
                            <group>
                                <field name="salesman_code_cw"/>
                                <field name="salesman_cw_id"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
