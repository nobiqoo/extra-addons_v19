<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_internal_reference" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_internal_reference" class="text-start"><strong>Internal Reference</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <t t-set="internal_reference" t-value="line.product_id.default_code or ''"/>
            <t t-set="reference_prefix" t-value="'[%s] ' % internal_reference"/>
        </xpath>
        <xpath expr="//td[@id='product']/span[@t-field='line.name']" position="replace">
            <span t-out="line.name[len(reference_prefix):] if internal_reference and line.name.startswith(reference_prefix) else line.name" style="white-space: pre-line;"/>
        </xpath>
        <xpath expr="//td[@id='product']" position="after">
            <td class="text-start"><span t-out="internal_reference"/></td>
        </xpath>
    </template>

    <!-- Orden de compra (PDF): sin columna Impuestos en las líneas; los totales no cambian -->
    <template id="report_purchaseorder_document_hide_taxes_arthome" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//td[span[contains(@t-out, 'line.tax_ids')]]" position="replace"/>
    </template>
</odoo>
