<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_master_list" model="ir.ui.view">
        <field name="name">delivery.carrier.master.list</field>
        <field name="model">delivery.carrier.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_carrier_master_form" model="ir.ui.view">
        <field name="name">delivery.carrier.master.form</field>
        <field name="model">delivery.carrier.master</field>
        <field name="arch" type="xml">
            <form string="Empresa de Envio">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_delivery_carrier_master" model="ir.actions.act_window">
        <field name="name">Empresas de Envio</field>
        <field name="res_model">delivery.carrier.master</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_delivery_carrier_master"
        name="Empresas de Envio"
        parent="stock.menu_delivery"
        action="action_delivery_carrier_master"
        sequence="30"
    />
</odoo>
