<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_stock_felupe_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.stock.felupe</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="carrier_guide" invisible="picking_type_code != 'outgoing'"/>
                <field name="delivery_carrier_id" invisible="picking_type_code != 'outgoing'"/>
                <field
                    name="picking_preparation_state"
                    readonly="1"
                    force_save="1"
                    invisible="picking_type_code != 'internal'"
                />
            </xpath>
        </field>
    </record>
</odoo>
