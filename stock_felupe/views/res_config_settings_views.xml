<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sale_felupe" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sale.stock.felupe</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting
                    id="res_users_sale_activity_setting"
                    string="Aprobadores de margen bajo"
                    help="Usuarios que deben ser notificados o aprobar margenes bajos."
                >
                    <field name="res_users_sale_activity" widget="many2many_tags"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
