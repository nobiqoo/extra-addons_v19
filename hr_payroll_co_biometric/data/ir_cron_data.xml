<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: Procesamiento automático diario de asistencias -->
        <record id="ir_cron_process_attendance" model="ir.cron">
            <field name="name">Control Biométrico: Procesar Asistencias Diarias</field>
            <field name="model_id" ref="hr_payroll_co_biometric.model_hr_shift_schedule_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_daily_attendance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
