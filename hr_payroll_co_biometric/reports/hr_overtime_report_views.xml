<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════════
         VISTA DEL WIZARD
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_hr_biometric_overtime_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.biometric.overtime.report.wizard.form</field>
        <field name="model">hr.biometric.overtime.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte Consolidado Horas Extras Biométrico">
                <sheet>
                    <group string="Período">
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="state"/>
                        </group>
                    </group>
                    <group string="Filtros Opcionales">
                        <group>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="address_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_pdf"
                            string="Imprimir PDF"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_export_excel"
                            string="Exportar Excel"
                            type="object"
                            class="btn btn-secondary"/>
                    <button special="cancel" string="Cancelar" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el wizard -->
    <record id="action_hr_biometric_overtime_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte Horas Extras Biométrico</field>
        <field name="res_model">hr.biometric.overtime.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         ACCIÓN REPORT (ir.actions.report) — PDF
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="action_report_biometric_overtime" model="ir.actions.report">
        <field name="name">Horas Extras Biométrico</field>
        <field name="model">hr.biometric.overtime.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_payroll_co_biometric.report_biometric_overtime_template</field>
        <field name="report_file">hr_payroll_co_biometric.report_biometric_overtime_template</field>
        <field name="print_report_name">'Horas_Extras_' + (object.date_start and object.date_start.strftime('%Y%m%d') or '') + '_' + (object.date_end and object.date_end.strftime('%Y%m%d') or '')</field>
        <field name="binding_model_id" ref="model_hr_biometric_overtime_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
