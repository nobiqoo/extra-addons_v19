<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_import_shifts_excel_wizard_form" model="ir.ui.view">
        <field name="name">hr.import.shifts.excel.wizard.form</field>
        <field name="model">hr.import.shifts.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Turnos desde Excel">
                <sheet>
                    <field name="state" invisible="1"/>
                    <!-- Panel de carga -->
                    <group invisible="state != 'upload'">
                        <group string="Destino">
                            <field name="create_new_schedule"/>
                            <field name="schedule_id"
                                   invisible="create_new_schedule == True"
                                   required="create_new_schedule == False"/>
                            <field name="schedule_name"
                                   invisible="create_new_schedule == False"
                                   required="create_new_schedule == True"/>
                            <field name="date_start"
                                   invisible="create_new_schedule == False"/>
                            <field name="date_end"
                                   invisible="create_new_schedule == False"/>
                        </group>
                        <group string="Archivo">
                            <field name="excel_file" filename="excel_filename" widget="binary"/>
                            <field name="excel_filename" invisible="1"/>
                        </group>
                    </group>

                    <!-- Formato de la plantilla -->
                    <div class="alert alert-info" role="alert" invisible="state != 'upload'">
                        <strong>Formato del archivo Excel:</strong>
                        <ul class="mb-0 mt-1">
                            <li><strong>Columna A:</strong> Cédula del empleado</li>
                            <li><strong>Columna B:</strong> Código del turno (TA, TB, TC, ADM...)</li>
                            <li><strong>Columna C:</strong> Fecha (YYYY-MM-DD)</li>
                            <li>La primera fila es el encabezado y se omite automáticamente.</li>
                        </ul>
                    </div>

                    <!-- Resultado -->
                    <div invisible="state != 'result'">
                        <field name="result_html" widget="html"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_download_template"
                            string="Descargar Plantilla"
                            type="object"
                            class="btn btn-secondary"
                            invisible="state != 'upload'"/>
                    <button name="action_import"
                            string="Importar"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_open_schedule"
                            string="Abrir Programación"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'result'"/>
                    <button special="cancel" string="Cerrar" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción para abrir el wizard desde el menú -->
    <record id="action_hr_import_shifts_excel_wizard" model="ir.actions.act_window">
        <field name="name">Importar Turnos desde Excel</field>
        <field name="res_model">hr.import.shifts.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
