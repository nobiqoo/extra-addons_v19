<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="dian_concept_type_form" model="ir.ui.view">
            <field name="name">dian.concept.type.form</field>
            <field name="model">dian.concept.type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="dian_code"/>
                            </group>
                            <group>
                                <field name="percentage" invisible="type != 'overtime'"/>
                            </group>
                            <group>
                                <field name="type"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="dian_concept_type_tree" model="ir.ui.view">
            <field name="name">dian.concept.type.tree</field>
            <field name="model">dian.concept.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="dian_code"/>
                    <field name="percentage"/>
                </list>
            </field>
        </record>

        <record id="dian_concept_type_search" model="ir.ui.view">
            <field name="name">dian.concept.type.search</field>
            <field name="model">dian.concept.type</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="dian_code"/>
                    <filter name="dev" string="Devengos" domain="[('type','=','dev')]"/>
                    <filter name="ded" string="Deducciones" domain="[('type','=','ded')]"/>
                    <filter name="overtime" string="Horas extra" domain="[('type','=','overtime')]"/>
                    <group name="group_by">
                        <filter name="group_by_type" string="Tipo" context="{'group_by': 'type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="dian_concept_type_action" model="ir.actions.act_window">
            <field name="name">Tipo de conceptos DIAN</field>
            <field name="res_model">dian.concept.type</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_group_by_type': 1}</field>
        </record>

    </data>
</odoo>