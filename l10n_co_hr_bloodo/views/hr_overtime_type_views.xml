<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_overtime_type_form_dian" model="ir.ui.view">
            <field name="name">hr.overtime.type.form.dian</field>
            <field name="model">hr.overtime.type</field>
            <field name="inherit_id" ref="hr_payroll_co.hr_overtime_type_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="dian_concept_id" required="1" domain="[('type','=','overtime')]" options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>