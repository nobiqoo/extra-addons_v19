<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">

        <record id="hr_payslip_form" model="ir.ui.view">
            <field name="name">hr.payslip.inherit.view.form</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll_co.hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='page_error_log']" position="after">
                    <page string="Nómina Electrónica" name="epayroll">
                        <!-- sistema nuevo -->
                        <field name="edi_hr_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="edi_type"/>
                                <field name="edi_doc_origin_id"/>
                                <field name="edi_datum"/>
                                <field name="hr_edi_state"/>
                                <field name="state"/>
                            </list>
                        </field>
                        <!-- sistema viejo -->
                        <field name="edi_doc_ids" invisible="1" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="edi_type"/>
                                <field name="edi_doc_origin_id"/>
                                <field name="edi_datum"/>
                                <field name="hr_edi_state"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>