<odoo>
    <data>

        <record id="edi_hr_document_view_form" model="ir.ui.view">
            <field name="name">edi.hr.document.view.form</field>
            <field name="model">edi.hr.document</field>
            <field name="arch" type="xml">
                <form string="hr">
                    <header>
                        <button name="xml_datei_erhalten"
                            type="object"
                            string="Generar XML"
                            invisible="state not in ('neu', 'abgelehnt', 'fehler')"/>
                        <button name="genzip"
                            type="object"
                            string="Generar ZIP"
                            invisible="1"/>
                        <button name="gehaltsabrechnung_senden"
                            type="object"
                            string="Enviar XML"
                            invisible="not edi_xml_file or state in ('gesendet','richtig')"/>
                        <button name="zip_status_erhalten"
                            type="object"
                            string="Get Status Zip"
                            invisible="state not in ('gesendet', 'abgelehnt', 'fehler')"/>
                        <button name="status_erhalten"
                            type="object"
                            string="Get Status"
                            invisible="state not in ('gesendet', 'abgelehnt', 'fehler')"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="neu,gesendet,richtig"/>
                    </header>
                    <sheet>
                        <group col="12">
                            <group col="4" colspan="10" name="title" style="border: 0px solid red;">
                                <h1 colspan="4">
                                    <field name="name" nolabel="1" style="border: 0px solid green;"/>
                                </h1>
                                <group colspan="2">
                                    <field name="period_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="contract_id"/>
                                    <field name="company_id"/>
                                    <field name="edi_zahl" invisible="1"/>
                                </group>
                                <group colspan="2">
                                    <field name="edi_type" readonly="1"/>
                                    <field name="edi_datum" readonly="1"/>
                                    <field name="edi_doc_origin_id" invisible="edi_type == 'nie'" required="edi_type != 'nie'"/>
                                    <field name="payslip_id" invisible="1"/>
                                </group>
                                <group colspan="4">
                                    <field name="edi_cune" readonly="1"/>
                                    <field name="edi_cune_uncode" readonly="1" invisible="1"/>
                                    <field name="edi_ssc" readonly="1"/>
                                    <field name="edi_ssc_uncode" readonly="1" invisible="1"/>
                                </group>
                            </group>
                            <group colspan="2" style="border: 0px solid green;">
                                <field name="edi_qr_image" widget="image" options="{'size': [150, 150]}" nolabel="1"/>
                            </group>
                            <group colspan="12">
                                <field name="edi_url" widget="url" readonly="1"/>
                            </group>
                        </group>
                        <group style="border: 0px solid black;">
                            <group style="border: 0px solid red;">
                                <field name="edi_xml_file" filename="edi_xml_fname" readonly="1"/>
                                <field name="edi_xml_fname" invisible="1"/>
                                <field name="edi_zip_file" filename="edi_zip_fname" readonly="1"/>
                                <field name="edi_zip_fname" invisible="1"/>
                            </group>
                            <group style="border: 0px solid red;">
                                <field name="edi_ar_file" filename="edi_ar_fname" readonly="1"/>
                                <field name="edi_ar_fname" invisible="1"/>
                                <field name="edi_zip_key" readonly="1"/>
                            </group>
                            <group>
                                <field name="origin_payslip_id" invisible="edi_type == 'nie'"/>
                                <field name="edi_cune_origin" invisible="edi_type == 'nie'" required="edi_type != 'nie'"/>
                                <field name="edi_zahl_origin" invisible="edi_type == 'nie'" required="edi_type != 'nie'"/>
                                <field name="edi_gen_datum_origin" invisible="edi_type == 'nie'" required="edi_type != 'nie'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Response" name="antwort">
                                <group>
                                    <field name="hr_edi_state" readonly="1"/>
                                    <field name="hr_edi_response" readonly="1"/>
                                </group>
                            </page>
                            <page string="Nóminas" name="payroll">
                                <field name="payslip_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="employee_id"/>
                                        <field name="contract_id"/>
                                        <field name="payslip_type_id"/>
                                        <field name="period_id"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Automation" name="automation">
                                <group>
                                    <field name="to_send" readonly="0"/>
                                    <field name="to_check_status" readonly="0"/>
                                </group>
                            </page>
                            <page string="Log" name="log">
                                <field name="edi_log_ids" readonly="1">
                                    <list default_order="id desc">
                                        <field name="name"/>
                                        <field name="type_request"/>
                                        <field name="status_code"/>
                                        <field name="reason"/>
                                        <field name="edi_request_file" filename="edi_request_fname"/>
                                        <field name="edi_request_fname" readonly="1" invisible="1"/>
                                    </list>
                                    <form>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="hr_id"/>
                                                <field name="edi_request_file"
                                                    filename="edi_request_fname"/>
                                                <field name="edi_request_fname" invisible="1"/>
                                            </group>
                                            <group>
                                                <field name="exec_env"/>
                                                <field name="type_request"/>
                                                <field name="status_code"/>
                                                <field name="reason"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="response"/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Otra información" name="other_info">
                                <group>
                                    <group>
                                        <field name="edi_processing_id" readonly="1"/>
                                    </group>
                                    <group></group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="edi_hr_document_view_tree" model="ir.ui.view">
            <field name="name">edi.hr.document.view.tree</field>
            <field name="model">edi.hr.document</field>
            <field name="arch" type="xml">
                <list>
                    <field name="period_id"/>
                    <field name="name"/>
                    <field name="edi_type"/>
                    <field name="payslip_id"/>
                    <field name="contract_id"/>
                    <field name="edi_xml_fname"/>
                    <field name="edi_doc_origin_id"/>
                    <field name="edi_datum"/>
                    <field name="hr_edi_state"/>
                    <field name="state"/>
                    <!-- <field name="name"/>
                    <field name="name"/>
                    <field name="name"/>
                    <field name="name"/> -->
                </list>
            </field>
        </record>

        <record id="edi_hr_document_view_search" model="ir.ui.view">
            <field name="name">edi.hr.document.view.search</field>
            <field name="model">edi.hr.document</field>
            <field name="arch" type="xml">
                <search string="edi">
                    <field name="name"/>
                    <field name="period_id"/>
                    <field name="payslip_id"/>
                    <group name="group_by">
                        <filter name="group_by_period" string="Priodo" context="{'group_by': 'period_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="edi_hr_document_action" model="ir.actions.act_window">
            <field name="name">Nóminas Electrónicas</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">edi.hr.document</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p>
                <p>
                    <!-- More details about what a user can do with this object will be OK -->
                </p>
            </field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="edi_hr_document_menu_act" name="Nóminas Electrónicas"
            parent="hr_payroll_co.payslip_menu_categ" action="edi_hr_document_action" sequence="20"/>
    </data>
</odoo>