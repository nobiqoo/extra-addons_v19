<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_concept_form_dian" model="ir.ui.view">
            <field name="name">hr.concept.form.dian</field>
            <field name="model">hr.concept</field>
            <field name="inherit_id" ref="hr_payroll_co.hr_concept_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category']" position="after">
                    <field name="dian_ddo" invisible="1"/>
                    <field name="location_code" invisible="1"/>
                    <field name="dian_concept_id" domain="[('type','in',(dian_ddo, False))]" invisible="location_code != 'co'" required="location_code == 'co'" options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>
            </field>
        </record>

        <record id="hr_concept_tree_dian" model="ir.ui.view">
            <field name="name">hr.concept.tree.dian</field>
            <field name="model">hr.concept</field>
            <field name="inherit_id" ref="hr_payroll_co.hr_concept_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="dian_concept_id"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>