<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_novelty_type_form_dian" model="ir.ui.view">
            <field name="name">hr.novelty.type.form.dian</field>
            <field name="model">hr.novelty.type</field>
            <field name="inherit_id" ref="hr_payroll_co.hr_novelty_type_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='category']" position="after">
                    <field name="dian_ddo" invisible="1"/>
                    <field name="dian_concept_id" domain="[('type','in',(dian_ddo, False))]" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>