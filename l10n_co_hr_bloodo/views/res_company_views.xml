<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">
        
        <!-- res.company inherit form view -->
        <record id="view_company_form" model="ir.ui.view">
            <field name="name">res.company.inherit.view.form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Nómina Electrónica" name="ne">
                        <group>
                            <group string="Archivos Enviados">
                                <field name="nie_sent" readonly="1"/>
                                <field name="niae_sent" readonly="1"/>
                                <field name="z_sent" readonly="1"/>
                            </group>
                            <group string="Entorno">
                                <field name="hr_target_environment"/>
                                <field name="hr_software_id"/>
                                <field name="hr_software_pin"/>
                                <field name="hr_test_set_id"/>
                                <field name="hr_provisions_pri"/>
                                <field name="hr_provisions_ces"/>
                                <field name="hr_provisions_vac"/>
                            </group>
                            <group string="Credenciales">
                                <field name="hr_certificate_filename" invisible="1"/>
                                <field name="hr_certificate_file" filename="hr_certificate_filename"/>
                                <field name="hr_certificate_password"/>
                                <br/>
                                <button name="verify_certificate_nie" string="Verify certificate" type="object" class="oe_stat_button" icon="fa-check"/>
                                <field name="hr_signature_policy_url"/>
                                <field name="hr_signature_policy_description"/>
                                <field name="hr_signature_policy_filename" invisible="1"/>
                                <field name="hr_signature_policy_file" filename="hr_signature_policy_filename"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <button name="action_nie_GetNumberingRange" string="NumeringRange" type="object"/>
                                <field name="antwort_gnr" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>