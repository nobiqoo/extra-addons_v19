#. module: account_baseline
#: model_terms:ir.ui.view,arch_db:account_baseline.view_res_config_settings
msgid ""
"Allows to change the partner from the sales invoice lines and\n"
"                            these will be assigned to the account income and\n"
"                            the partner in the header will be assigned to the\n"
"                            account receivable."
msgstr ""
"Permite cambiar el socio de las líneas de factura de venta y \n"
"                           estas se asignarán a la cuenta de ingresos y \n"
"                           el socio en la cabecera se asignará a la \n"
"                           cuenta por cobrar."

#. module: account_baseline
#: model:ir.model.fields,help:account_baseline.field_res_company__manage_partner_in_invoice_lines_out
#: model:ir.model.fields,help:account_baseline.field_res_config_settings__manage_partner_in_invoice_lines_out
msgid ""
"Allows to change the partner from the sales invoice lines and these will be "
"assigned to the account income and the partner in the header will be "
"assigned to the account receivable."
msgstr ""
"Permite cambiar el socio de las lineas de la factura de venta y estas se "
"asignarán a la cuenta de ingresos y el socio en la cabecera se asignará a la"
" cuenta por cobrar."

#. module: account_baseline
#: model_terms:ir.ui.view,arch_db:account_baseline.view_res_config_settings
msgid ""
"Allows to change the partner from the supplier invoice lines and\n"
"                            these will be assigned to the account expense and\n"
"                            the partner in the header will be assigned to the\n"
"                            account payable."
msgstr ""
"Permite cambiar el socio de las lineas de la factura de proveedor y estas se"
"                            asignarán a la cuenta de gastos y el socio en"
"                            la cabecera se asignará a la cuenta por pagar."

#. module: account_baseline
#: model:ir.model.fields,help:account_baseline.field_res_company__manage_partner_in_invoice_lines_in
#: model:ir.model.fields,help:account_baseline.field_res_config_settings__manage_partner_in_invoice_lines_in
msgid ""
"Allows to change the partner from the supplier invoice lines and these will "
"be assigned to the account expense and the partner in the header will be "
"assigned to the account payable."
msgstr ""
"Permite cambiar el socio de las lineas de la factura de proveedor y estas se"
" asignarán a la cuenta de gastos y el socio en la cabecera se asignará a la "
"cuenta por pagar."

