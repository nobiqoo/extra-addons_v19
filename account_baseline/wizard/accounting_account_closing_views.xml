<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_accounting_closing_view_form" model="ir.ui.view">
        <field name="name">account.accounting.closing.view.form</field>
        <field name="model">account.accounting.closing</field>
        <field name="arch" type="xml">
            <form string="Accounting Closing">
                <sheet>
                    <group>
                        <group string="Account Move">
                            <field name="company_id" required="True" groups="base.group_multi_company" />
                            <field name="closing_type" string="Create By?" required="True" />
                            <field name="move_post" string="Post?" />
                        </group>
                        <group string="Dates">
                            <field name="date_start" string="From" required="True" />
                            <field name="date_end" string="To" required="True" />
                        </group>
                        <group string="Origin">
                            <field name="accounts_ids" widget="many2many_tags" />
                            <field name="partners_ids" widget="many2many_tags" domain="[('parent_id','=',False)]" />
                        </group>
                        <group string="Destination">
                            <field name="date" required="True" />
                            <field name="journal_id" required="True" domain="[('type','=','general')]" />
                            <field name="account_id" required="True" />
                            <field name="partner_id" required="True" domain="[('parent_id','=',False)]" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <!-- <button name="action_calculate" string="Calculate" type="object" /> -->
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="account_accounting_closing_action" model="ir.actions.act_window">
        <field name="name">Accounting Closing</field>
        <field name="res_model">account.accounting.closing</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="account_accounting_closing_menu"
        action="account_accounting_closing_action"
        parent="account.menu_finance_entries"
        sequence="100" />
</odoo>