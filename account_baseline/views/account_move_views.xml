<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_tree" model="ir.ui.view">
        <field name="name">view_account_move_tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_residual_signed']" position="after">
                <field name="amount_residual" string="Owed in currency" optional="show" />
            </xpath>
        </field>
    </record>

    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">view.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="current_exchange_rate" invisible="move_type not in ('out_invoice','in_invoice','out_refund','in_refund')" readonly="state != 'draft'" />
                <field name="date_aux" invisible="1" />
            </xpath>
            <xpath expr="//page[@name='invoice_tab']//list//field[@name='name']" position="after">
                <field name="manage_partner_in_invoice_lines_out" column_invisible="1"/>
                <field name="manage_partner_in_invoice_lines_in" column_invisible="1"/>
                <field name="partner_id" optional="show"
                    readonly="(parent.move_type == 'out_invoice' and manage_partner_in_invoice_lines_out == False) or 
                    (parent.move_type == 'in_invoice' and manage_partner_in_invoice_lines_in == False)"/>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list//field[@name='name']" position="after">
                <field name="manage_partner_in_invoice_lines_out" column_invisible="1"/>
                <field name="manage_partner_in_invoice_lines_in" column_invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list//field[@name='partner_id']" position="attributes">
                <attribute name="column_invisible">parent.move_type not in ['entry', 'out_invoice', 'in_invoice']</attribute>
                <attribute name="readonly"> (parent.move_type == 'out_invoice' and not manage_partner_in_invoice_lines_out) or (parent.move_type == 'in_invoice' and not manage_partner_in_invoice_lines_in)</attribute>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list//field[@name='credit']" position="after">
                <field name="date_maturity" string="Fecha de vencimiento" optional="hide" invisible="display_type in ('line_section', 'line_note')" readonly="parent.move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') and display_type in ('line_section', 'line_note', 'product')"/>
            </xpath>
            <xpath expr="//page[@name='invoice_tab']//list//field[@name='deferred_start_date']" position="attributes">
                <attribute name="widget"/>
                <attribute name="options"/>
                <attribute name="string">Fecha inicio diferido</attribute>
            </xpath>
            <xpath expr="//page[@name='invoice_tab']//list//field[@name='deferred_end_date']" position="attributes">
                <attribute name="column_invisible"/>
                <attribute name="string">Fecha fin diferido</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list//field[@name='deferred_start_date']" position="attributes">
                <attribute name="widget"/>
                <attribute name="options"/>
                <attribute name="string">Fecha inicio diferido</attribute>
            </xpath>
            <xpath expr="//page[@name='aml_tab']//list//field[@name='deferred_end_date']" position="attributes">
                <attribute name="column_invisible"/>
                <attribute name="string">Fecha fin diferido</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_move_pivot" model="ir.ui.view">
        <field name="name">view.account.move.pivot</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <pivot string="Invoices Analysis" sample="True">
                <field name="invoice_term_due" type="col" />
                <field name="amount_residual_signed" type="measure" invisible="1" />
            </pivot>
        </field>
    </record>

    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,pivot</field>
    </record>

    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="view_mode">list,kanban,form,pivot</field>
    </record>
</odoo>