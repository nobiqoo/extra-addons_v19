<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">

        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_user_id']" position="before">
                    <field name="is_edit_salesperson" invisible="1"/>
                </xpath>
                <xpath expr="//group[@name='sale_info_group']/field[@name='invoice_user_id']" position="attributes">
                    <attribute name="readonly">not is_edit_salesperson</attribute>
                </xpath>
                <xpath expr="//page[@id='other_tab']/group/group[@name='sale_info_group']/field[@name='partner_bank_id']" position="after">
                    <field name="refund_for_higher_value" invisible="move_type != 'out_refund'" />
                </xpath>
                <xpath expr="//page[@id='invoice_tab']//field[@name='price_unit']" position="after">
                    <field name="shipping_cost" optional="hide"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>