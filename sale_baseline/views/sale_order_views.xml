<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_order_form" model="ir.ui.view">
            <field name="name">sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sales_person']/field[@name='user_id']" position="before">
                    <field name="is_edit_salesperson" invisible="1" />
                </xpath>
                <xpath expr="//group[@name='sales_person']/field[@name='user_id']"
                    position="attributes">
                    <attribute name="readonly">not is_edit_salesperson</attribute>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="unlock_for_credit_limit" groups="sale_baseline.group_block_credit_limit"
                        readonly="state not in ['draft', 'sent']"/>
                    <field name="unlock_for_overdue_invoices" groups="sale_baseline.group_block_expired_invoice"
                        readonly="state not in ['draft', 'sent']"/>
                    <field name="check_user_edit_line" invisible="1" />
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/list/field[@name='price_unit']" position="before">
                    <field name="check_user_edit_line" column_invisible="1" />
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/list/field[@name='price_unit']" position="after">
                    <field name="shipping_cost" optional="hide"/>
                </xpath>
                <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                    <attribute name="readonly">parent.check_user_edit_line == False or qty_invoiced &gt; 0</attribute>
                </xpath>
                <button name="action_confirm" id="action_confirm" data-hotkey="q" position="replace" />
                <button name="action_confirm" position="replace">
                    <field name="show_confirm_button" invisible="1" />
                    <button
                        name="action_confirm"
                        id="action_confirm"
                        data-hotkey="q"
                        string="Confirm"
                        class="btn-primary"
                        type="object"
                        invisible="state not in ['sent'] or not show_confirm_button" />

                    <button name="action_confirm"
                        data-hotkey="v"
                        string="Confirm"
                        type="object"
                        invisible="state not in ['draft'] or not show_confirm_button"
                    />
                </button>
            </field>
        </record>

    </data>
</odoo>
