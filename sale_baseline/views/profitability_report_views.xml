<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="model_profitability_report" model="ir.model">
        <field name="name">profitability.report</field>
        <field name="model">profitability.report</field>
    </record>


    <record id="view_profitability_report_tree" model="ir.ui.view">
        <field name="name">profitability.report.view.tree</field>
        <field name="model">profitability.report</field>
        <field name="arch" type="xml">
            <list string="Profitability by Product" create="false" import="false" delete="false" sample="1">
                <field name="date" />
                <field name="order_name" />
                <field name="invoice_name" />
                <field name="refund_name" />
                <field name="refund_for_high_value"/>
                <field name="analytic_distribution_display"/>
                <field name="user_id" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="category_id" />
                <field name="picking" />
                <field name="quantity_invoiced" />
                <field name="weight" optional="hide"/>
                <field name="total_weight" optional="hide"/>
                <field name="unit_cost" sum="unit_cost"/>
                <field name="total_cost" sum="total_cost" />
                <field name="sale_price" sum="sale_price" />
                <field name="sale_price_total" sum="sale_price_total" />
                <field name="margin" />
                <field name="percentage" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="profitability_report_view_search" model="ir.ui.view">
            <field name="name">profitability.report.view.search</field>
            <field name="model">profitability.report</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="order_name" string="Sale Order" filter_domain="[('order_name', 'ilike', self)]" />
                    <field name="invoice_name" string="Invoice Name" filter_domain="[('invoice_name', 'ilike', self)]" />
                    <field name="refund_name" string="Refund Name" filter_domain="[('refund_name', 'ilike', self)]" />
                    <field name="partner_id" string="Partner" filter_domain="[('partner_id', 'ilike', self)]" />
                    <field name="picking" string="Picking" filter_domain="[('picking', 'ilike', self)]" />
                </search>
            </field>
        </record>

    <record id="action_generate_profitability_report" model="ir.actions.server">
        <field name="name">Generate Profitability Report</field>
        <field name="model_id" ref="model_profitability_report"/>
        <field name="state">code</field>
        <field name="code">action = model.generate_report()</field>
        <field name="binding_model_id" ref="model_profitability_report"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
