<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_report_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.order.report.wizard.form</field>
        <field name="model">sale.order.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Sale Order Report">
                <sheet>
                    <div class="oe_title">
                        <h1>Sale Order Report</h1>
                    </div>
                    <group >
                        <group name="select_date" string="Select Date">
                            <field name="start_date" options="{ 'no_create': True }" placeholder="Select date from..."/>
                            <field name="end_date" options="{ 'no_create': True }" placeholder="Select date to..."/>
                        </group>
                        <group name="select_features" string="Select Features">
                            <field name="partner_id" options="{ 'no_create': True }"/>
                            <field name="category_id" options="{ 'no_create': True }"/>
                            <field name="product_id" options="{ 'no_create': True }"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Generate Report" type="object" name="button_generate_report" icon="fa-refresh" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_order_report_wizard" model="ir.actions.act_window">
        <field name="name">Sale Order Report</field>
        <field name="res_model">sale.order.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sale_order_report_wizard_view_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sale_administrative" name="Sales Administratives" parent="sale.menu_sale_report" sequence="11"/>
    <menuitem id="menu_sale_order_report" name="Sale Order Report" action="action_sale_order_report_wizard" parent="menu_sale_administrative" sequence="15"/>
</odoo>
