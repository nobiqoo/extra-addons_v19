<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="profitability_report_wizard_view_form" model="ir.ui.view">
        <field name="name">profitability.report.wizard.form</field>
        <field name="model">profitability.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Profitability Report">
                <sheet>
                    <div class="oe_title">
                        <h1>Profitability Report</h1>
                    </div>
                    <group >
                        <group name="select_date" string="Select Date">
                            <field name="start_date" options="{ 'no_create': True }" placeholder="Select date from..."/>
                            <field name="end_date" options="{ 'no_create': True }" placeholder="Select date to..."/>
                            <field name="services_included" widget="boolean_toggle"/>
                        </group>
                        <group name="select_features" string="Select Features">
                            <field name="partner_id" options="{ 'no_create': True }"/>
                            <field name="category_id" options="{ 'no_create': True }"/>
                            <field name="product_id" options="{ 'no_create': True }"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Generate Report" type="object" name="button_generate_report" icon="fa-refresh" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_profitability_report_wizard" model="ir.actions.act_window">
        <field name="name">Profitability Report</field>
        <field name="res_model">profitability.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="profitability_report_wizard_view_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sale_report"
            name="Informes"
            parent="sale.sale_menu_root"
            groups="sales_team.group_sale_manager"
            sequence="40"/>
    <menuitem id="sale.menu_sale_report"
            name="Análisis de Ventas"
            parent="sale_baseline.menu_sale_report"
            sequence="10"/>
    <menuitem id="menu_sale_administrative" name="Sales Administratives" parent="sale_baseline.menu_sale_report" sequence="20"/>
    <menuitem id="menu_product_profitability_report" name="Product Profitability Report" action="action_profitability_report_wizard" parent="menu_sale_administrative" sequence="10"/>
</odoo>
