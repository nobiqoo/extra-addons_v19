<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_production_lot_tree_note_plain" model="ir.ui.view">
        <field name="name">stock.lot.list.note.plain.arthome</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <field name="product_qty" position="after">
                <field name="note_plain" optional="show"/>
            </field>
        </field>
    </record>

    <record id="search_product_lot_filter_note_plain" model="ir.ui.view">
        <field name="name">stock.lot.search.note.plain.arthome</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <field name="lot_properties" position="after">
                <field name="note_plain"/>
            </field>
        </field>
    </record>

    <record id="view_production_lot_form_purchase_import" model="ir.ui.view">
        <field name="name">stock.lot.form.purchase.import.arthome</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="purchase_import_names" readonly="1" invisible="not purchase_import_names"/>
            </field>
        </field>
    </record>

    <record id="view_production_lot_tree_purchase_import" model="ir.ui.view">
        <field name="name">stock.lot.list.purchase.import.arthome</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="purchase_import_names" optional="show" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="search_product_lot_filter_purchase_import" model="ir.ui.view">
        <field name="name">stock.lot.search.purchase.import.arthome</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="purchase_import_names"/>
            </field>
            <filter name="group_by_product" position="after">
                <filter name="group_by_purchase_import" string="Import Number" context="{'group_by': 'purchase_import_ids'}"/>
            </filter>
        </field>
    </record>

</odoo>
