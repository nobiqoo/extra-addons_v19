<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_line_tree_note_plain" model="ir.ui.view">
        <field name="name">stock.move.line.list.note.plain.arthome</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="lot_purchase_import_names" optional="show" readonly="1" groups="stock.group_production_lot"/>
                <field name="lot_note_plain" optional="hide" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_tree_detailed_note_plain" model="ir.ui.view">
        <field name="name">stock.move.line.list.detailed.note.plain.arthome</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree_detailed"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="lot_purchase_import_names" optional="hide" readonly="1" groups="stock.group_production_lot"/>
                <field name="lot_note_plain" optional="hide" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree_note_plain" model="ir.ui.view">
        <field name="name">stock.move.line.operations.note.plain.arthome</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field name="lot_purchase_import_names" optional="hide" readonly="1"
                       groups="stock.group_production_lot" column_invisible="parent.has_tracking == 'none'"/>
                <field name="lot_note" widget="text" readonly="not lot_id"
                       column_invisible="parent.show_quant or parent.has_tracking == 'none' or not parent.show_lots_m2o"/>
                <!-- Lote nuevo: el lote todavia no existe como registro, se guarda y se aplica al lote en cuanto se crea. -->
                <field name="pending_lot_note" widget="text"
                       column_invisible="parent.has_tracking == 'none' or not parent.show_lots_text"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_form_note_plain" model="ir.ui.view">
        <field name="name">stock.move.line.form.note.plain.arthome</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_form"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field name="lot_note_plain" readonly="1"
                       invisible="tracking == 'none' or not lot_id"/>
                <field name="lot_purchase_import_names" readonly="1"
                       groups="stock.group_production_lot"
                       invisible="tracking == 'none' or not lot_purchase_import_names"/>
            </field>
        </field>
    </record>

    <record id="stock_move_line_view_search_purchase_import" model="ir.ui.view">
        <field name="name">stock.move.line.search.purchase.import.arthome</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="lot_purchase_import_names" groups="stock.group_production_lot"/>
            </field>
        </field>
    </record>

    <record id="view_stock_move_line_detailed_operation_tree_purchase_import" model="ir.ui.view">
        <field name="name">stock.move.line.detailed.operations.purchase.import.arthome</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_name" position="after">
                <field name="lot_purchase_import_names" optional="hide" readonly="1"
                       groups="stock.group_production_lot"/>
            </field>
        </field>
    </record>

</odoo>
