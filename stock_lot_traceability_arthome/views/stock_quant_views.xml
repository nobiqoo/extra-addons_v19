<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_quant_tree_simple_note" model="ir.ui.view">
        <field name="name">stock.quant.list.note.arthome</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="editable">bottom</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <field name="lot_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="lot_id" position="after">
                <field name="lot_purchase_import_names" optional="show" readonly="1" groups="stock.group_production_lot" />
                <field name="lot_note" widget="text" optional="show" readonly="not lot_id" />
            </field>
            <xpath expr="//field[@name='lot_properties']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='package_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='owner_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='available_quantity']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_editable_note" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.note.arthome</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="lot_purchase_import_names" optional="show" readonly="1" groups="stock.group_production_lot" />
                <field name="lot_note" widget="text" optional="show" readonly="not lot_id" />
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_inventory_editable_purchase_import" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.purchase.import.arthome</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="lot_purchase_import_names" optional="hide" readonly="1"
                       groups="stock.group_production_lot" column_invisible="context.get('hide_lot', False)" />
            </field>
        </field>
    </record>

    <record id="quant_search_view_purchase_import" model="ir.ui.view">
        <field name="name">stock.quant.search.purchase.import.arthome</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view" />
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="lot_purchase_import_names" groups="stock.group_production_lot" />
            </field>
        </field>
    </record>

</odoo>
