<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="account_payment_line_create_form" model="ir.ui.view">
            <field name="name">account.payment.line.create.form</field>
            <field name="model">account.payment.line.create</field>
            <field name="inherit_id" ref="account_payment_order.account_payment_line_create_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_ids']" position="after">
                    <field
                        name="payslip_processing_ids"
                        widget="many2many_tags"
                        placeholder="Dejar vacío para usar todos los procesamientos de nómina"
                    />
                    <field
                        name="bank_id"
                        placeholder="Configurar para pago de nóminas"
                    />
                </xpath>
            </field>
        </record>

    </data>

</odoo>