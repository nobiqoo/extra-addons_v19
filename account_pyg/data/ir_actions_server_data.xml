<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Acción de servidor: PyG por posición XLSX -->
        <record id="action_pyg_position_report_xlsx" model="ir.actions.server">
            <field name="name">PyG por posición XLSX</field>
            <field name="model_id" ref="model_pyg_position_report"/>
            <field name="binding_model_id" ref="model_pyg_position_report"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.generate_xlsx()</field>
        </record>

        <!-- Acción de servidor: PyG por posición PDF -->
        <record id="action_pyg_position_report_pdf" model="ir.actions.server">
            <field name="name">PyG por posición PDF</field>
            <field name="model_id" ref="model_pyg_position_report"/>
            <field name="binding_model_id" ref="model_pyg_position_report"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">records.generate_pdf()</field>
        </record>
    </data>
</odoo>
