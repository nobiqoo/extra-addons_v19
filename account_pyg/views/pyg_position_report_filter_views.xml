<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="pyg_position_report_filter_form" model="ir.ui.view">
            <field name="name">pyg.position.report.filter.form</field>
            <field name="model">pyg.position.report.filter</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="account_root_ids" invisible="1"/>
                            <field name="account_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="analytic_account_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="pyg_position_report_filter_list" model="ir.ui.view">
            <field name="name">pyg.position.report.filter.list</field>
            <field name="model">pyg.position.report.filter</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" optional="show"/>
                    <field name="account_ids" optional="show"/>
                    <field name="analytic_account_ids" optional="show"/>
                    <field name="company_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="pyg_position_report_filter_action" model="ir.actions.act_window">
            <field name="name">P&amp;G por posición (Filtros)</field>
            <field name="res_model">pyg.position.report.filter</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    P&amp;G por posición (Filtros)
                </p>
            </field>
        </record>
    </data>
</odoo>
