        <!-- 3) P&G por posición (Filtros) -->
        <menuitem
            id="menu_pyg_position_report_filter"
            name="P&amp;G por posición (Filtros)"
            action="account_pyg.pyg_position_report_filter_action"
            parent="menu_pyg_root"
            sequence="30"/>

        <!-- 4) Informe de Comisiones -->
        <menuitem
            id="menu_pyg_analytic_position_wizard"
            name="Informe de Comisiones"
            action="account_pyg.action_pyg_analytic_position_wizard"
            parent="menu_pyg_root"
            sequence="40"/>
    </data>
