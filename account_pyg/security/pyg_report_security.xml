<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Grupo para acceso al Informe de Comisiones -->
        <record id="group_pyg_analytic_report" model="res.groups">
            <field name="name">Informe de Comisiones</field>
            <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        </record>

        <!-- Regla multi-empresa para pyg.position.report -->
        <record id="pyg_position_report_company_rule" model="ir.rule">
            <field name="name">PyG por Posición: Regla Multi-Empresa</field>
            <field name="model_id" ref="model_pyg_position_report"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla multi-empresa para pyg.position.report.filter -->
        <record id="pyg_position_report_filter_company_rule" model="ir.rule">
            <field name="name">Filtros PyG: Regla Multi-Empresa</field>
            <field name="model_id" ref="model_pyg_position_report_filter"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
