<odoo>
    <!-- Categoría del módulo -->
    <record model="ir.module.category" id="module_category_sale_control_change">
        <field name="description">Control de Cambio de Precio en Ventas</field>
        <field name="name">Control Cambio de Precio</field>
        <field name="sequence">105</field>
    </record>

    <!-- Privilegio para Control de Precio -->
    <record model="res.groups.privilege" id="privilege_control_change_price">
        <field name="name">Control de Cambio de Precio</field>
        <field name="category_id" ref="module_category_sale_control_change"/>
    </record>

    <!-- Grupo para aprobar/rechazar cambios de precio -->
    <record id="group_can_approve_reject" model="res.groups">
        <field name="name">Puede Aprobar / Rechazar</field>
        <field name="privilege_id" ref="privilege_control_change_price"/>
    </record>
</odoo>
