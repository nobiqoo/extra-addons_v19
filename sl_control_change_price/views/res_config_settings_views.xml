<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--     Extended res_config_settings form view-->
    <record id="res_config_settings_view_form_sale_control_price" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale.control.price</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='discount_sale_order_lines']" position="after">
                <setting id="price_unit_restriction_setting" 
                         string="Restringir el precio unitario en la orden de venta"
                         help="Si el precio unitario en la orden de venta es menor que el precio de venta del producto, entonces restringe la confirmación de la orden">
                    <field name="price_unit_restriction"/>
                    <div class="content-group" invisible="not price_unit_restriction">
                        <div class="mt16">
                            <label for="price_unit_restriction_selection" class="o_light_label"/>
                            <field name="price_unit_restriction_selection" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
                <setting id="discount_restriction_setting"
                         string="Restringir el porcentaje de descuento en orden de Venta"
                         help="Configure el valor del descuento máximo permitido en las ordenes de venta">
                    <field name="discount_restriction"/>
                    <div class="content-group" invisible="not discount_restriction">
                        <div class="mt16">
                            <label for="maximun_discount_restriction" string="Descuento máximo permitido" class="o_light_label"/>
                            <field name="maximun_discount_restriction" class="oe_inline" widget="percentage"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
