<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_company_form_bloodo" model="ir.ui.view">
            <field name="name">res.company.form.bloodo</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='city']" position="after">
                    <field name="city_id" class="o_address_city"
                           options="{'no_create_edit': True, 'no_create': True, 'no_open': True}"
                           invisible="country_code != 'CO'"/>
                </xpath>
                <xpath expr="//field[@name='city']" position="attributes">
                    <attribute name="invisible">country_code == 'CO'</attribute>
                </xpath>
                <xpath expr="//notebook" position="before">
                    <field name="fiscal_position_local" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>