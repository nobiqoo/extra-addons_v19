<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="type_code_view_form" model="ir.ui.view">
            <field name="name">dian.type.code.form</field>
            <field name="model">dian.type_code</field>
            <field name="arch" type="xml">
                <form editable="bottom">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="dian_code"/>
                            </group>
                            <group>
                                <field name="type"/>
                                <field name="is_required_dian" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="type_code_view_tree" model="ir.ui.view">
            <field name="name">dian.type.code.tree</field>
            <field name="model">dian.type_code</field>
            <field name="arch" type="xml">
                <list>
                    <field name="dian_code"/>
                    <field name="name"/>
                    <field name="type"/>
                    <field name="is_required_dian" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="type_code_view_search" model="ir.ui.view">
            <field name="name">dian.type.code.search</field>
            <field name="model">dian.type_code</field>
            <field name="arch" type="xml">
                <search>
                    <field name="dian_code" filter_domain="[('name','ilike',self)]"/>
                    <field name="name" filter_domain="[('name','ilike',self)]"/>
                    <filter name="filter_by_req_dian" string="Requerido DIAN" domain="[('is_required_dian','=',True)]"/>
                    <group name="group_by">
                        <filter name="group_by_type" string="Type" context="{'group_by': 'type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_dian_type_code" model="ir.actions.act_window">
            <field name="name">Responsabilidades Fiscales DIAN</field>
            <field name="res_model">dian.type_code</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_filter_by_req_dian': 1}</field>
        </record>

    </data>
</odoo>
