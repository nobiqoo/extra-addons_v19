<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_view_inherit_dian" model="ir.ui.view">
            <field name="name">product.template.form.dian</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="account.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_information']/group" position="inside">
                    <field name="fiscal_position_local" invisible="1"/>
                    <group name="dian" string="Facturación electrónica Colombiana" invisible="not fiscal_position_local">
                        <field name="dian_brand"/>
                        <field name="dian_model"/>
                        <field name="dian_customs_code"/>
                        <field name="dian_unspsc_id" domain="[('applies_to','=','product')]" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="third_party_income"/>
                        <field name="dian_nominal_tax" invisible="product_variant_count &gt; 1 or is_product_variant"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="product_product_form_view_inherit_dian" model="ir.ui.view">
            <field name="name">product.product.form.dian</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='dian_unspsc_id']" position="after">
                    <field name="dian_nominal_tax"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
