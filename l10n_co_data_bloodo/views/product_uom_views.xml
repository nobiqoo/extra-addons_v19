<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_uom_form_view_inherit_dian" model="ir.ui.view">
            <field name="name">uom.uom.form.dian</field>
            <field name="model">uom.uom</field>
            <field name="inherit_id" ref="uom.product_uom_form_view"/>
            <field name="arch" type="xml">
                <group name="uom_details" position="after">
                    <group name="dian_info" string="Info DIAN">
                        <field name="dian_country_code" invisible="1"/>
                        <field name="dian_uom_id" options="{'no_create': True, 'no_create_edit': True}" required="dian_country_code == 'CO'"/>
                        <field name="dian_unspsc_id" domain="[('applies_to','=','uom')]" options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>
