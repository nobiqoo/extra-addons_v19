<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_reception_act" model="ir.ui.view">
        <field name="name">product.template.form.reception.act</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_lots_and_weight']" position="after">
                <group name="reception_act_regulatory" string="Regulatory Information" invisible="type != 'consu'">
                    <field name="commercial_presentation"/>
                    <field name="sanitary_registration"/>
                    <field name="shelf_life"/>
                    <field name="risk_class"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
