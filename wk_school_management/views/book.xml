<odoo>
    <data>
        <record id="class_books_form" model="ir.ui.view">
            <field name="name">wk.books.form</field>
            <field name="model">wk.books</field>
            <field name="arch" type="xml">
                <form string="Library Book">
                    <header>
                        <button name="action_create_copies" string="Create Copies" class="oe_highlight"  type="object" />
                        <field name="state" widget="statusbar" statusbar_visible="available,not_available"/>
                        </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="action_book_copies" type="object" icon="fa-list">
                                <field string="Copies" name="total_no_of_copies" widget="statinfo"/>
                            </button>
                        </div>
                       <field name="image" widget="image" class="oe_avatar oe_left"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Book Name" required="True"/>
                            </h1>
                            <label for="category_ids" class="oe_edit_only"/>
                            <h2><field name="category_ids" widget="many2many_tags" required="True"/></h2>
                        </div>
                        <notebook>
                            <page string="Information">
                                <group>
                                    <group>
                                        <field name="author" required="True"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                        <field name="publisher"/>
                                        <field name="tag_ids" widget="many2many_tags" options="{'no_create_edit': True, 'color_field': 'color'}"/>
                                    </group>
                                    <group>
                                        <field name="total_no_of_copies"/>
                                        <field name="available_copies"/>
                                        <field name="no_of_copy_issued"/>
                                    </group>
                                </group>
                                <label for="description" string="Description"/>
                                <field name="description"/>
                            </page>
                    
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="class_books_tree" model="ir.ui.view">
            <field name="name">wk.books.list</field>
            <field name="model">wk.books</field>
            <field name="arch" type="xml">
                <list string="Books">
                    <field name="name"/>
                    <field name="author"/>
                    <field name="total_no_of_copies"/>
                    <field name="available_copies"/>
                    <field name="no_of_copy_issued"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="write_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                </list>
            </field>
        </record>

        <record  id="book_kanban_view" model="ir.ui.view">
            <field name="name">wk.book.kanban</field>
            <field name="model">wk.books</field>
            <field name="type">kanban</field>
            <field name="arch" type="xml">
                <kanban string="Book information" >
                    <field name="name" />
                    <field name="currency_id" invisible="1"/>
                    <field name="image" widget="image"/>
                    <templates>
                        <t t-name="card" class="flex-row">
                            <aside class="o_kanban_aside_full">
                                <field name="image" class="o_kanban_image_fill w-100" widget="image" options="{'img_class': 'object-fit-cover'}" alt="Book image"/>
                            </aside>
                            <main class="ps-2 ps-md-0">
                                <h4 class="oe_partner_heading"><field name="name"/></h4>
                                <div class="oe_kanban_partner_links"/>
                                <div>
                                    <b>Author: </b><field name="author"/>
                                </div>
                                <div t-if="record.publisher.value">
                                    <b>Publisher: </b><field name="publisher"/>
                                </div>
                                <div>
                                    <b>Price: </b><field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </div>
                                <field class="hr_tags" name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_book_search" model="ir.ui.view">
            <field name="name">wk.book.search</field>
            <field name="model">wk.books</field>
            <field name="arch" type="xml">
                 <search string="Book">
                    <field name="name" string="Books" filter_domain="['|', '|', ('name', 'ilike', self), ('author', 'ilike', self),('publisher', 'ilike', self)]"/>
                    <field name="author" string="Author" filter_domain="[('author','ilike',self)]"/>
                    <field name="publisher" string="Publisher" filter_domain="[('publisher','ilike',self)]"/>
                    <filter name="available_book_filter" string="Available books" domain="[('state','=','available')]"/>
                    <group>
                       <filter string="Category" name="group_by_category" context="{'group_by':'category_ids'}" />
                   </group>
                </search>
            </field>
        </record>

        <record id="class_books_fine_tree" model="ir.ui.view">
            <field name="name">wk.book.fine</field>
            <field name="model">book.library.fine</field>
            <field name="arch" type="xml">
                <list string="Fine" create="0">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="create_date" />
                    <field name="currency_id" column_invisible="1"/>
                    <field name="fine" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="status" widget="badge" decoration-primary="status=='draft'" decoration-success="status=='collected'" />
                    <field name="write_uid" optional="hide"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="class_books_fine_search" model="ir.ui.view">
           <field name="name">wk.book.fine</field>
           <field name="model">book.library.fine</field>
           <field name="arch" type="xml">
               <search string="Fine">
                    <field name="name" filter_domain="[('name', 'ilike', self)]"/>
                    <field name="student_id" filter_domain="[('student_id', 'ilike', self)]"/>
                    <group>
                        <filter name="group_state" string="State" domain="[]" context="{'group_by':'status'}"/>
                    </group>
               </search>
           </field>
        </record>

        <record id="class_books_fine_form" model="ir.ui.view">
            <field name="name">wk.book.fine.form</field>
            <field name="model">book.library.fine</field>
            <field name="arch" type="xml">
                <form create="0">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="draft,collected"/>
                    </header>
                    <sheet>
                        <h3>
                            <field name="name" readonly="1"/>
                        </h3>
                        <group>
                            <group>
                                <field name="student_id" readonly="1"/>
                                <field name="book_request_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                            <group>
                                <field name="fine" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}" readonly="1"/>
                                <field name="collected_by_id" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="wk_book_action" model="ir.actions.act_window">
            <field name="name">Books</field>
            <field name="res_model">wk.books</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="path">books</field>
        </record>

        <record id="wk_book_fine_action" model="ir.actions.act_window">
            <field name="name">Book Fine</field>
            <field name="res_model">book.library.fine</field>
            <field name="view_mode">list,form</field>
            <field name="path">book-fine</field>
        </record>

        <record id="book_fine_sequence" model="ir.sequence">
            <field name="name">book_fine_sequence</field>
            <field name="code">book_fine.sequence</field>
            <field name="prefix">BF</field>
            <field name="padding">5</field>
        </record>

        <record id="wk_book_copies_action" model="ir.actions.act_window">
            <field name="name">Book Copies</field>
            <field name="res_model">wk.book.copy</field>
            <field name="view_mode">list,form</field>
            <field name="path">book-copies</field>
        </record>

    </data>    
</odoo>    
