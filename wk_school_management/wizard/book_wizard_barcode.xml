<odoo>
<record id="view_barcode_book_wizard_form" model="ir.ui.view">
    <field name="name">barcode.book.wizard.form</field>
    <field name="model">barcode.book.wizard</field>
    <field name="arch" type="xml">
       <form string="Barcode Scan Wizard">
            <group>
                <field name="barcode_input" placeholder="Scan barcode..." nolabel="1" invisible="context.get('issue_button')"/>
                <field name="book_copy" placeholder="Scan barcode..." nolabel="1" invisible="not context.get('issue_button')"/>    
            </group>
            <group invisible="context.get('issue_button')">
                
                <field name="barcode_line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="1" edit="0">
                        <field name="barcode" />
                    </list>
                </field>
            </group>
            <footer>
                <button name="action_issue_return_books" class="oe_highlight" string="Issue/Return" invisible="not context.get('issue_button')" type="object"/>
                <button name="action_create_copie" class="oe_highlight" string="Create" invisible="context.get('issue_button')" type="object"/>
                <button string="Close" special="cancel" class="btn-secondary"/>
            </footer>
        </form>

    </field>
</record>

<record id="view_wk_issue_book_wizard" model="ir.ui.view">
    <field name="name">wk.wizard.book.issue.form</field>
    <field name="model">wk.wizard.book.issue</field>
    <field name="arch" type="xml">
       <form string="Book Issue">
            <group>
                <field name="barcode" readonly="1"/>
                <field name="book_id" readonly="1"/>
                <field name="book_copy_id" readonly="1"/>
                <field name="assign_to_id" required="1"/> 
            </group>
            <footer>
                <button name="action_issue_book" class="oe_highlight" string="Issue" type="object"/>
                <button string="Close" special="cancel" class="btn-secondary"/>
            </footer>
        </form>

    </field>
</record>

<record id="action_barcode_book_wizard" model="ir.actions.act_window">
    <field name="name">Scan Barcodes</field>
    <field name="res_model">barcode.book.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
</record>

</odoo>
