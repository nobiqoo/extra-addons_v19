<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_quality_approver_view_tree" model="ir.ui.view">
        <field name="name">approval.quality.approver.view.tree</field>
        <field name="model">approval.quality.approver</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="existing_user_ids" column_invisible="True"/>
                <field name="company_id" column_invisible="True"/>
                <field name="sequence" widget="handle" />
                <field name="user_id" options="{'no_create': True}"/>
                <field name="approval_role_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" required="1"/>
                <field name="required"/>
                <field name="signature" widget="signature"/>
            </list>
        </field>
    </record>
</odoo>
