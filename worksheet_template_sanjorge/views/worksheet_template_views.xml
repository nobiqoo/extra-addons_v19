<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="action_regenerate_worksheet_model" model="ir.actions.server">
		<field name="name">Regenerar modelo de hoja de trabajo</field>
		<field name="model_id" ref="model_worksheet_template" />
		<field name="state">code</field>
		<field name="code">records.update_worksheet_model()</field>
	</record>

	<record id="worksheet_template_view_form_inherit" model="ir.ui.view">
		<field name="name">worksheet.template.view.form.inherit</field>
		<field name="model">worksheet.template</field>
		<field name="inherit_id" ref="worksheet.worksheet_template_view_form" />
		<field name="arch" type="xml">
			<xpath expr="//header" position="inside">
				<button
					name="%(action_regenerate_worksheet_model)d"
					string="Regenerar Modelo"
					type="action"
					class="btn-primary"
				/>
			</xpath>
			<field name="res_model" position="after">
				<field name="inspection_release_format" />
				<field name="refurbishment_format" />
				<field name="biomedical_equipment_inspection_format" />
			</field>
		</field>
	</record>

</odoo>