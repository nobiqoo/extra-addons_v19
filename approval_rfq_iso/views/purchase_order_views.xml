<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_approval_rfq_iso" model="ir.ui.view">
        <field name="name">purchase.order.form.approval.rfq.iso</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='purchase_delivery_invoice']//field[@name='origin']" position="after">
                <field name="approval_request_origin_id"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_filter_approval_rfq_iso" model="ir.ui.view">
        <field name="name">purchase.order.search.approval.rfq.iso.rfq</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='origin']" position="after">
                <field name="approval_request_origin_id"/>
            </xpath>
            <xpath expr="//search/group/filter[@name='order_date']" position="after">
                <filter string="Aprobacion origen" name="groupby_approval_request_origin_id" domain="[]" context="{'group_by': 'approval_request_origin_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_filter2_approval_rfq_iso" model="ir.ui.view">
        <field name="name">purchase.order.search.approval.rfq.iso.po</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[@name='product_id']" position="after">
                <field name="approval_request_origin_id"/>
            </xpath>
            <xpath expr="//search/group/filter[@name='order_date']" position="after">
                <filter string="Aprobacion origen" name="groupby_approval_request_origin_id_po" domain="[]" context="{'group_by': 'approval_request_origin_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_kpis_tree_approval_rfq_iso" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.approval.rfq.iso</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='origin']" position="after">
                <field name="approval_request_origin_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_tree_approval_rfq_iso" model="ir.ui.view">
        <field name="name">purchase.order.list.approval.rfq.iso</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='origin']" position="after">
                <field name="approval_request_origin_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
