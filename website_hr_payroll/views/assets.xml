<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- Menú principal "Empleados" -->
        <record id="website_hr_employee" model="website.menu">
            <field name="name">Empleados</field>
            <field name="url">#</field>
            <field name="website_id" ref="website.default_website"/>
            <!-- El menú visible del sitio es la copia propia del website (website.menu_id),
                 no la plantilla website.main_menu: colgarse de la plantilla deja el menú oculto. -->
            <field name="parent_id" model="website" eval="obj(ref('website.default_website')).menu_id.id"/>
            <field name="sequence">50</field>
        </record>

        <!-- Submenú "Ausencia" -->
        <record id="website_hr_leave" model="website.menu">
            <field name="name">Ausencia</field>
            <field name="url" eval="'/employee/leave'"/>
            <field name="website_id" ref="website.default_website"/>
            <field name="parent_id" ref="website_hr_payroll.website_hr_employee"/>
            <field name="sequence">1</field>
        </record>

        <!-- Submenú "Desprendible" -->
        <record id="website_hr_detachable" model="website.menu">
            <field name="name">Desprendible</field>
            <field name="url" eval="'/employee/detachable'"/>
            <field name="website_id" ref="website.default_website"/>
            <field name="parent_id" ref="website_hr_payroll.website_hr_employee"/>
            <field name="sequence">2</field>
        </record>

        <!-- Submenú "Certificado" -->
        <record id="website_hr_certificate" model="website.menu">
            <field name="name">Certificado Laboral</field>
            <field name="url" eval="'/employee/certificate'"/>
            <field name="website_id" ref="website.default_website"/>
            <field name="parent_id" ref="website_hr_payroll.website_hr_employee"/>
            <field name="sequence">3</field>
        </record>
    </data>
</odoo>