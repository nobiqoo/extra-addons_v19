<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.website.hr.payroll</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr_payroll_co.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='payroll_policies']" position="after">
                    <block title="Sitio Web" name="payroll_website_settings" invisible="chart_template != 'co'">
                        <setting id="payroll_website_group_1">
                            <div class="d-flex mt-1">
                                <field name="leave_notifier_website" class="ml14"/>
                                <label for="leave_notifier_website" class="o_light_label"/>
                            </div>
                            <div class="d-flex mt-1">
                                <field name="leave_notifier_website_employee" class="ml14"/>
                                <label for="leave_notifier_website_employee" class="o_light_label"/>
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="range_years_in_website" class="col-lg-3 o_light_label"/>
                                    <field name="range_years_in_website"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="payroll_website_group_2">
                            <div class="d-flex mt-1">
                                <field name="leave_notifier_payroll_users_website" class="ml14"/>
                                <label for="leave_notifier_payroll_users_website" class="o_light_label"/>
                            </div>
                            <div class="d-flex mt-1" invisible="not leave_notifier_payroll_users_website">
                                <label for="payroll_users_ids"/>
                                <field name="payroll_users_ids" widget="many2many_tags"
                                       options="{'no_create': True}"/>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
