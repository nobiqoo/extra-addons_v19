<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="leave_mail_to_coach" model="mail.template">
            <field name="name">Notificación de Ausencia a Instructor</field>
            <field name="model_id" ref="hr_payroll_co.model_hr_leave"/>
            <field name="subject">Nueva ausencia registrada de {{ object.employee_id.name }} - {{ object.name }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object._get_website_coach_emails() }}</field>
            <field name="body_html" type="html">
                <p>Hola <strong t-out="object.employee_id.coach_id.name or ''"/>,</p>
                <p>El empleado <strong t-out="object.employee_id.name"/> ha registrado una ausencia <strong t-out="object.name"/>:</p>
                <ul>
                    <li>Tipo: <strong t-out="object.leave_type_id.name"/></li>
                    <li>Desde: <strong t-out="object.date_start"/></li>
                    <li>Hasta: <strong t-out="object.date_end"/></li>
                </ul>
                <br/>
                <p>
                    <a t-attf-href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=hr.leave&amp;view_type=form"
                       style="padding:10px 20px; background:#017e84; color:white; text-decoration:none; border-radius:5px;">
                        Confirmar o rechazar ausencia.
                    </a>
                </p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="leave_mail_to_employee" model="mail.template">
            <field name="name">Notificación de Ausencia a Empleado</field>
            <field name="model_id" ref="hr_payroll_co.model_hr_leave"/>
            <field name="subject">Su ausencia {{ object.name }} ha sido registrada</field>
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object._get_website_employee_emails() }}</field>
            <field name="body_html" type="html">
                <p>Hola <strong t-out="object.employee_id.name"/>,</p>
                <p>Su ausencia <strong t-out="object.name"/> ha sido registrada:</p>
                <ul>
                    <li>Tipo: <strong t-out="object.leave_type_id.name"/></li>
                    <li>Desde: <strong t-out="object.date_start"/></li>
                    <li>Hasta: <strong t-out="object.date_end"/></li>
                </ul>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="leave_mail_to_payroll_users" model="mail.template">
            <field name="name">Notificación de Ausencia a Usuarios de Nómina</field>
            <field name="model_id" ref="hr_payroll_co.model_hr_leave"/>
            <field name="subject">Nueva ausencia registrada de {{ object.employee_id.name }} - {{ object.name }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object._get_website_payroll_emails() }}</field>
            <field name="body_html" type="html">
                <p>Hola,</p>
                <p>El empleado <strong t-out="object.employee_id.name"/> ha registrado una ausencia <strong t-out="object.name"/>:</p>
                <ul>
                    <li>Tipo: <strong t-out="object.leave_type_id.name"/></li>
                    <li>Desde: <strong t-out="object.date_start"/></li>
                    <li>Hasta: <strong t-out="object.date_end"/></li>
                </ul>
                <br/>
                <p>
                    <a t-attf-href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=hr.leave&amp;view_type=form"
                       style="padding:10px 20px; background:#017e84; color:white; text-decoration:none; border-radius:5px;">
                        Ver ausencia.
                    </a>
                </p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
        <record id="hr_leave_user_payroll_notification_mail_template" model="mail.template">
            <field name="name">Notificación de Ausencia confirmada (validación de nómina)</field>
            <field name="model_id" ref="hr_payroll_co.model_hr_leave"/>
            <field name="subject">Solicitud de validación de ausencia {{ object.name }}.</field>
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object._get_approval_request_emails() }}</field>
            <field name="body_html" type="html">
                <p>Hola,</p>
                <p>La ausencia <strong t-out="object.name"/> ha sido confirmada. Por favor, haga la validación:</p>
                <ul>
                    <li>Tipo: <strong t-out="object.leave_type_id.name"/></li>
                    <li>Desde: <strong t-out="object.date_start"/></li>
                    <li>Hasta: <strong t-out="object.date_end"/></li>
                </ul>
                <br/>
                <p>
                    <a t-attf-href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=hr.leave&amp;view_type=form"
                       style="padding:10px 20px; background:#017e84; color:white; text-decoration:none; border-radius:5px;">
                        Validar ausencia.
                    </a>
                </p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="hr_leave_approval_notification_mail_template" model="mail.template">
            <field name="name">Notificación de aprobación/rechazo de Ausencia</field>
            <field name="model_id" ref="hr_payroll_co.model_hr_leave"/>
            <field name="subject">Resultado de la solicitud de ausencia {{ object.name }}.</field>
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object._get_approval_result_emails() }}</field>
            <field name="body_html" type="html">
                <p>El proceso de solicitud del trabajador se registró con la ausencia <span t-out="object.name"/> y consolidó la siguiente información:</p>
                <ul>
                    <li>Fecha de la solicitud: <strong t-out="object._get_requested_date_str()"/></li>
                    <li>Nombre del trabajador: <strong t-out="object.employee_id.name"/></li>
                    <li>Número de documento: <strong t-out="object.employee_id.partner_id.vat"/></li>
                    <li>Cargo: <strong t-out="object.employee_id.job_title"/></li>
                    <li>Unidad de negocio: <strong t-out="object.contract_id.cecos_analytic_id.name"/></li>
                    <li>Correo: <strong t-out="object.employee_id.payroll_mail_notifier"/></li>
                    <li>Fecha inicial: <strong t-out="object._get_start_date_str()"/></li>
                    <li>Cantidad de días: <strong t-out="object._get_days_qty()"/></li>
                </ul>
                <p><strong>Revisión por parte de nómina:</strong></p>
                <ul>
                    <li>Profesional de nómina: <strong t-out="object.user_approval_id.name"/></li>
                    <li>Fecha de regreso del trabajador: <strong t-out="object._get_end_date_str()"/></li>
                </ul>
                <p><strong>Revisión por parte del jefe inmediato:</strong></p>
                <ul>
                    <li>Jefe inmediato: <strong t-out="object.employee_id.coach_id.name"/></li>
                    <li>Aprueba o rechaza la solicitud: <strong t-out="object._get_state_request()"/></li>
                </ul>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="leave_mail_notification_cancel_to_users" model="mail.template">
            <field name="name">Notificación de cancelación de ausencia</field>
            <field name="model_id" ref="hr_payroll_co.model_hr_leave"/>
            <field name="subject">Ausencia rechazada: {{ object.name }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="email_to">{{ object._get_refuse_emails() }}</field>
            <field name="body_html" type="html">
                <p>Hola,</p>
                <p>Su ausencia <strong t-out="object.name"/> ha sido rechazada:</p>
                <ul>
                    <li>Tipo: <strong t-out="object.leave_type_id.name"/></li>
                    <li>Desde: <strong t-out="object.date_start"/></li>
                    <li>Hasta: <strong t-out="object.date_end"/></li>
                </ul>
                <br/>
                <p>
                    <a t-attf-href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=hr.leave&amp;view_type=form"
                       style="padding:10px 20px; background:#017e84; color:white; text-decoration:none; border-radius:5px;">
                        Ver ausencia.
                    </a>
                </p>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
