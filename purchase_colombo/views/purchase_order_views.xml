<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_form_vendor_contact" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.contact.colombo</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="vendor_contact_id"
                    domain="[('id', 'child_of', partner_id)]"
                    context="{'default_parent_id': partner_id}"
                    invisible="not partner_id"
                    readonly="state in ['cancel', 'purchase']"/>
            </field>
        </field>
    </record>
</odoo>
