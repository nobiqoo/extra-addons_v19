<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_purchasequotation_document_hide_empty_informations"
        inherit_id="purchase_stock.report_purchasequotation_document">
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-if">o.incoterm_id</attribute>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_contacts" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//table[@class='table table-borderless']" position="before">
            <div class="row mb-4">
                <div t-if="o.vendor_contact_id" class="col-6" name="vendor_contact_block">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th colspan="2" style="background-color:#CBCBCB;">VENDEDOR</th>
                        </tr>
                        <tr>
                            <td><span t-field="o.vendor_contact_id.name"/></td>
                        </tr>
                        <tr t-if="o.vendor_contact_id.function">
                            <td><span t-field="o.vendor_contact_id.function"/></td>
                        </tr>
                        <tr t-if="o.vendor_contact_id.commercial_company_name">
                            <td><span t-field="o.vendor_contact_id.commercial_company_name"/></td>
                        </tr>
                        <tr t-if="o.vendor_contact_id.city">
                            <td><span t-field="o.vendor_contact_id.city"/></td>
                        </tr>
                        <tr t-if="o.vendor_contact_id.phone">
                            <td>Teléfono: <span t-field="o.vendor_contact_id.phone"/></td>
                        </tr>
                        <tr t-if="o.vendor_contact_id.email">
                            <td>Correo electrónico: <span t-field="o.vendor_contact_id.email"/></td>
                        </tr>
                    </table>
                </div>
                <div t-if="o.user_id" class="col-6" name="colombo_contact_block">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th colspan="2" style="background-color:#CBCBCB;">CONTACTO</th>
                        </tr>
                        <tr>
                            <td><span t-field="o.user_id.name"/></td>
                        </tr>
                        <tr t-if="o.user_id.partner_id.function">
                            <td><span t-field="o.user_id.partner_id.function"/></td>
                        </tr>
                        <tr>
                            <td><span t-field="o.company_id.name"/></td>
                        </tr>
                        <tr>
                            <td>
                                <div t-field="o.company_id.partner_id"
                                    t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                            </td>
                        </tr>
                        <tr t-if="o.user_id.partner_id.phone">
                            <td>Teléfono: <span t-field="o.user_id.partner_id.phone"/></td>
                        </tr>
                        <tr t-if="o.user_id.partner_id.email">
                            <td>Correo electrónico: <span t-field="o.user_id.partner_id.email"/></td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
