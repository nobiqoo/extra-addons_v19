<odoo>
  <record id="view_purchase_selector_wizard_form" model="ir.ui.view">
    <field name="name">purchase.selector.wizard.form</field>
    <field name="model">purchase.selector.wizard</field>
    <field name="arch" type="xml">
      <form string="A Comprar">
        <group>
          <field name="company_id" readonly="1" />
          <field name="date_deadline" />
          <field name="vendor_id" options="{'no_open': True, 'no_create': True}" />
          <field name="picking_type_id" options="{'no_open': True, 'no_create': True}" />
        </group>

        <group string="Productos">
          <field name="line_ids">
            <list editable="bottom">
              <field name="item_id" column_invisible="1" force_save="1"/>
              <field name="line_id" column_invisible="1" force_save="1"/>
              <field name="request_name" readonly="1" force_save="1"/>
              <field name="product_id" readonly="1" force_save="1"/>
              <field name="description"/>
              <field name="uom_id" readonly="1" force_save="1"/>
              <field name="qty_approved" string="Cant. Aprobada" readonly="1" force_save="1" optional='hide'/>
              <field name="qty_pending_purchase" string="Cant. Pendiente por comprar" readonly="1" force_save="1"/>
              <field name="qty_on_hand" string="A la mano" readonly="1" force_save="1"/>
              <field name="qty_to_process" string="Cant. Compra"/>
            </list>
          </field>
        </group>

        <footer>
          <button string="Generar orden" type="object" name="action_open_confirm" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel" />
        </footer>
      </form>
    </field>  
  </record>

  <record id="server_action_open_purchase_selector_wizard" model="ir.actions.server">
    <field name="name">A Comprar</field>
    <field name="model_id" ref="model_approval_purchase_item" />
    <field name="binding_model_id" ref="model_approval_purchase_item" />
    <field name="binding_type">action</field>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">
      action = {
      'type': 'ir.actions.act_window',
      'name': 'A Comprar',
      'res_model': 'purchase.selector.wizard',
      'view_mode': 'form',
      'views': [(env.ref('purchase_selector.view_purchase_selector_wizard_form').id, 'form')],
      'target': 'new',
      'context': dict(env.context, active_model='approval.purchase.item',
      active_ids=env.context.get('active_ids')),
      }
    </field>
  </record>
</odoo>
