<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!-- Odoo 19: res.groups.category_id fue eliminado. La categorización se
             hace ahora vía el modelo res.groups.privilege (que tiene category_id)
             y el grupo se enlaza con privilege_id. -->
        <record id="privilege_profitability_report" model="res.groups.privilege">
            <field name="name">Reporte de Rentabilidad</field>
            <field name="category_id" ref="base.module_category_accounting" />
        </record>

        <record id="group_profitability_report_manager" model="res.groups">
            <field name="name">Reporte de Rentabilidad Ajustes Avanzados</field>
            <field name="privilege_id" ref="privilege_profitability_report" />
        </record>
    </data>

</odoo>