<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_approval_setting_view_form_inherit" model="ir.ui.view">
        <field name="name">purchase.approval.setting.view.form.inherit</field>
        <field name="model">purchase.approval.setting</field>
        <field name="inherit_id" ref="purchase_approval.purchase_approval_setting_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_default_to_purchase']" position="attributes">
                <attribute name="invisible">context.get('from_account_move')</attribute>
            </xpath>
            <xpath expr="//page[.//group[@name='approvers']]" position="attributes">
                <attribute name="invisible">context.get('from_account_move')</attribute>
            </xpath>
            <xpath expr="//page[.//group[@name='approvers']]" position="after">
                <page string="Contabilidad"
                    invisible="not context.get('from_account_move')">
                    <group>
                        <field name="user_approvals_by_budget_am" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='user_approvals_by_budget']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_custom" model="ir.ui.view">
        <field name="name">account.move.form.inherit.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='ref']" position="after">
                <field name="approval_config_id"
                    invisible="move_type != 'in_invoice'"
                    required="move_type == 'in_invoice' and not has_purchase_order_line" 
                    context="{'from_account_move': True}"/>
                <field name="state" />
                <field name="move_type"/>
            </xpath>
            <xpath expr="//button[@name='action_post']" position="after">
                <button name="action_approve_budget"
                    type="object"
                    context="{'validate_analytic': True}" string="Aprobar Presupuesto"
                    invisible="state != 'approval_without_budget' and user_status_budget != 'pending'"
                    id="approve_request_approval" />
                <button name="action_refuse_budget"
                    type="object"
                    context="{'validate_analytic': True}" string="Rechazar Presupuesto"
                    invisible="state != 'approval_without_budget' and user_status_budget != 'pending'"
                    id="refuse_request_approval" />
            </xpath>

        </field>
    </record>


    <record id="purchase_approval_setting_view_list_inherit" model="ir.ui.view">
        <field name="name">purchase.approval.setting.view.list.inherit</field>
        <field name="model">purchase.approval.setting</field>
        <field name="inherit_id" ref="purchase_approval.purchase_approval_setting_view_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='approval_coordinador_id']" position="attributes">
                <attribute name="column_invisible">context.get('from_account_move')</attribute>
            </xpath>
            <xpath expr="//field[@name='approval_with_sequence']" position="attributes">
                <attribute name="column_invisible">context.get('from_account_move')</attribute>
            </xpath>
            <xpath expr="//field[@name='approval_automatic']" position="attributes">
                <attribute name="column_invisible">context.get('from_account_move')</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="user_approvals_by_budget_am" widget="many2many_tags"
                    column_invisible="not context.get('from_account_move')" />
            </xpath>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_purchase_approval_setting">
        <field name="name">Matriz aprobación de presupuesto</field>
        <field name="res_model">purchase.approval.setting</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False" />
        <field name="context">{'from_account_move': True}</field>
    </record>

    <menuitem parent="account.account_account_menu"
        id="menu_purchase_approval_account_move"
        name="Matriz aprobación de presupuesto"
        action="action_purchase_approval_setting" sequence="102"
    />

    <record id="action_pending_invoices_to_approval" model="ir.actions.server">
        <field name="name">Mis Aprobaciones</field>
        <field name="model_id" ref="model_account_move"/>
        <field name="state">code</field>
        <field name="code">action = env.get('account.move').validate_pending_orders_to_approval()</field>
    </record>

    <menuitem
        id="account_menu_my_approvals_by_approver_to_approval"
        parent="account.menu_finance_entries"
        name="Mis Aprobaciones"
        action="action_pending_invoices_to_approval"
        sequence="50"/>
</odoo>