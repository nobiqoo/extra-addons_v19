    <!-- Reglas nuevas del motor de validaciones (noupdate: severidad y
         mensaje editables en Configuración > Validaciones). -->
    <data noupdate="1">
        <record id="val_lamas_tela" model="safra.validation.rule">
            <field name="code">V_LAMAS_TELA</field>
            <field name="name">Lamas por tela no exceden la cantidad total</field>
            <field name="severity">error</field>
        </record>
        <record id="val_lamas_tela_suma" model="safra.validation.rule">
            <field name="code">V_LAMAS_TELA_SUMA</field>
            <field name="name">Lamas por tela completan la cantidad total</field>
            <field name="severity">warning</field>
        </record>
        <!-- Reunión 24-sep: Safra pide QUITAR la restricción de combinación
             repetida (el cliente puede alternar blanco/negro/blanco). La
             regla queda inactiva pero re-activable desde Configuración >
             Validaciones; el filtro del selector de colores la obedece. -->
        <record id="val_telas_repetidas" model="safra.validation.rule">
            <field name="code">V_TELAS_REPETIDAS</field>
            <field name="active" eval="False"/>
            <field name="name">Referencias de tela no repetidas</field>
            <field name="severity">error</field>
        </record>
        <record id="val_textura_seleccion" model="safra.validation.rule">
            <field name="code">V_TEXTURA_SELECCION</field>
            <field name="name">Tela texturizada con diseño de textura elegido</field>
            <field name="severity">error</field>
        </record>
    </data>
