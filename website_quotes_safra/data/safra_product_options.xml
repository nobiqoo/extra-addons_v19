        <record id="popt_gp_control" model="safra.product.option"><field name="type">grupo_prod</field><field name="name">Controles</field><field name="sequence">90</field></record>
        <record id="popt_gp_accesorio" model="safra.product.option"><field name="type">grupo_prod</field><field name="name">Accesorios</field><field name="sequence">100</field></record>
    </data>
</odoo>
