        <record id="popt_gp_tela" model="safra.product.option"><field name="type">grupo_prod</field><field name="name">Tela</field><field name="sequence">10</field></record>
        <record id="popt_gp_perfileria" model="safra.product.option"><field name="type">grupo_prod</field><field name="name">Perfileria</field><field name="sequence">20</field></record>
        <record id="popt_gp_tubo" model="safra.product.option"><field name="type">grupo_prod</field><field name="name">Tubos</field><field name="sequence">30</field></record>
        <record id="popt_gp_mecanismo" model="safra.product.option"><field name="type">grupo_prod</field><field name="name">Mecanismos</field><field name="sequence">40</field></record>
        <record id="popt_gp_soporte" model="safra.product.option"><field name="type">grupo_prod</field><field name="name">Soportes</field><field name="sequence">50</field></record>
        <record id="popt_gp_terminal" model="safra.product.option"><field name="type">grupo_prod</field><field name="name">Terminales</field><field name="sequence">60</field></record>
        <record id="popt_gp_cabezal" model="safra.product.option"><field name="type">grupo_prod</field><field name="name">Cabezal</field><field name="sequence">70</field></record>
