        <!-- Sección "Cenefa PVC" del portal (nombres y opciones fieles).
             Se conservan los valores internos (sin/metalica/tela) para no romper
             la columna del modelo ni las dependencias. -->
        <record id="field_cenefa_type" model="safra.field">
            <field name="name">Cenefa PVC</field>
        </record>
        <record id="opt_cenefa_type_0" model="safra.field.option">
            <field name="field_id" ref="field_cenefa_type"/>
            <field name="value">sin</field><field name="name">No</field><field name="sequence">10</field>
        </record>
        <record id="opt_cenefa_type_1" model="safra.field.option">
            <field name="field_id" ref="field_cenefa_type"/>
            <field name="value">metalica</field><field name="name">Cenefa PVC Clásica</field><field name="sequence">20</field>
        </record>
        <record id="opt_cenefa_type_2" model="safra.field.option">
            <field name="field_id" ref="field_cenefa_type"/>
            <field name="value">tela</field><field name="name">Cenefa PVC Moderna</field><field name="sequence">30</field>
        </record>
        <record id="field_cenefa_lateral" model="safra.field">
