            <field name="value">izquierdo</field><field name="name">Lateral izquierdo</field><field name="sequence">20</field>
        </record>
        <record id="opt_cenefa_lateral_2" model="safra.field.option">
            <field name="field_id" ref="field_cenefa_lateral"/>
            <field name="value">derecho</field><field name="name">Lateral derecho</field><field name="sequence">30</field>
        </record>
        <record id="opt_cenefa_lateral_3" model="safra.field.option">
            <field name="field_id" ref="field_cenefa_lateral"/>
            <field name="value">ambos</field><field name="name">Lateral ambos lados</field><field name="sequence">40</field>
        </record>
        <record id="field_cenefa_lined" model="safra.field">
            <field name="name">¿Cenefa PVC forrada?</field>
        </record>
        <!-- "Tela cenefa PVC" se muestra cuando se marca forrada (igual que el portal) -->
        <record id="field_cenefa_tela" model="safra.field">
            <field name="name">Tela cenefa PVC</field>
            <field name="depends_field_id" ref="field_cenefa_lined"/>
            <field name="depends_value">1</field>
        </record>
        <!-- "Tipo de corte" no existe en el flujo PVC de ENROLLABLE: se oculta -->
        <record id="sf_01_cenefa_corte" model="safra.system.field">
            <field name="active" eval="False"/>
        </record>
