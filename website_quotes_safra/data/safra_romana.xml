<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ROMANA TRADICIONAL (10): otra familia. Reusa el catálogo global con
         OVERRIDES por sistema (etiqueta/opciones/deps en safra.system.field). -->
    <data noupdate="0">
        <record id="system_10" model="safra.system">
            <field name="tech_width_min">0.3</field>
            <field name="tech_width_max">3</field>
            <field name="tech_height_min">0.6</field>
            <field name="tech_height_max">3</field>
            <field name="tech_mechanism"></field>
        </record>
        <record id="field_quantity_lamas" model="safra.field">
            <field name="code">quantity_lamas</field>
            <field name="name">Cantidad de Lamas</field>
            <field name="section_id" ref="section_dimensiones"/>
            <field name="field_type">integer</field>
            <field name="col_size">4</field>
            <field name="sequence">300</field>
        </record>
        <record id="field_perfil_cenefa" model="safra.field">
            <field name="code">perfil_cenefa</field>
            <field name="name">Perfil Cenefa</field>
            <field name="section_id" ref="section_cenefa"/>
