            <field name="col_size">4</field>
            <field name="sequence">405</field>
            <field name="depends_field_id" ref="field_cenefa_type"/>
            <field name="depends_value">tela</field>
        </record>
        <record id="opt_perfil_cenefa_0" model="safra.field.option">
            <field name="field_id" ref="field_perfil_cenefa"/>
            <field name="value">1</field><field name="name">Estándar</field><field name="sequence">10</field>
