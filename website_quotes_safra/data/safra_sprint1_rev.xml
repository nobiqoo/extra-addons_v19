        <!-- «Interruptor» confunde (parece un interruptor de luz): pasa a
             «Módulo de Control RF», nombre sugerido en la sesión. -->
        <record id="field_interruptor_rf" model="safra.field">
            <field name="name">Módulo de Control RF</field>
        </record>

        <!-- Paneles: cantidad de lamas, traslape y apertura ANTES de las
             telas (alimentan la tabla de configuraciones); coordinado justo
             después del color de la tela 1. -->
        <record id="sf_11_quantity_lamas" model="safra.system.field"><field name="sequence">140</field></record>
        <!-- El traslape venía condicionado a «¿Riel Dividido? = Sí» (matriz);
             al quedar antes de las telas debe verse SIEMPRE (alimenta la
             fórmula, que usa 8 cm si no se toca). -->
        <record id="sf_11_tamano_traslape" model="safra.system.field"><field name="sequence">143</field><field name="clear_depends" eval="True"/></record>
        <record id="sf_11_apertura" model="safra.system.field"><field name="sequence">146</field></record>
        <record id="sf_11_coordinado" model="safra.system.field"><field name="sequence">172</field></record>

        <record id="sf_54_quantity_lamas" model="safra.system.field"><field name="sequence">140</field></record>
