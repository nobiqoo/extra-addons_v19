         reordenamientos y renombres acordados en vivo. Los cambios de
         comportamiento van en código (JS/controller/validaciones). -->
    <data noupdate="0">

        <!-- Tipo de apertura: pasa a la sección TELA y es obligatorio (las
             fórmulas de lamas/pantógrafos lo necesitan siempre). -->
        <record id="field_apertura" model="safra.field">
            <field name="section_id" ref="section_tela"/>
            <field name="required" eval="True"/>
