        <!-- Con el campo siempre visible, 8 cm queda preseleccionado (el
             valor que la fórmula asume por defecto). -->
        <record id="field_tamano_traslape" model="safra.field">
            <field name="default_value">0.08</field>
        </record>
        <record id="sf_54_apertura" model="safra.system.field"><field name="sequence">146</field></record>
        <record id="sf_54_coordinado" model="safra.system.field"><field name="sequence">172</field></record>

