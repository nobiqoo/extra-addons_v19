        <record id="val_secuencia_pendiente" model="safra.validation.rule">
            <field name="code">V_SECUENCIA_PENDIENTE</field>
            <field name="name">Secuencia configurada antes de guardar</field>
            <field name="severity">error</field>
        </record>
        <!-- Bloque 3 (3.4): con Tipo de Plano, el pedido debe traer todos
             los segmentos del plano, uno por persiana y sin repetir. -->
        <record id="val_plano_segmentos" model="safra.validation.rule">
            <field name="code">V_PLANO_SEGMENTOS</field>
            <field name="name">Segmentos completos del Tipo de Plano</field>
            <field name="severity">error</field>
        </record>
        <!-- Reunión 28-sep: reglas de la tarea Sprint 1.1. -->
        <record id="val_secuencia_min" model="safra.validation.rule">
            <field name="code">V_SECUENCIA_MIN</field>
            <field name="name">Secuencia de al menos dos persianas</field>
            <field name="severity">error</field>
        </record>
        <record id="val_secuencia_alto" model="safra.validation.rule">
            <field name="code">V_SECUENCIA_ALTO</field>
            <field name="name">Mismo alto por referencia dentro de la secuencia</field>
            <field name="severity">error</field>
        </record>
        <record id="val_alineado_localizacion" model="safra.validation.rule">
            <field name="code">V_ALINEADO_LOCALIZACION</field>
            <field name="name">Alineado: dos persianas en la misma localización</field>
            <field name="severity">error</field>
        </record>
        <record id="val_revalidacion" model="safra.validation.rule">
            <field name="code">V_REVALIDACION</field>
            <field name="name">Revalidación de la cotización al confirmarla</field>
            <field name="severity">error</field>
        </record>
        <!-- Pendiente 12.3 (rollos = lotes): validación por rollo. -->
        <record id="val_rollo_disponible" model="safra.validation.rule">
            <field name="code">V_ROLLO_DISPONIBLE</field>
            <field name="name">Rollo (lote) con metros suficientes para la persiana</field>
            <field name="severity">warning</field>
        </record>
        <record id="val_rollo_alineado" model="safra.validation.rule">
            <field name="code">V_ROLLO_ALINEADO</field>
            <field name="name">Persianas alineadas de un mismo rollo</field>
            <field name="severity">warning</field>
        </record>
        <!-- Pendiente 4: revisión periódica de cotizaciones sin confirmar.
             Nace INACTIVA para no anular de golpe las cotizaciones de
             prueba; se activa en Ajustes > Técnico > Acciones planificadas. -->
        <record id="cron_anular_cotizaciones_invalidas" model="ir.cron">
            <field name="name">Cotizador Safra: anular cotizaciones sin confirmar que ya no cumplen</field>
            <field name="model_id" ref="model_safra_quote"/>
            <field name="state">code</field>
            <field name="code">model._cron_anular_invalidas()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>

    <!-- Revisión 09-oct: si los tipos de reparto (una fórmula por apertura)
         tenían fórmulas editadas, se pasan a la fórmula única. Va al final
         para que la regla ya exista. -->
    <data noupdate="0">
        <function model="safra.panel.combo.rule" name="_migrar_desde_tipos"/>
    </data>
</odoo>
