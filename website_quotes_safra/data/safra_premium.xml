        </record>
        <record id="field_num_segmento" model="safra.field">
            <field name="code">num_segmento</field>
            <!-- Reunión 28-sep (fila 112): el campo se llama «Segmento». -->
            <field name="name">Segmento</field>
            <field name="section_id" ref="section_otras"/>
            <field name="field_type">selection</field>
            <field name="col_size">4</field>
            <field name="sequence">610</field>
            <field name="depends_field_id" ref="field_tipo_plano"/>
            <field name="depends_value">A,B,C,D,E,F,G,H</field>
        </record>

