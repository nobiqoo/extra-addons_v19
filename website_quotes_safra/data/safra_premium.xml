<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sistema ENROLLABLE PREMIUM (06) replicando el portal del cliente.
         Reusa el catálogo global de campos/opciones (idéntico a ENROLLABLE) y
         las mismas telas/imágenes (grupo 06). Solo configura mapeos, orden,
         ficha y un par de campos propios (Tipo de Plano, Nº segmento, Cabezal). -->
    <data noupdate="0">

        <!-- Ficha técnica PREMIUM -->
        <record id="system_06" model="safra.system">
            <field name="tech_width_min">0.3</field>
            <field name="tech_width_max">4.5</field>
            <field name="tech_height_min">0.3</field>
            <field name="tech_height_max">7</field>
            <field name="tech_mechanism">Tubo: R8 - Mecanismo: R8SHEER - Cabezal: R8</field>
            <field name="img_group">06</field>
        </record>

        <!-- Exhibición: solo usuarios internos; no se muestra en el portal del asesor -->
        <record id="sf_06_exhibition" model="safra.system.field"><field name="active" eval="False"/></record>

        <!-- Tipo de cabezal: en PREMIUM la opción es "Cabezal Redondo" -->
        <record id="opt_cabezal_tipo_0" model="safra.field.option">
            <field name="field_id" ref="field_cabezal_tipo"/>
            <field name="value">1</field><field name="name">Cabezal Redondo</field><field name="sequence">10</field>
        </record>
        <delete model="safra.field.option" id="opt_cabezal_tipo_1"/>

