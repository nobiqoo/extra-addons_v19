            <field name="field_type">selection</field>
            <field name="col_size">4</field>
            <field name="sequence">600</field>
        </record>
        <record id="opt_tipo_plano_0" model="safra.field.option">
            <field name="field_id" ref="field_tipo_plano"/>
            <field name="value">A</field><field name="name">Plano tipo A</field><field name="sequence">10</field>
        </record>
        <record id="opt_tipo_plano_1" model="safra.field.option">
