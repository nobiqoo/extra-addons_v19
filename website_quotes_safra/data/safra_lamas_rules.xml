<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Máximo total de lamas/pantógrafos — esquema unificado (apunte
         23-sep): UNA fórmula por sistema; el código decide qué partes
         aplican según la apertura y el accionamiento (video 03:26: «el
         ancho real como variable y el resto constantes configurables»).
         Editables en Configuración > Máximo de Lamas. -->
    <data noupdate="0">
        <function model="safra.lamas.rule" name="_migrate_unified_rules"/>
    </data>

    <data noupdate="1">
        <!-- VERTICAL: (Ancho − Aux[apertura]) / 0.08 + Adicional[apertura];
             Extremos redondea a par. -->
        <record id="lru_vertical" model="safra.lamas.rule">
            <field name="system_ids" eval="[(6, 0, [ref('system_40')])]"/>
            <field name="drive_type">any</field>
            <field name="apertura">any</field>
            <field name="divisor">0.08</field>
            <field name="round_even" eval="True"/>
            <field name="formula_code">(ancho - {'extremos': 0.132, 'centro': 0, 'izquierda': 0.09, 'derecha': 0.09}[apertura]) / divisor + {'extremos': 2, 'centro': 0, 'izquierda': 1, 'derecha': 1}[apertura]</field>
        </record>

        <!-- VINTAGE: manual /1.106 con Aux/Adicional por apertura; la
             motorizada cambia a /1.105 sin Aux (matriz 17-sep). -->
        <record id="lru_vintage" model="safra.lamas.rule">
            <field name="system_ids" eval="[(6, 0, [ref('system_42')])]"/>
            <field name="drive_type">any</field>
            <field name="apertura">any</field>
            <field name="divisor">1.106</field>
            <field name="round_even" eval="True"/>
            <field name="formula_code">((ancho - {'extremos': 0.172, 'centro': 0.164, 'izquierda': 0.150, 'derecha': 0.150}[apertura]) / 1.106 + {'extremos': 2, 'centro': 1, 'izquierda': 1, 'derecha': 1}[apertura]) if not motorizado else (ancho / 1.105 + {'extremos': -1, 'centro': 0, 'izquierda': 0, 'derecha': 0}[apertura])</field>
        </record>

        <!-- VINTAGE ESTÁNDAR: la manual de Vintage dividida entre 2; la
             motorizada es igual a la de Vintage (sin dividir). -->
        <record id="lru_vintage_std" model="safra.lamas.rule">
            <field name="system_ids" eval="[(6, 0, [ref('system_63')])]"/>
            <field name="drive_type">any</field>
            <field name="apertura">any</field>
            <field name="divisor">1.106</field>
            <field name="round_even" eval="True"/>
            <field name="formula_code">(((ancho - {'extremos': 0.172, 'centro': 0.164, 'izquierda': 0.150, 'derecha': 0.150}[apertura]) / 1.106 + {'extremos': 2, 'centro': 1, 'izquierda': 1, 'derecha': 1}[apertura]) / 2) if not motorizado else (ancho / 1.105 + {'extremos': -1, 'centro': 0, 'izquierda': 0, 'derecha': 0}[apertura])</field>
        </record>
    </data>

    <data noupdate="1">
        <record id="val_max_lamas" model="safra.validation.rule">
            <field name="code">V_MAX_LAMAS</field>
            <field name="name">Cantidad de lamas igual al máximo calculado</field>
            <field name="severity">error</field>
        </record>
    </data>
</odoo>
