<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======================== TELAS ======================== -->

    <record id="view_safra_fabric_tree" model="ir.ui.view">
        <field name="name">safra.fabric.tree</field>
        <field name="model">safra.fabric</field>
        <field name="arch" type="xml">
            <list string="Referencias / Telas">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="system_ids" widget="many2many_tags" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_safra_fabric_form" model="ir.ui.view">
        <field name="name">safra.fabric.form</field>
        <field name="model">safra.fabric</field>
        <field name="arch" type="xml">
            <form string="Referencia / Tela">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_stock" class="oe_stat_button" icon="fa-cubes">
                            <field name="stock_disponible" widget="statinfo" string="Disponible (m)"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="category_id"/>
                            <!-- Revisión 17-sep: los sistemas van junto a la
                                 categoría, no en un grupo aparte. -->
                            <field name="system_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <!-- Reunión 13-oct (filas 50-52): la presentación
                                 de las opciones se configura aquí. -->
                            <field name="display_mode" placeholder="La del campo"/>
                            <!-- Reunión 15-oct (fila 50): perfiles (u otros
                                 insumos) que solo sirven para ciertas telas. -->
                            <field name="es_tela" invisible="1"/>
                            <field name="tela_ids" widget="many2many_tags" invisible="es_tela"
                                   options="{'no_create': True}" placeholder="Todas las telas"/>
                            <field name="es_control" invisible="1"/>
                            <field name="es_riel" invisible="1"/>
                            <field name="es_motor" invisible="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Parametrización">
                            <field name="is_blackout"/>
                            <field name="is_sheer"/>
                            <field name="is_printable"/>
                            <field name="is_texturable"/>
                            <field name="is_doublefaced"/>
                            <field name="pierceable_type"/>
                            <!-- Sprint 1.6 (fila 142): independiente de Atravesable -->
                            <field name="is_anadido"/>
                            <field name="max_anadidos" invisible="not is_anadido"/>
                            <field name="is_sesgable"/>
                            <!-- Pendientes 24-sep (10.3): «Tela con franjas»
                                 y «Familia Sheer» son lo mismo — queda solo
                                 Familia Sheer (has_franjas se fusionó). -->
                            <field name="permite_cenefa_entera"/>
                            <field name="permite_bolsillo"/>
                            <field name="peso_gm2"/>
                            <field name="grosor_mm"/>
                            <!-- Sprint 1.6 (fila 167) -->
                            <field name="espacio_util"/>
                            <field name="cant_min_stock"/>
                            <field name="warehouse_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Revisión 17-sep: «Colores» es impreciso — son
                             atributos/variables (perfiles, sesgos, etc.). -->
                        <page string="Atributos / Variables">
                            <!-- Los archivados se muestran en gris para poder
                                 reactivarlos con «Activo». -->
                            <field name="color_todos_ids">
                                <list editable="bottom" decoration-muted="not active">
                                    <!-- Pendientes 24-sep (10.1): lo que se
                                         asocia es el PRODUCTO del maestro. -->
                                    <field name="product_tmpl_id" string="Producto"/>
                                    <!-- Reunión 28-sep (fila 50): la imagen de cada opción
                                         (perfiles, cabezales, motores…) se carga aquí y el
                                         portal la muestra según la presentación del campo. -->
                                    <field name="image" widget="image" options="{'size': [0, 40]}" optional="show"/>
                                    <field name="u_color_id"/>
                                    <field name="etiqueta" optional="show"/>
                                    <field name="archivado_por" optional="show"/>
                                    <field name="system_ids" widget="many2many_tags" optional="show"
                                           options="{'no_create': True}"/>
                                    <!-- Reunión 28-oct (fila 50): telas con las que la línea no sirve. -->
                                    <field name="tela_excluida_ids" widget="many2many_tags" optional="show"
                                           column_invisible="parent.es_tela"
                                           options="{'no_create': True}" placeholder="Sirve con todas"/>
                                    <!-- Reunión 13-oct (filas 56-57): controles —
                                         motores compatibles y canales por línea. -->
                                    <field name="motor_ids" widget="many2many_tags"
                                           column_invisible="not parent.es_control"
                                           options="{'no_create': True}"/>
                                    <field name="canales" column_invisible="not parent.es_control and not parent.es_riel"/>
                                    <!-- Sprint 1.5 (fila 99): rieles — vías y Riel Velcrado. -->
                                    <field name="velcrado" column_invisible="not parent.es_riel"/>
                                    <!-- Sprint 1.2 (pendiente 13-oct): motores — módulo RF y
                                         cargador, antes en el maestro. -->
                                    <field name="requiere_rf" column_invisible="not parent.es_motor"/>
                                    <field name="rf_item_id" column_invisible="not parent.es_motor"
                                           invisible="not requiere_rf" options="{'no_create': True}"/>
                                    <field name="requiere_cargador" column_invisible="not parent.es_motor"/>
                                    <field name="cargador_item_id" column_invisible="not parent.es_motor"
                                           invisible="not requiere_cargador" options="{'no_create': True}"/>
                                    <field name="code" readonly="product_tmpl_id"/>
                                    <field name="name" column_invisible="1"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Campos que la usan" invisible="not field_ids">
                            <field name="field_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="section_id"/>
                                    <field name="display_mode"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Revisión cálculo de tubo (27-oct, punto 1.1): el menú se segmenta
         por categoría (Tela, Tubo, Mecanismo, Soporte, Terminal, Cabezal…). -->
    <record id="view_safra_fabric_search" model="ir.ui.view">
        <field name="name">safra.fabric.search</field>
        <field name="model">safra.fabric</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <group>
                    <filter string="Categoría" name="g_categoria" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_safra_fabric" model="ir.actions.act_window">
        <field name="name">Referencias / Telas</field>
        <field name="res_model">safra.fabric</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_safra_fabric_search"/>
    </record>

    <!-- Punto 16: menú propio para las referencias de categoría Sesgo,
         donde se relacionan los productos que aplican (pestaña Colores). -->
    <record id="action_safra_fabric_sesgo" model="ir.actions.act_window">
        <field name="name">Sesgos</field>
        <field name="res_model">safra.fabric</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('category_id', '=', ref('website_quotes_safra.popt_refcat_sesgo'))]"/>
        <field name="context" eval="{'default_category_id': ref('website_quotes_safra.popt_refcat_sesgo')}"/>
    </record>

    <!-- ======================== SISTEMAS ======================== -->

    <record id="view_safra_system_tree" model="ir.ui.view">
        <field name="name">safra.system.tree</field>
        <field name="model">safra.system</field>
        <field name="arch" type="xml">
            <list string="Sistemas">
                <field name="code"/>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="weight_factor" optional="hide"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_safra_system_form" model="ir.ui.view">
        <field name="name">safra.system.form</field>
        <field name="model">safra.system</field>
        <field name="arch" type="xml">
            <form string="Sistema">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="product_tmpl_id"/>
                            <field name="active"/>
                            <!-- Pendientes 24-sep (1.1): visibilidad del
                                 sistema por grupos de usuarios. -->
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Ficha técnica del portal">
                            <field name="tech_width_min"/>
                            <field name="tech_width_max"/>
                            <field name="tech_height_min"/>
                            <field name="tech_height_max"/>
                            <field name="img_group"/>
                            <field name="weight_factor"/>
                            <field name="tubo_solo_ancho"/>
                            <field name="panel_telo_min" placeholder="General"/>
                            <field name="panel_telo_max" placeholder="General"/>
                            <field name="calculo_corte" required="product_tmpl_id"/>
                            <field name="factor_confeccion"/>
                        </group>
                        <group string="Ficha técnica de exhibición">
                            <field name="exh_width_min" placeholder="Igual a la ficha"/>
                            <field name="exh_width_max" placeholder="Igual a la ficha"/>
                            <field name="exh_height_min" placeholder="Igual a la ficha"/>
                            <field name="exh_height_max" placeholder="Igual a la ficha"/>
                        </group>
                        <!-- Ajustes 20-oct (fila 79) -->
                        <group string="Diseño de impresión: aceptación de la imagen">
                            <field name="diseno_dpi_minimo"/>
                            <field name="diseno_dpi_optimo"/>
                            <field name="diseno_proporcion_max"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Campos del sistema">
                            <field name="mapping_ids" context="{'default_system_id': id}">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="field_id"/>
                                    <field name="label_override" optional="show"/>
                                    <field name="required"/>
                                    <field name="depends_field_id" optional="hide"/>
                                    <field name="depends_value" optional="hide"/>
                                    <field name="active"/>
                                    <field name="option_count" optional="show"/>
                                    <button name="action_open_opciones" type="object" string="Opciones"
                                            icon="fa-list-ul" title="Ver las opciones de este campo en este sistema"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_safra_system" model="ir.actions.act_window">
        <field name="name">Sistemas</field>
        <field name="res_model">safra.system</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ======================== COTIZACIONES ======================== -->

    <record id="view_safra_quote_tree" model="ir.ui.view">
        <field name="name">safra.quote.tree</field>
        <field name="model">safra.quote</field>
        <field name="arch" type="xml">
            <list string="Cotizaciones Safra" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-muted="state == 'cancelled'" decoration-warning="state == 'blocked'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="date"/>
                <field name="orden_compra" optional="show"/>
                <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="safra_express" optional="show"/>
                <field name="es_exportacion" optional="show"/>
                <field name="es_proyecto_especial" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancelled'" decoration-warning="state == 'blocked'"/>
                <field name="borrador_portal" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_safra_quote_form" model="ir.ui.view">
        <field name="name">safra.quote.form</field>
        <field name="model">safra.quote</field>
        <field name="arch" type="xml">
            <form string="Cotización Safra">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"
                            invisible="state not in ('draft', 'design_approved', 'production_approved') or borrador_portal"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state not in ('draft', 'blocked', 'pending_production', 'pending_design', 'design_approved', 'production_approved', 'confirmed')"/>
                    <button name="action_draft" string="Restablecer borrador" type="object" invisible="state not in ('cancelled', 'blocked')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,pending_design,design_approved,confirmed"/>
                    <!-- Reunión 15-oct (fila 74): los estados de producción se
                         ven en la barra solo cuando la cotización pasa por ellos. -->
                </header>
                <sheet>
                    <!-- Revisión 27-oct: borrador del portal sin finalizar -->
                    <div class="alert alert-warning" role="alert" invisible="not borrador_portal">
                        <strong>Borrador sin finalizar:</strong> el cliente la guardó desde el portal y no ha pulsado
                        «Finalizar pedido». No se confirma ni abre tickets hasta que la finalice.
                        <field name="borrador_portal" invisible="1"/>
                        <field name="borrador_errores" class="d-block mt-1" style="white-space: pre-line"
                               invisible="not borrador_errores"/>
                    </div>
                    <!-- Mejoras Sprint 1.1 (21-oct, fila 2) -->
                    <div class="alert alert-warning" role="alert" invisible="state != 'blocked'">
                        <strong>Cotización bloqueada:</strong> ya no cumple las condiciones para confirmarse.
                        El cliente la corrige editándola desde el portal.
                        <field name="bloqueo_motivos" class="d-block mt-1" style="white-space: pre-line"/>
                    </div>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_design_tickets" type="object"
                                class="oe_stat_button" icon="fa-paint-brush"
                                invisible="design_ticket_count == 0">
                            <field name="design_ticket_count" widget="statinfo" string="Tickets"/>
                        </button>
                        <!-- Prueba 126.1: pedido de venta de la cotización confirmada -->
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button" icon="fa-dollar"
                                invisible="not sale_order_id" groups="sales_team.group_sale_salesman">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Pedido de venta</span>
                                <field name="sale_order_id" readonly="1" class="o_stat_value"/>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <!-- Ajustes Sprint 1.6 (26-oct, filas 182 y 127) -->
                            <field name="orden_compra"/>
                            <field name="embalaje_ids" widget="many2many_tags"
                                   domain="[('fabric_id.category_id.name', '=ilike', 'embalaje'), ('product_tmpl_id', '!=', False)]"
                                   options="{'no_create': True}"/>
                        </group>
                        <!-- Datos de despacho (filas 184-188) -->
                        <group string="Datos de despacho" name="despacho">
                            <field name="recoge_fabrica"/>
                            <field name="despacho_country_id" invisible="recoge_fabrica"/>
                            <field name="despacho_city_id" invisible="recoge_fabrica" options="{'no_create': True}"/>
                            <field name="despacho_direccion" invisible="recoge_fabrica"/>
                            <field name="despacho_destinatario" invisible="recoge_fabrica"/>
                            <field name="despacho_fecha" options="{'min_date': 'today'}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="safra_express"/>
                            <!-- Sprint 1.6 (filas 126 y 128) -->
                            <field name="es_exportacion"/>
                            <field name="es_proyecto_especial"/>
                            <field name="requiere_verificacion"/>
                            <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Verificación de fabricación" invisible="not requiere_verificacion">
                        <field name="verificacion_observaciones"/>
                        <field name="verificacion_detalle" invisible="not verificacion_detalle"/>
                        <field name="verificacion_ticket_id"/>
                        <field name="verificacion_aprobada" readonly="1"/>
                        <!-- Reunión 09-nov (fila 74): aceptación del cliente y garantía que indica planta -->
                        <field name="verificacion_acepta_sin_garantia"/>
                        <field name="verificacion_garantia" invisible="not verificacion_garantia"/>
                        <field name="verificacion_garantia_motivo" invisible="not verificacion_garantia_motivo"/>
                        <!-- Fila 130 -->
                        <field name="verificacion_rechazada" invisible="not verificacion_rechazada"/>
                        <field name="verificacion_rechazo_motivo" invisible="not verificacion_rechazada"/>
                    </group>
                    <notebook>
                        <page string="Persianas">
                            <field name="line_ids">
                                <list optional="show">
                                    <field name="sequence" widget="handle"/>
                                    <field name="system_id"/>
                                    <field name="fabric_id"/>
                                    <field name="color_id"/>
                                    <field name="width"/>
                                    <field name="height"/>
                                    <field name="quantity"/>
                                    <field name="location"/>
                                    <field name="lote_sugerido_id" optional="show"/>
                                    <field name="has_motor"/>
                                    <field name="cenefa_type"/>
                                    <field name="safra_express" readonly="1"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                                <form string="Persiana">
                                    <group>
                                        <group string="Datos Básicos">
                                            <field name="system_id"/>
                                            <field name="sequence_name"/>
                                            <field name="exhibition"/>
                                            <field name="same_header"/>
                                            <field name="soporte_izq" invisible="not same_header"/>
                                            <field name="soporte_der" invisible="not same_header"/>
                                        </group>
                                        <group string="Dimensiones">
                                            <field name="width"/>
                                            <field name="height"/>
                                            <field name="quantity"/>
                                            <field name="location"/>
                                            <field name="lote_sugerido_id"/>
                                            <field name="aligned"/>
                                        </group>
                                    </group>
                                    <group>
                                        <group string="Tela">
                                            <field name="fabric_id"/>
                                            <field name="color_id"/>
                                            <field name="fabric_id_2"/>
                                            <field name="color_id_2" invisible="not fabric_id_2"/>
                                            <field name="fabric_id_3" invisible="not fabric_id_2"/>
                                            <field name="color_id_3" invisible="not fabric_id_3"/>
                                            <field name="fabric_id_4" invisible="not fabric_id_3"/>
                                            <field name="color_id_4" invisible="not fabric_id_4"/>
                                            <field name="fabric_id_5" invisible="not fabric_id_4"/>
                                            <field name="color_id_5" invisible="not fabric_id_5"/>
                                            <field name="tela_al_reves"/>
                                            <field name="atravesar_tela"/>
                                            <field name="coordinado"/>
                                        </group>
                                        <group string="Accesorios">
                                            <field name="orientation"/>
                                            <field name="mando_position"/>
                                            <field name="enclosed"/>
                                            <field name="escuadras"/>
                                            <field name="bolsillo_size"/>
                                            <field name="extra_chain"/>
                                            <field name="safra_express" readonly="1"/>
                                        </group>
                                    </group>
                                    <group>
                                        <group string="Motor" invisible="not has_motor">
                                            <field name="motor"/>
                                            <field name="interruptor_rf"/>
                                            <field name="motor_support_type"/>
                                            <field name="control"/>
                                            <field name="control_channel"/>
                                            <field name="requires_charger"/>
                                        </group>
                                        <group string="Activar Motor">
                                            <field name="has_motor"/>
                                        </group>
                                    </group>
                                    <group>
                                        <group string="Cenefa">
                                            <field name="cenefa_type"/>
                                            <field name="cenefa_lateral" invisible="cenefa_type == 'sin'"/>
                                            <field name="cenefa_lined" invisible="cenefa_type == 'sin'"/>
                                            <field name="cenefa_tela" invisible="cenefa_type != 'tela'"/>
                                            <field name="cenefa_corte" invisible="cenefa_type != 'tela'"/>
                                        </group>
                                        <group string="Cover Light">
                                            <field name="cover_light_profile"/>
                                            <field name="coverlight_felpa" invisible="cover_light_profile == 'sin'"/>
                                            <field name="coverlight_45" invisible="cover_light_profile == 'sin'"/>
                                        </group>
                                    </group>
                                    <group string="Diseño de Impresión">
                                        <field name="design_print"/>
                                        <field name="custom_design"/>
                                        <field name="design_exterior"/>
                                        <field name="print_m2"/>
                                    </group>
                                    <group string="Diseño personalizado" invisible="not design_print and not custom_design">
                                        <field name="design_image" widget="image" options="{'size': [0, 160]}"/>
                                        <field name="design_filename"/>
                                        <field name="design_comment"/>
                                        <field name="design_analysis"/>
                                        <field name="design_ticket_id"/>
                                        <field name="design_m2_cobro"/>
                                        <field name="design_approved"/>
                                        <!-- Ajustes 20-oct (fila 79) -->
                                        <field name="design_final_filename" invisible="1"/>
                                        <field name="design_final_file" filename="design_final_filename"/>
                                    </group>
                                    <!-- Reunión 15-oct (fila 74) -->
                                    <group string="Pedido sin restricciones" invisible="not sin_restricciones">
                                        <field name="sin_restricciones"/>
                                        <field name="sin_restricciones_detalle"/>
                                        <field name="production_ticket_id"/>
                                        <field name="sin_restricciones_aprobado"/>
                                    </group>
                                    <group string="Atributos del portal" invisible="not attributes_display">
                                        <field name="attributes_display" nolabel="1" colspan="2"/>
                                    </group>
                                    <group string="Precio">
                                        <field name="price_unit"/>
                                        <field name="price_total"/>
                                    </group>
                                    <field name="description" placeholder="Comentarios…"/>
                                </form>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="note" placeholder="Notas internas…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_safra_quote_search" model="ir.ui.view">
        <field name="name">safra.quote.search</field>
        <field name="model">safra.quote</field>
        <field name="arch" type="xml">
            <search string="Buscar cotizaciones">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="orden_compra"/>
                <filter string="Borrador" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Sin finalizar (borrador del portal)" name="borrador_portal" domain="[('borrador_portal','=',True)]"/>
                <filter string="Confirmadas" name="confirmed" domain="[('state','=','confirmed')]"/>
                <separator/>
                <filter string="Mis cotizaciones" name="my_quotes" domain="[('user_id','=',uid)]"/>
                <separator/>
                <!-- Sprint 1.6 (filas 126-128) -->
                <filter string="Safra Express" name="safra_express" domain="[('safra_express','=',True)]"/>
                <filter string="Exportación" name="es_exportacion" domain="[('es_exportacion','=',True)]"/>
                <filter string="Requiere verificación" name="requiere_verificacion" domain="[('requiere_verificacion','=',True)]"/>
                <filter string="Proyectos especiales" name="es_proyecto_especial" domain="[('es_proyecto_especial','=',True)]"/>
                <group>
                    <filter string="Cliente" name="partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="state_group" context="{'group_by': 'state'}"/>
                    <filter string="Fecha" name="date_group" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_safra_quote" model="ir.actions.act_window">
        <field name="name">Cotizaciones Safra</field>
        <field name="res_model">safra.quote</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_quotes': 1}</field>
    </record>

    <!-- Sprint 1.6 (fila 127): informe de las persianas que salieron con
         Safra Express (por sistema, cliente o mes). -->
    <record id="view_safra_quote_line_express_list" model="ir.ui.view">
        <field name="name">safra.quote.line.express.list</field>
        <field name="model">safra.quote.line</field>
        <field name="arch" type="xml">
            <list string="Persianas con Safra Express" create="0" edit="0">
                <field name="quote_id"/>
                <field name="quote_partner_id"/>
                <field name="quote_date"/>
                <field name="quote_state" widget="badge"/>
                <field name="system_id"/>
                <field name="fabric_id"/>
                <field name="color_id"/>
                <field name="width"/>
                <field name="height"/>
                <field name="quantity" sum="Total"/>
                <field name="price_total" sum="Total"/>
            </list>
        </field>
    </record>
    <record id="view_safra_quote_line_express_search" model="ir.ui.view">
        <field name="name">safra.quote.line.express.search</field>
        <field name="model">safra.quote.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="quote_id"/>
                <field name="system_id"/>
                <field name="fabric_id"/>
                <filter string="Safra Express" name="safra_express" domain="[('safra_express','=',True)]"/>
                <filter string="Confirmadas" name="confirmadas" domain="[('quote_state','=','confirmed')]"/>
                <group>
                    <filter string="Sistema" name="g_system" context="{'group_by': 'system_id'}"/>
                    <filter string="Referencia" name="g_fabric" context="{'group_by': 'fabric_id'}"/>
                    <filter string="Cliente" name="g_partner" context="{'group_by': 'quote_partner_id'}"/>
                    <filter string="Mes" name="g_mes" context="{'group_by': 'quote_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_safra_quote_line_express" model="ir.actions.act_window">
        <field name="name">Persianas con Safra Express</field>
        <field name="res_model">safra.quote.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="view_safra_quote_line_express_list"/>
        <field name="search_view_id" ref="view_safra_quote_line_express_search"/>
        <field name="context">{'search_default_safra_express': 1, 'search_default_g_system': 1}</field>
    </record>

    <!-- ======================== MENÚ ======================== -->

    <menuitem id="menu_safra_root" name="Cotizador Safra" sequence="90"
              web_icon="website_quotes_safra,static/description/icon.png"/>
    <menuitem id="menu_safra_quotes" name="Cotizaciones" parent="menu_safra_root" action="action_safra_quote" sequence="10"/>
    <menuitem id="menu_safra_quote_line_express" name="Persianas con Safra Express" parent="menu_safra_root"
              action="action_safra_quote_line_express" sequence="15"/>
    <menuitem id="menu_safra_fabrics" name="Referencias / Telas" parent="menu_safra_root" action="action_safra_fabric" sequence="20"/>
    <menuitem id="menu_safra_fabric_sesgos" name="Sesgos" parent="menu_safra_root" action="action_safra_fabric_sesgo" sequence="25"/>
    <menuitem id="menu_safra_systems" name="Sistemas" parent="menu_safra_root" action="action_safra_system" sequence="30"/>


    <!-- ======================== CATÁLOGO DE COLORES (U_color) ======================== -->

    <record id="view_safra_color_tree" model="ir.ui.view">
        <field name="name">safra.color.tree</field>
        <field name="model">safra.color</field>
        <field name="arch" type="xml">
            <list string="Colores" editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_safra_color" model="ir.actions.act_window">
        <field name="name">Colores (U_color)</field>
        <field name="res_model">safra.color</field>
        <field name="view_mode">list</field>
    </record>

    <!-- El menú Colores (U_color) vive bajo Configuración: se declara en
         safra_field_views.xml (donde ya existe menu_safra_config). -->

    <!-- Pendiente 4 (Safra, 5-oct): revalidar cotizaciones elegidas y
         anular las que, sin confirmar, ya no cumplen. -->
    <record id="action_safra_quote_revisar_vigencia" model="ir.actions.server">
        <field name="name">Revisar vigencia (anular las que ya no cumplen)</field>
        <field name="model_id" ref="model_safra_quote"/>
        <field name="binding_model_id" ref="model_safra_quote"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_revisar_vigencia()</field>
    </record>
</odoo>
