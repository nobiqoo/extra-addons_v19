<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="account_account_form_third" model="ir.ui.view">
            <field name="name">account.account.form.third</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='accounting']//field[@name='active']" position="after">
                    <field name="tercero" invisible="0"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
