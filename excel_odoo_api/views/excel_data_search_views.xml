<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="excel_data_search_form_view" model="ir.ui.view">
            <field name="name">excel.data.search.form.view</field>
            <field name="model">excel.data.search</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="access_key_assign" string="Update key" type="object" class="oe_link"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="query_type"/>
                                <field name="type_out" widget="selection_badge"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="access_key" invisible="0" readonly="1"/>
                                <field name="description" placeholder="Short description"/>
                            </group>
                            <field name="url" nolabel="0" widget="CopyClipboardChar"/>
                        </group>
                        <group string="Query">
                            <field name="query" nolabel="0" string="SELECT ..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="excel_data_search_tree_view" model="ir.ui.view">
            <field name="name">excel.data.search.tree.view</field>
            <field name="model">excel.data.search</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description" placeholder="Short description"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="excel_data_search_search_view" model="ir.ui.view">
            <field name="name">excel.data.search.search.view</field>
            <field name="model">excel.data.search</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="excel_data_search_action" model="ir.actions.act_window">
            <field name="name">Table generator for excel</field>
            <field name="res_model">excel.data.search</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="excel_data_search_menu" 
            name="Table generator for excel"
            parent="base.next_id_9"
            action="excel_data_search_action"
            sequence="20"
        />

    </data>
</odoo>