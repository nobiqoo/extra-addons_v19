<odoo>
    <record id="action_biometric_user_mapping_view" model="ir.actions.act_window">
        <field name="name">Análisis de Mapeo Biométrico</field>
        <field name="res_model">biometric.user.mapping</field>
        <field name="view_mode">list</field>
        <field name="target">current</field>
        <field name="context">{'search_default_group_status': 1, 'group_by': 'status'}</field>
    </record>

    <record id="view_biometric_user_mapping_tree" model="ir.ui.view">
        <field name="name">biometric.user.mapping.tree</field>
        <field name="model">biometric.user.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="1"
                  default_order="cast_pin asc"
                  decoration-danger="status == 'unmapped'"
                  decoration-success="status == 'mapped'">
                <header>
                    <button name="action_create_all_unmapped_employees"
                            string="Crear Empleados para No Mapeados"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_auto_map_by_biometric_id"
                            string="Auto-Vincular por ID Biométrico"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_refresh_device_users"
                            string="Refrescar desde Reloj"
                            type="object"
                            icon="fa-refresh"
                            class="btn-outline-primary"/>
                </header>
                <field name="cast_pin" column_invisible="1"/>
                <field name="device_user_id" string="ID Biométrico" readonly="1"/>
                <field name="device_user_name" string="Nombre en Biométrico" readonly="1"/>
                <field name="employee_id" string="Empleado de Odoo" options="{'no_create': True}"/>
                <field name="status" string="Estado" readonly="1" widget="badge"
                       decoration-success="status == 'mapped'"
                       decoration-danger="status == 'unmapped'"/>
                <field name="device_id" column_invisible="1"/>
                <button name="action_create_employee"
                        string="Crear Empleado"
                        type="object"
                        icon="fa-user-plus"
                        class="btn-primary btn-sm"
                        invisible="status == 'mapped'"/>
                <button name="action_delete_user_from_device"
                        string="Eliminar"
                        type="object"
                        icon="fa-trash"
                        class="btn-danger btn-sm"
                        confirm="¿Está seguro de que desea eliminar permanentemente este usuario del dispositivo biométrico?"/>
            </list>
        </field>
    </record>

    <record id="view_biometric_user_mapping_search" model="ir.ui.view">
        <field name="name">biometric.user.mapping.search</field>
        <field name="model">biometric.user.mapping</field>
        <field name="arch" type="xml">
            <search string="Buscar Mapeo Biométrico">
                <field name="device_user_id" string="ID Biométrico"/>
                <field name="device_user_name" string="Nombre en Biométrico"/>
                <field name="employee_id" string="Empleado"/>
                <filter name="filter_unmapped" string="Sin Mapear" domain="[('status', '=', 'unmapped')]"/>
                <filter name="filter_mapped" string="Mapeados" domain="[('status', '=', 'mapped')]"/>
                <group>
                    <filter name="group_status" string="Estado" context="{'group_by': 'status'}"/>
                    <filter name="group_device" string="Dispositivo" context="{'group_by': 'device_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
