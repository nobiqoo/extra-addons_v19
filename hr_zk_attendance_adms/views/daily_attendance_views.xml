<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="daily_attendance_tree" model="ir.ui.view">
    <field name="name">daily.attendance.tree</field>
    <field name="model">daily.attendance</field>
    <field name="arch" type="xml">
      <list string="Attendance Analysis">
        <field name="punching_day"/>
        <field name="device_id_num" string="Biometric ID"/>
        <field name="employee_id"/>
        <field name="check_in"/>
        <field name="check_out"/>
        <field name="punch_count" string="# Punches"/>
        <field name="ignored_count" string="Ignored"/>
        <field name="ignored_punches" string="Ignored Punches"/>
        <field name="is_danger" widget="boolean_toggle"/>
        <field name="address_id"/>
      </list>
    </field>
  </record>

  <record id="daily_attendance_action" model="ir.actions.act_window">
    <field name="name">Attendance Analysis</field>
    <field name="res_model">daily.attendance</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
