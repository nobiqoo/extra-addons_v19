<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_biometric_raw_punch_tree" model="ir.ui.view">
        <field name="name">biometric.raw.punch.tree</field>
        <field name="model">biometric.raw.punch</field>
        <field name="arch" type="xml">
            <list string="Marcaciones en Crudo">
                <field name="user_id"/>
                <field name="biometric_id"/>
                <field name="punch_time"/>
                <field name="punch_time_display" string="Hora Local (Fija)"/>
                <field name="device_id"/>
                <field name="source"/>
            </list>
        </field>
    </record>

    <record id="view_biometric_raw_punch_form" model="ir.ui.view">
        <field name="name">biometric.raw.punch.form</field>
        <field name="model">biometric.raw.punch</field>
        <field name="arch" type="xml">
            <form string="Marcación en Crudo">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="biometric_id"/>
                        <field name="punch_time"/>
                        <field name="punch_time_display" string="Hora Local (Fija)"/>
                        <field name="device_id"/>
                        <field name="source"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_biometric_raw_punch" model="ir.actions.act_window">
        <field name="name">Marcaciones en Crudo</field>
        <field name="res_model">biometric.raw.punch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
