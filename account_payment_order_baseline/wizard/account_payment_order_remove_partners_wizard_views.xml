<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_order_remove_partners_wizard_form" model="ir.ui.view">
        <field name="name">account.payment.order.remove.partners.wizard.form</field>
        <field name="model">account.payment.order.remove.partners.wizard</field>
        <field name="arch" type="xml">
            <form string="Retirar proveedores">
                <group>
                    <field name="order_id" />
                    <field name="available_partner_ids" invisible="1" />
                    <field name="partner_ids" widget="many2many_tags" options="{'no_create': True}" />
                </group>
                <footer>
                    <button
                        name="action_remove_partners"
                        type="object"
                        string="Retirar"
                        class="btn-primary"
                        confirm="Se retirarán todas las líneas de pago asociadas a los proveedores seleccionados. ¿Desea continuar?"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_payment_order_remove_partners_wizard" model="ir.actions.act_window">
        <field name="name">Retirar proveedores</field>
        <field name="res_model">account.payment.order.remove.partners.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_account_payment_order_remove_partners_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
