<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="print_account_payment_order_simple_document">
        <t
            t-set="doc"
            t-value="doc.with_context({'lang': doc.order_id.generated_user_id and doc.order_id.generated_user_id.lang or doc.partner_id.lang})"
        />
        <t t-call="web.external_layout">
            <div class="page">
                <div class="oe_structure" id="oe_structure_1" />
                <div class="row">
                    <div class="col-4 offset-8">
                        <div t-field="doc.order_id.journal_id.bank_id.name" />
                        <div t-field="doc.order_id.journal_id.bank_id.street" />
                        <div t-field="doc.order_id.journal_id.bank_id.street2" />
                        <div t-field="doc.order_id.journal_id.bank_id.zip" />
                        <div t-field="doc.order_id.journal_id.bank_id.city" />
                        <div t-field="doc.order_id.journal_id.bank_id.state.name" />
                        <div t-field="doc.order_id.journal_id.bank_id.country.name" />
                    </div>
                </div>
                <t t-if="doc.order_id.payment_type == 'inbound'">
                    <h2>Debit Order</h2>
                </t>
                <t t-else="">
                    <h2>Payment Order</h2>
                </t>
                <div class="row mb-4" id="informations">
                    <div t-if="doc.order_id.payment_mode_id.name" class="col">
                        <strong>Payment Type:</strong>
                        <p t-field="doc.order_id.payment_mode_id.name" />
                    </div>
                    <div t-if="doc.order_id.name" class="col">
                        <strong>Reference</strong>
                        <p t-field="doc.order_id.name" />
                    </div>
                    <div t-if="doc.order_id.company_partner_bank_id.bank_id.id" class="col">
                        <strong>Used Account:</strong>
                        <p>
                            <span
                                t-esc="doc.get_bank_account_name(doc.order_id.company_partner_bank_id)"
                            />
                        </p>
                    </div>
                    <div t-if="doc.order_id.get_date_scheduled()" class="col">
                        <strong>Execution:</strong>
                        <p t-esc="doc.order_id.get_date_scheduled()"/>
                    </div>
                    <div t-if="doc.company_id.currency_id.name" class="col">
                        <strong>Company Currency:</strong>
                        <p t-field="doc.order_id.company_id.currency_id.name" />
                    </div>
                </div>
                <table class="o_has_total_table table o_main_table table-borderless">
                    <thead>
                        <tr>
                            <th>Partner</th>
                            <th class="text-center">Bank Account</th>
                            <th class="text-center">Invoice Ref</th>
                            <th class="text-center">Value Date</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Currency</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Total amount on lines
                            see _get_amount_total v8
                        -->
                        <t t-set="total_amount" t-value="0" />
                        <tr t-foreach="doc" t-as="line">
                            <!-- compute total amount -->
                            <t
                                t-set="total_amount"
                                t-value="total_amount+line.amount_currency"
                            />
                            <td>
                                <span t-field="line.partner_id.name" />
                            </td>
                            <td class="text-center">
                                <span
                                    t-esc="line.get_bank_account_name(line.partner_bank_id)"
                                />
                            </td>
                            <td class="text-center">
                                <t
                                    t-if="line.move_line_id.move_id and 'in_' in line.move_line_id.move_id.move_type"
                                >
                                    <span
                                        t-esc="line.move_line_id.move_id.ref or line.move_line_id.move_id.payment_reference"
                                    />
                                </t>
                                <t t-else="">
                                    <span t-esc="line.move_line_id.move_id.name" />
                                </t>
                            </td>
                            <td class="text-center">
                                <span t-field="line.date" />
                            </td>
                            <td class="text-end">
                                <span t-field="line.amount_currency" />
                            </td>
                            <td class="text-end">
                                <span t-field="line.amount_company_currency" />
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row mt-n3" name="total">
                        <div
                            t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto"
                        >
                            <table class="o_total_table table table-borderless">
                                <tr class="o_total">
                                    <td>
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-end">
                                        <strong
                                            t-esc="total_amount"
                                            t-options="{'widget': 'monetary', 'display_currency': doc.order_id.company_currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Total (Currency)</td>
                                    <td class="text-end">
                                        <span t-field="doc.amount_currency" />
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="oe_structure" id="oe_structure_2" />
            </div>
        </t>
    </template>
    <template id="print_account_payment_order_simple_main">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t
                    t-call="account_payment_order_baseline.print_account_payment_order_simple_document"
                    t-lang="doc.order_id.generated_user_id.lang  or doc.partner_id.lang"
                />
            </t>
        </t>
    </template>

</odoo>