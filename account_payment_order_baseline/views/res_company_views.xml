<odoo>

    <record id="res_company_policies_view_form" model="ir.ui.view">
        <field name="name">res_company_policies</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="account_baseline.res_company_policies_view_form" />
        <field name="arch" type="xml">
            <!-- La pestaña Políticas la crea account_baseline -->
            <xpath expr="//field[@name='hide_credit_note_fully_credited']" position="before">
                <field name="payments_from_the_journal"/>
                <field name="charges_from_the_journal"/>
            </xpath>
        </field>
    </record>

</odoo>
