<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_sale_multiseller" model="ir.ui.view">
        <field name="name">sale.order.form.sale.multiseller</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sales_person']/field[@name='user_id']" position="before">
                <field name="allowed_user_ids" invisible="1"/>
            </xpath>
            <xpath expr="//group[@name='sales_person']/field[@name='user_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_user_ids)]</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
