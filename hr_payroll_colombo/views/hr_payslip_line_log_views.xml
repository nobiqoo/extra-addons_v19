<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="hr_payslip_line_log_form_teacher" model="ir.ui.view">
            <field name="name">hr.payslip.line.log.form.inherit.hr.payroll.colombo</field>
            <field name="model">hr.payslip.line.log</field>
            <field name="inherit_id" ref="hr_payroll_co.hr_payslip_line_log_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='total_base']" position="after">
                    <field name="days_base" readonly="1"
                        invisible="not days_base" />
                </xpath>
            </field>
        </record>

        <record id="hr_payslip_line_log_tree_teacher" model="ir.ui.view">
            <field name="name">hr.payslip.line.log.list.inherit.hr.payroll.colombo</field>
            <field name="model">hr.payslip.line.log</field>
            <field name="inherit_id" ref="hr_payroll_co.hr_payslip_line_log_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='total_base']" position="after">
                    <field name="days_base" optional="hidden" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>
