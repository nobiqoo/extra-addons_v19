<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="hr_contract_form_teacher" model="ir.ui.view">
            <field name="name">hr.contract.form.inherit.hr.payroll.colombo</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_payroll_co.hr_contract_form" />
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='information']" position="after">
                    <page string="Tipo de Empleado" name="employee_category">
                        <group>
                            <group name="employee_category_left"
                                string="Naturaleza del Contrato">
                                <field name="employee_category" />
                                <field name="teacher_subtype"
                                    invisible="employee_category != 'teacher'"
                                    required="employee_category == 'teacher'" />
                                <field name="special_benefits_calculation"
                                    readonly="1" />
                                <field name="benefits_days_base" readonly="1" />
                            </group>
                            <group name="employee_category_right"
                                string="Valor Hora"
                                invisible="employee_category != 'teacher'">
                                <field name="hour_value" readonly="1"
                                    widget="monetary"
                                    options="{'currency_field': 'currency_id'}" />
                            </group>
                        </group>
                        <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small"
                            style="font-size: larger;"
                            invisible="employee_category != 'teacher'">Histórico de Valor Hora</div>
                        <field name="hour_value_history_ids" nolabel="1"
                            invisible="employee_category != 'teacher'">
                            <list editable="bottom">
                                <field name="date" />
                                <field name="hour_value" />
                                <field name="user_id" />
                            </list>
                        </field>
                    </page>
                    <page string="Histórico de horas" name="teacher_hours_history"
                        invisible="employee_category != 'teacher'"
                        groups="hr_payroll_co.user_payslip,hr_payroll_co.manager_payslip,hr_attendance.group_hr_attendance_manager">
                        <field name="teacher_hour_line_ids" nolabel="1">
                            <list create="0" delete="0" edit="0"
                                default_order="date desc, school_class_id"
                                decoration-success="payroll_state == 'paid'"
                                decoration-muted="payroll_state == 'pending' and state == 'draft'">
                                <field name="date" string="Periodo" />
                                <field name="school_class_id" />
                                <field name="hours" sum="Total" />
                                <field name="analytic_account_id" />
                                <field name="hour_value" />
                                <field name="subtotal" sum="Total" />
                                <field name="percentage" optional="hide" />
                                <field name="novelty_id" optional="show" />
                                <field name="state" column_invisible="1" />
                                <field name="currency_id" column_invisible="1" />
                                <field name="payroll_state" widget="badge"
                                    decoration-success="payroll_state == 'paid'"
                                    decoration-warning="payroll_state == 'pending'" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
