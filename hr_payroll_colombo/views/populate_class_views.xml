<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="wk_school_class_form_teacher_payroll" model="ir.ui.view">
            <field name="name">wk.school.class.form.inherit.hr.payroll.colombo</field>
            <field name="model">wk.school.class</field>
            <field name="inherit_id" ref="wk_school_management.wk_school_class_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_attendances" type="object"
                        icon="fa-clock-o" class="oe_stat_button">
                        <div class="o_stat_info">
                            <span class="o_stat_value">
                                <field name="attendance_count" />
                            </span>
                            <span class="o_stat_text">Asistencias</span>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='teacher_id']" position="after">
                    <field name="analytic_account_id"
                        options="{'no_create_edit': True, 'no_create': True}" />
                    <field name="payroll_hours_total" widget="float_time"
                        readonly="1" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>
