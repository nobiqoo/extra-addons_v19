<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_classification_view_form" model="ir.ui.view">
        <field name="name">product.classification.view.form</field>
        <field name="model">product.classification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group colspan="2">
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_classification_view_tree" model="ir.ui.view">
        <field name="name">product.classification.view.tree</field>
        <field name="model">product.classification</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_product_classification">
        <field name="name">Clasificación</field>
        <field name="res_model">product.classification</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva clasificación
            </p>
        </field>
    </record>

    <menuitem
        parent="stock.menu_product_in_config_stock"
        sequence="100"
        id="menu_product_classification"
        action="action_product_classification"/>
</odoo>