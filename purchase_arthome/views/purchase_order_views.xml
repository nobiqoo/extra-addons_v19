<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_purchase_category" model="ir.ui.view">
        <field name="name">purchase.order.form.purchase.category</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="purchase_category"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_kpis_tree_purchase_category" model="ir.ui.view">
        <field name="name">purchase.order.kpis.list.purchase.category</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="purchase_category" optional="show" widget="badge" width="130px" decoration-info="purchase_category == 'import'" decoration-warning="purchase_category == 'dropship'"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_tree_purchase_category" model="ir.ui.view">
        <field name="name">purchase.order.view.list.purchase.category</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="purchase_category" optional="show" widget="badge" width="130px" decoration-info="purchase_category == 'import'" decoration-warning="purchase_category == 'dropship'"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_tree_purchase_category" model="ir.ui.view">
        <field name="name">purchase.order.list.purchase.category</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="purchase_category" optional="show" widget="badge" width="130px" decoration-info="purchase_category == 'import'" decoration-warning="purchase_category == 'dropship'"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_filter_purchase_category" model="ir.ui.view">
        <field name="name">request.quotation.select.purchase.category</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_exception']" position="before">
                <filter name="purchase_category_import" string="Is Import" domain="[('purchase_category', '=', 'import')]"/>
                <filter name="purchase_category_dropship" string="Is Dropship" domain="[('purchase_category', '=', 'dropship')]"/>
                <filter name="purchase_category_national" string="Is National" domain="[('purchase_category', '=', 'national')]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='representative']" position="after">
                <filter string="Purchase Type" name="group_purchase_category" domain="[]" context="{'group_by': 'purchase_category'}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_search_purchase_category" model="ir.ui.view">
        <field name="name">purchase.order.select.purchase.category</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_exception']" position="before">
                <filter name="purchase_category_import" string="Is Import" domain="[('purchase_category', '=', 'import')]"/>
                <filter name="purchase_category_dropship" string="Is Dropship" domain="[('purchase_category', '=', 'dropship')]"/>
                <filter name="purchase_category_national" string="Is National" domain="[('purchase_category', '=', 'national')]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='representative']" position="after">
                <filter string="Purchase Type" name="group_purchase_category" domain="[]" context="{'group_by': 'purchase_category'}"/>
            </xpath>
        </field>
    </record>
</odoo>
