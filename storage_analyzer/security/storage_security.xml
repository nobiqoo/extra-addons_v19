<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Grupos de seguridad -->
    <!-- TODO cambiar la categoría de los grupos por una independiente -->
    <record model="ir.module.category" id="module_category_storage_analyzer">
        <field name="name">Almacenamiento</field>
        <field name="parent_id" eval="False"/>
        <field name="sequence">60</field>
    </record>

    <record id="privilege_storage_analyzer" model="res.groups.privilege">
        <field name="name">Almacenamiento</field>
        <field name="category_id" ref="storage_analyzer.module_category_storage_analyzer"/>
    </record>

    <record id="group_storage_analyzer_user" model="res.groups">
        <field name="name">Usuario de Análisis de Almacenamiento</field>
        <field name="privilege_id" ref="storage_analyzer.privilege_storage_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_storage_analyzer_manager" model="res.groups">
        <field name="name">Administrador de Análisis de Almacenamiento</field>
        <field name="privilege_id" ref="storage_analyzer.privilege_storage_analyzer"/>
        <field name="implied_ids" eval="[(4, ref('group_storage_analyzer_user'))]"/>
    </record>

    <!-- Regla: Usuarios ven todos los análisis -->
    <record id="rule_storage_analysis_all" model="ir.rule">
        <field name="name">Todos los análisis de almacenamiento</field>
        <field name="model_id" ref="model_storage_analysis"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_storage_analyzer_user'))]"/>
    </record>

    <record id="rule_storage_analysis_table_all" model="ir.rule">
        <field name="name">Todas las líneas de análisis</field>
        <field name="model_id" ref="model_storage_analysis_table"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_storage_analyzer_user'))]"/>
    </record>

    <record id="rule_storage_analysis_attachment_all" model="ir.rule">
        <field name="name">Todos los detalles de adjuntos</field>
        <field name="model_id" ref="model_storage_analysis_attachment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_storage_analyzer_user'))]"/>
    </record>

    <record id="rule_storage_analysis_trend_all" model="ir.rule">
        <field name="name">Todas las tendencias</field>
        <field name="model_id" ref="model_storage_analysis_trend"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_storage_analyzer_user'))]"/>
    </record>

    <record id="rule_storage_analysis_model_filetype_all" model="ir.rule">
        <field name="name">Todos los desgloses de modelo y tipo de archivo</field>
        <field name="model_id" ref="model_storage_analysis_model_filetype"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_storage_analyzer_user'))]"/>
    </record>
</odoo>