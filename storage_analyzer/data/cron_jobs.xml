<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Cron job para análisis diario automático -->
    <record id="cron_daily_storage_analysis" model="ir.cron">
        <field name="name">Storage Analyzer: Análisis Diario Automático</field>
        <field name="model_id" ref="model_storage_analysis"/>
        <field name="state">code</field>
        <field name="code">model.cron_daily_analysis()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>