<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <t t-name="account_reports.AccountReportFiltersCustomizable" t-inherit="account_reports.AccountReportFiltersCustomizable" t-inherit-mode="extension">
        <xpath expr="//div[@id='filter_rounding_unit']" position="before">
            
            <!-- Obras filter -->
            <t t-if="'work_ids' in controller.cachedFilterOptions">
                <div id="filter_work" class="o-dropdown dropdown o-dropdown--no-caret">
                    <Dropdown menuClass="'o-dropdown--narrow'">
                        <button class="btn btn-secondary">
                            <i class="fa fa-folder-open me-1"/>Obras
                        </button>
                        <t t-set-slot="content">
                            <div class="dropdown-item gap-2 align-items-center">
                                <label>Obras</label>
                                <MultiRecordSelector t-props="getMultiRecordSelectorProps('sale.order.work', 'work_ids')"/>
                            </div>
                        </t>
                    </Dropdown>
                </div>
            </t>
            
            <!-- Cuentas filter -->
            <t t-if="'account_ids' in controller.cachedFilterOptions">
                <div id="filter_account" class="o-dropdown dropdown o-dropdown--no-caret">
                    <Dropdown menuClass="'o-dropdown--narrow'">
                        <button class="btn btn-secondary">
                            <i class="fa fa-folder-open me-1"/>Cuentas
                        </button>
                        <t t-set-slot="content">
                            <div class="dropdown-item gap-2 align-items-center">
                                <label>Cuentas</label>
                                <MultiRecordSelector t-props="getMultiRecordSelectorProps('account.account', 'account_ids')"/>
                            </div>
                        </t>
                    </Dropdown>
                </div>
            </t>
            
        </xpath>
    </t>
    
</templates>