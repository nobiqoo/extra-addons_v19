<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_sale_order_work_form" model="ir.ui.view">
            <field name="name">view.sale.order.work.form</field>
            <field name="model">sale.order.work</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Terceros">
                                <field name="partner_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_sale_order_work_tree" model="ir.ui.view">
            <field name="name">view.sale.order.work.tree</field>
            <field name="model">sale.order.work</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="action_sale_order_work_form" model="ir.actions.act_window">
            <field name="name">Obras</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sale.order.work</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear una Obra
              </p>
            </field>
        </record>

        <menuitem 
            id="menu_sale_order_work_form"
            action="action_sale_order_work_form"
            name="Obras"
            sequence="30"
            parent="contacts.res_partner_menu_config"/>
    </data>
</odoo>