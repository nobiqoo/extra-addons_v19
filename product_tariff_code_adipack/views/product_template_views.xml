<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="product_template_form_view_inherit_tariff_code" model="ir.ui.view">
    <field name="name">product.template.form.view.inherit.tariff.code</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="model">product.template</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='product_tag_ids']" position="after">
        <field name="tariff_code" />
      </xpath>
    </field>
  </record>
</odoo>