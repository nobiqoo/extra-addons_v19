<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="mrp_routing_workcenter_form_view_inh" model="ir.ui.view">
            <field name="name">mrp.routing.workcenter.form.view.inh</field>
            <field name="model">mrp.routing.workcenter</field>
            <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group/group[@name='workorder']/field[@name='time_cycle']" position="after">
                    <field name="is_fixed_time"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>