<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.form.l10n_co_bloodo_geoflora</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_co_bloodo.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='einvoicing']//field[@name='ei_fiscal_respo']" position="after">
                <field name="ei_fiscal_respo_en"/>
            </xpath>
            <xpath expr="//page[@name='einvoicing']//field[@name='tributary_information']" position="after">
                <field name="tributary_information_en" placeholder="Tax information" widget="html"/>
            </xpath>
            <xpath expr="//page[@name='einvoicing']" position="inside">
                <group string="Representación gráfica" name="rg_geoflora">
                    <field name="rg_group_invoice_lines"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
