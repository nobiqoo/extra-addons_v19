<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr.payroll.gt</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//block[@name='employee_rights_setting_container']" position="after">
                    <block title="Políticas de nómina" name="payroll_gt_policies" invisible="chart_template != 'gt'">
                        <setting id="payroll_gt_policies_group_1" invisible="True">
                            <div class="d-flex mt-1">
                                <field name="assumed_disability_february_gt" class="ml14"/>
                                <label for="assumed_disability_february_gt" class="o_light_label"/>
                            </div>
                            <div class="d-flex mt-1">
                                <field name="pay_advance_vacation_gt" class="ml14"/>
                                <label for="pay_advance_vacation_gt" class="o_light_label"/>
                            </div>
                            <div class="d-flex mt-1">
                                <field name="does_not_allow_ibd_less_than_smmlv_gt" class="ml14"/>
                                <label for="does_not_allow_ibd_less_than_smmlv_gt" class="o_light_label"/>
                            </div>
                            <div class="d-flex mt-1">
                                <field name="deductions_with_previous_ibc_gt" class="ml14"/>
                                <label for="deductions_with_previous_ibc_gt" class="o_light_label"/>
                            </div>
                        </setting>
                        <setting id="payroll_gt_policies_group_2" string="Porcentajes">
                            <div class="d-flex mt-1" invisible="not apply_prim_conv">
                                <label for="percentage_igss" class="o_light_label w-100"/>
                                <field name="percentage_igss" class="ml16 w-25"/>
                            </div>
                            <table>
                                <tr>
                                    <th></th>
                                    <th>Empleado</th>
                                </tr>
                                <tr>
                                    <th class="px-3">IGSS</th>
                                    <td><field name="percentage_igss" /></td>
                                </tr>
                            </table>
                        </setting>
                        <setting id="payroll_gt_policies_group_3">
                            <div class="d-flex mt-1">
                                <label for="rate_prv_agu_gt" class="o_light_label w-100"/>
                                <field name="rate_prv_agu_gt" class="ml16 w-25"/>
                            </div>
                            <div class="d-flex mt-1">
                                <label for="rate_prv_bon_14" class="o_light_label w-100"/>
                                <field name="rate_prv_bon_14" class="ml16 w-25"/>
                            </div>
                            <div class="d-flex mt-1">
                                <label for="rate_prv_vac_gt" class="o_light_label w-100"/>
                                <field name="rate_prv_vac_gt" class="ml16 w-25"/>
                            </div>
                            <div class="d-flex mt-1">
                                <label for="rate_prv_ind_gt" class="o_light_label w-100"/>
                                <field name="rate_prv_ind_gt" class="ml16 w-25"/>
                            </div>
                            <div class="d-flex mt-1">
                                <label for="rate_prv_cuo_pat" class="o_light_label w-100"/>
                                <field name="rate_prv_cuo_pat" class="ml16 w-25"/>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>