<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slow_movement_report_wizard_form" model="ir.ui.view">
        <field name="name">slow.movement.report.wizard.form</field>
        <field name="model">slow.movement.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Lento Movimiento">
                <group>
                    <div class="o_form_label">Generar el reporte de lento movimiento con las existencias actuales.</div>
                </group>
                <footer>
                    <button name="action_generate_excel"
                            string="Descargar Excel"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_slow_movement_report_wizard" model="ir.actions.act_window">
        <field name="name">Lento Movimiento</field>
        <field name="res_model">slow.movement.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_slow_movement_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_slow_movement_report"
              name="Lento Movimiento"
              parent="stock.menu_warehouse_report"
              action="action_slow_movement_report_wizard"
              sequence="90"/>
</odoo>
