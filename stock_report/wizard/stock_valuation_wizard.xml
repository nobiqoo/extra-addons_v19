<odoo>
    <record id="stock_valuation_report_view_form" model="ir.ui.view">
        <field name="name">stock.valuation.report.view.form</field>
        <field name="model">stock.valuation.report</field>
        <field name="arch" type="xml">
            <form string="Report">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from" />
                            <field name="date_to" />
                        </group>
                        <group>
                            <field name="categories_ids" widget="many2many_tags" />
                            <field name="products_ids" domain="[('type','=','consu')]"
                                widget="many2many_tags" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Report" name="action_report" type="object" class="oe_highlight" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="stock_valuation_report_action" model="ir.actions.act_window">
        <field name="name">Stock Valuation Report</field>
        <field name="res_model">stock.valuation.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="stock_valuation_report_menu" action="stock_valuation_report_action"
        parent="stock.menu_warehouse_report" sequence="120" />
</odoo>