<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable_last_movement" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.last.movement</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <field name="inventory_quantity_auto_apply" position="after">
                <field name="last_movement_system_date"
                       string="Último movimiento Sistema"
                       readonly="1"
                       optional="show"/>
                <field name="last_movement_user_date"
                       string="Último movimiento Usuario"
                       optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_form_last_movement" model="ir.ui.view">
        <field name="name">stock.quant.form.last.movement</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id'][@groups='stock.group_stock_multi_locations']" position="after">
                <field name="last_movement_system_date" readonly="1"/>
                <field name="last_movement_user_date"/>
            </xpath>
        </field>
    </record>
</odoo>
