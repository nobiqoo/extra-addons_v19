    <record id="view_project_task_form_helpdesk_ticket" model="ir.ui.view">
        <field name="name">project.task.form.helpdesk.ticket</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <button name="action_dependent_tasks" position="after">
                <button name="action_open_helpdesk_ticket" type="object" string="Tickets" class="btn-secondary" icon="fa-ticket">
                    <field name="count_helpdesk_tickets" widget="statinfo" string="Tickets"/>
                </button>
            </button>
        </field>
    </record>
    <record id="view_project_task_form_inherit_dependents_btn" model="ir.ui.view">
        <field name="name">project.task.form.inherit.dependents.btn</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button type="object" name="action_view_dependents" string="Dependientes" class="oe_stat_button" icon="fa-code-fork"/>
            </xpath>
            <xpath expr="//page[@name='sub_tasks_page']" position="inside">
                <group string="Dependencias" colspan="2">
                    <field name="predecessor_task_id" readonly="1"/>
                    <field name="x_is_blocked" readonly="1"/>
                    <field name="next_stage_id" readonly="1"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='child_ids']/tree|//field[@name='child_ids']/list" position="inside">
                <field name="x_is_blocked" readonly="1" optional="hide"/>
                <field name="next_stage_id" readonly="1" optional="hide"/>
            </xpath>
            <!-- <xpath expr="//sheet/notebook" position="inside">
