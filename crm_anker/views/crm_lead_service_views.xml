<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_crm_lead_service_tree" model="ir.ui.view">
            <field name="name">crm.lead.service.tree</field>
            <field name="model">crm.lead.service</field>
            <field name="arch" type="xml">
                <list string="Servicios">
                    <field name="name"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <record id="view_crm_lead_service_form" model="ir.ui.view">
            <field name="name">crm.lead.service.form</field>
            <field name="model">crm.lead.service</field>
            <field name="arch" type="xml">
                <form string="Servicio">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_crm_lead_service" model="ir.actions.act_window">
            <field name="name">Tipos de servicios</field>
            <field name="res_model">crm.lead.service</field>
            <field name="view_mode">list,form</field>
        </record>
    
        <menuitem 
            id="menu_crm_lead_service_root"
            name="Tipos de servicios"
            parent="crm.crm_menu_config"
            sequence="80"
            action="action_crm_lead_service"/>

    </data>
</odoo>
