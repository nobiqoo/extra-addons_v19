<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_crm_lead_state_tree" model="ir.ui.view">
            <field name="name">crm.lead.state.tree</field>
            <field name="model">crm.lead.state</field>
            <field name="arch" type="xml">
                <list string="Estados">
                    <field name="name"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <record id="view_crm_lead_state_form" model="ir.ui.view">
            <field name="name">crm.lead.state.form</field>
            <field name="model">crm.lead.state</field>
            <field name="arch" type="xml">
                <form string="Estado">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_crm_lead_state" model="ir.actions.act_window">
            <field name="name">Estados de cliente</field>
            <field name="res_model">crm.lead.state</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem 
            id="menu_crm_lead_state_root"
            name="Estados de cliente"
            parent="crm.crm_menu_config"
            sequence="50"
            action="action_crm_lead_state"/>
            
    </data>
</odoo>
