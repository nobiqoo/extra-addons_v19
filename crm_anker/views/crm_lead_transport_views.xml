<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_crm_lead_transport_tree" model="ir.ui.view">
            <field name="name">crm.lead.transport.tree</field>
            <field name="model">crm.lead.transport</field>
            <field name="arch" type="xml">
                <list string="Transportes">
                    <field name="name"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <record id="view_crm_lead_transport_form" model="ir.ui.view">
            <field name="name">crm.lead.transport.form</field>
            <field name="model">crm.lead.transport</field>
            <field name="arch" type="xml">
                <form string="Transporte">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_crm_lead_transport" model="ir.actions.act_window">
            <field name="name">Tipos de transporte</field>
            <field name="res_model">crm.lead.transport</field>
            <field name="view_mode">list,form</field>
        </record>
    
        <menuitem 
            id="menu_crm_lead_transport_root"
            name="Tipos de transporte"
            parent="crm.crm_menu_config"
            sequence="120"
            action="action_crm_lead_transport"/>

    </data>
</odoo>
