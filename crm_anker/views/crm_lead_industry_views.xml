<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_crm_lead_industry_tree" model="ir.ui.view">
            <field name="name">crm.lead.industry.tree</field>
            <field name="model">crm.lead.industry</field>
            <field name="arch" type="xml">
                <list string="Industrias">
                    <field name="name"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <record id="view_crm_lead_industry_form" model="ir.ui.view">
            <field name="name">crm.lead.industry.form</field>
            <field name="model">crm.lead.industry</field>
            <field name="arch" type="xml">
                <form string="Industria">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_crm_lead_industry" model="ir.actions.act_window">
            <field name="name">Industrias</field>
            <field name="res_model">crm.lead.industry</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem 
            id="menu_crm_lead_industry_root"
            name="Industrias"
            parent="crm.crm_menu_config"
            sequence="70"
            action="action_crm_lead_industry"/>

    </data>
</odoo>
