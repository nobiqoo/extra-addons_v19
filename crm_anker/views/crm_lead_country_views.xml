<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_crm_lead_country_tree" model="ir.ui.view">
            <field name="name">crm.lead.country.tree</field>
            <field name="model">crm.lead.country</field>
            <field name="arch" type="xml">
                <list string="Países">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_crm_lead_country_form" model="ir.ui.view">
            <field name="name">crm.lead.country.form</field>
            <field name="model">crm.lead.country</field>
            <field name="arch" type="xml">
                <form string="País">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_crm_lead_country" model="ir.actions.act_window">
            <field name="name">Países</field>
            <field name="res_model">crm.lead.country</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem 
            id="menu_crm_lead_country_root"
            name="Países"
            parent="crm.crm_menu_config"
            sequence="100"
            action="action_crm_lead_country"/>

    </data>
</odoo>
