<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_activity_report_view_tree" model="ir.ui.view">
        <field name="name">crm.activity.report.list.anker</field>
        <field name="model">crm.activity.report</field>
        <field name="inherit_id" ref="crm.crm_activity_report_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='author_id']" position="after">
                <field name="anker_responsible_partner_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="crm_activity_report_view_search" model="ir.ui.view">
        <field name="name">crm.activity.report.search.anker</field>
        <field name="model">crm.activity.report</field>
        <field name="inherit_id" ref="crm.crm_activity_report_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_by_author_id']" position="after">
                <filter name="group_by_anker_responsible_partner_id"
                        string="Encargado de la actividad"
                        context="{'group_by': 'anker_responsible_partner_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
