<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_crm_lead_partner_type_tree" model="ir.ui.view">
            <field name="name">crm.lead.partner.type.tree</field>
            <field name="model">crm.lead.partner.type</field>
            <field name="arch" type="xml">
                <list string="Tipos de terceros">
                    <field name="name"/>
                    <field name="company_id"/>
                </list>
            </field>
        </record>

        <record id="view_crm_lead_partner_type_form" model="ir.ui.view">
            <field name="name">crm.lead.partner.type.form</field>
            <field name="model">crm.lead.partner.type</field>
            <field name="arch" type="xml">
                <form string="Tipo de tercero">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_crm_lead_partner_type" model="ir.actions.act_window">
            <field name="name">Tipos de tercero</field>
            <field name="res_model">crm.lead.partner.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem 
            id="menu_crm_lead_partner_type_root"
            name="Tipos de tercero"
            parent="crm.crm_menu_config"
            sequence="90"
            action="action_crm_lead_partner_type"/>

    </data>
</odoo>
