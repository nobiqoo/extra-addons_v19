<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_schedule_view_form" model="ir.ui.view">
        <field name="name">mail.activity.schedule.view.form.anker</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/field[@name='activity_type_id']" position="after">
                <group name="anker_responsible_group"
                       col="2"
                       invisible="res_model != 'crm.lead' or not activity_type_id">
                    <group>
                        <field name="anker_responsible_partner_id"
                               context="{'default_is_company': False, 'default_company_type': 'person'}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
