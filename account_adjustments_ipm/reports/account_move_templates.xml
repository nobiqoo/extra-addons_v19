<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_account_move_einvoicing_document_inherited" inherit_id="l10n_co_bloodo.report_account_move_einvoicing_document">
        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
            <td name="account_invoice_line_name"><span t-field="line.description" t-options="{'widget': 'text'}"/></td>
        </xpath>
        <xpath expr="//t[2]/td[1]/span[1]" position="replace">
            <span t-field="line.name" t-options="{'widget': 'text'}"/>
        </xpath>
        <xpath expr="//t[3]/td[1]/span[1]" position="replace">
            <span t-field="line.name" t-options="{'widget': 'text'}"/>
        </xpath>
    </template>

</odoo>
