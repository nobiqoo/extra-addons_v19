<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_analytic_type" model="res.groups">
            <field name="name">Analytic Type</field>
        </record>

    </data>

    <data>

        <!-- Odoo 19: res.groups ya no tiene category_id. El formulario de usuario
             solo muestra los grupos que cuelgan de un res.groups.privilege, así que
             sin este registro el grupo no se puede asignar y el campo "Tipo" de la
             cuenta analítica nunca aparece. Se enlaza desde el privilegio (group_ids)
             para que también aplique en bases ya instaladas, donde el grupo es noupdate. -->
        <record id="privilege_analytic_type" model="res.groups.privilege">
            <field name="name">Analytic Type</field>
            <field name="category_id" ref="base_data_baseline.category_1800_baseline"/>
            <field name="group_ids" eval="[Command.link(ref('group_analytic_type'))]"/>
        </record>

    </data>
</odoo>
