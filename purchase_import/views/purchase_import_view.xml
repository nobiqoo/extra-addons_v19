<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="view_purchase_import_search">
        <field name="name">view.purchase.import.search</field>
        <field name="model">purchase.import</field>
        <field name="arch" type="xml">
            <search string="Imports">
                <field name="name" />
                <field name="partner_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="currency_id" groups="base.group_multi_currency" />
                <field name="purchase_names" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="view_purchase_import_tree">
        <field name="name">view.purchase.import.tree</field>
        <field name="model">purchase.import</field>
        <field name="arch" type="xml">
            <list string="Imports">
                <field name="name" readonly="1" decoration-bf="1" />
                <field name="partner_ref" readonly="1" string="Reference" />
                <field name="partner_id" readonly="1" />
                <field name="company_id" readonly="1" options="{'no_create': True}"
                    groups="base.group_multi_company" optional="show" />
                <field name="user_id" readonly="1" optional="show" widget="many2one_avatar_user" />
                <field name="currency_id" readonly="1" groups="base.group_multi_currency"
                    optional="hide" />
                <field name="state" readonly="1" widget="badge" decoration-info="state == 'draft'"
                    decoration-warning="state == 'confirm'" decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_purchase_import_form">
        <field name="name">view.purchase.import.form</field>
        <field name="model">purchase.import</field>
        <field name="arch" type="xml">
            <form string="Import">
                <header>
                    <button name="action_draft" type="object" string="Draft"
                        invisible="state != 'confirm'" />
                    <button name="action_confirm" type="object" string="Confirm"
                        invisible="state != 'draft'"
                        class="oe_highlight" />
                    <button name="action_moves" type="object" string="Products"
                        class="oe_highlight" />
                    <button name="action_lines" type="object" string="Costs" class="oe_highlight"
                        invisible="moves_ids == []" />
                    <button name="action_validate" type="object" string="Done"
                        invisible="state != 'confirm'"
                        class="oe_highlight" groups="purchase_import.purchase_import_validators"
                        confirm="Are you sure to finish the import?" />
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state not in ('draft', 'confirm')" class="btn-secondary" />
                    <button name="action_restore" type="object" string="Restore"
                        invisible="state != 'cancel'" class="btn-secondary" />
                    <field name="state" widget="statusbar" readonly="1" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_landed_costs" type="object"
                            class="oe_stat_button" icon="fa-truck"
                            invisible="landed_costs_count == 0">
                            <field name="landed_costs_count" widget="statinfo" string="Costos de Destino" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group name="group_main">
                        <group>
                            <field name="show_operations" invisible="True" />
                            <field name="immediate_transfer" invisible="True" />
                            <field name="picking_type_code" invisible="True" />
                            <field name="picking_type_id" invisible="True" />
                            <field name="use_create_lots" invisible="True" />
                            <field name="show_lots_text" invisible="True" />
                            <field name="import_type"
                                readonly="state in ('done','cancel')" />
                            <field name="incoterms_id"
                                readonly="state in ('done','cancel')"
                                options="{'no_open': True}" />
                            <field name="partner_id" widget="res_partner_many2one"
                                context="{'res_partner_search_mode': 'supplier', 'show_vat': True}"
                                readonly="state in ('done','cancel')" />
                            <field name="partner_ref"
                                readonly="state in ('done','cancel')" />
                            <field name="country_id" options="{'no_open': True}"
                                readonly="state in ('done','cancel')" />
                            <label for="currency_id" />
                            <div name ="div_currency" class="o_row">
                                <field name="currency_id" invisible="1" />
                                <field name="currency_id" groups="base.group_multi_currency"
                                    readonly="state != 'draft'" />
                                <field name="rate_currency" groups="base.group_multi_currency" />
                                <span>/</span>
                                <field name="rate_inverse" groups="base.group_multi_currency" />
                            </div>
                        </group>
                        <group name="group_dates">
                            <field name="date_rate"
                                readonly="state in ('done','cancel')" />
                            <field name="date_load"
                                readonly="state in ('done','cancel')" />
                            <field name="date_origin" />
                            <field name="date_port" />
                            <field name="date_import"
                                readonly="state in ('done','cancel')" />
                            <!-- <field name="date_nationalization"
                                readonly="state in ('done','cancel')" /> -->
                            <field name="date_destination"
                                readonly="state in ('done','cancel')" />
                        </group>
                        <group name="group_cost" string="Cost">
                            <field name="cost_type"
                                readonly="state in ('done','cancel')" />
                            <field name="price_cost" readonly="1" />
                            <field name="manual_insurance" string="Insurance"
                                readonly="state in ('done','cancel')" invisible="1" />
                            <field name="manual_freight" string="Freight"
                                readonly="state in ('done','cancel')" invisible="1" />
                            <field name="price_insurance" invisible="1" />
                            <field name="price_freight" invisible="1" />
                            <field name="price_tariff" invisible="1" />
                            <field name="price_total" invisible="1" />
                        </group>
                        <group name="group_expense" string="Expenses">
                            <field name="expense_insurance" string="Insurance"
                                widget="monetary" options="{'currency_field': 'currency_id'}" />
                            <field name="expense_freight" string="Freight"
                                widget="monetary" options="{'currency_field': 'currency_id'}" />
                            <field name="price_tariff" string="Arancel"
                                widget="monetary" options="{'currency_field': 'currency_id'}" />
                            <field name="price_taxes" string="Impuestos"
                                widget="monetary" options="{'currency_field': 'currency_id'}" />
                            <field name="price_expense" string="Gasto" readonly="1"
                                invisible="state != 'done'" />
                            <field name="price_expenses" string="Gasto"
                                invisible="state == 'done'"
                                widget="monetary" options="{'currency_field': 'currency_id'}" />
                            <field name="cost_id" invisible="cost_id == False"
                                readonly="1" groups="base.group_no_one" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Purchases"
                            invisible="import_type != 'purchase'">
                            <field name="purchases_ids"
                                readonly="state != 'draft'"
                                domain="[('state','in',('purchase','done'))]" />
                        </page>
                        <page string="Pickings"
                            invisible="import_type != 'picking'">
                            <field name="pickings_ids"
                                readonly="state != 'draft'"
                                domain="[('state','not in',('done','cancel'))]" />
                        </page>
                        <page string="Products">
                            <field name="moves_ids" mode="list,kanban" widget="stock_move_one2many"
                                readonly="state in ('done', 'cancel')"
                                context="{'form_view_ref': 'stock.view_stock_move_operations'}">
                                <list
                                    decoration-muted="state == 'cancel' or (state == 'done' and is_locked == True)"
                                    string="Stock Moves" editable="bottom" create="0" edit="1">
                                    <field name="company_id" column_invisible="True" />
                                    <field name="state" readonly="0" column_invisible="True" />
                                    <field name="picking_type_id" column_invisible="True" />
                                    <field name="move_line_ids" column_invisible="True" />
                                    <field name="location_id" column_invisible="True" />
                                    <field name="location_dest_id" column_invisible="True" />
                                    <field name="partner_id" column_invisible="True"
                                        readonly="state == 'done'" />
                                    <field name="picking_code" column_invisible="True" />
                                    <field name="show_details_visible" column_invisible="True" />
                                    <field name="additional" column_invisible="True" />
                                    <field name="move_lines_count" column_invisible="True" />
                                    <field name="is_locked" column_invisible="True" />
                                    <field name="has_tracking" column_invisible="True" />
                                    <field name="display_assign_serial" column_invisible="True" />
                                    <field name="product_id"
                                        context="{'default_detailed_type': 'product'}" required="1"
                                        readonly="(state != 'draft' and not additional) or move_lines_count &gt; 0"
                                        force_save="1" />
                                    <field name="description_picking" string="Description"
                                        optional="hide" />
                                    <field name="date" optional="hide" />
                                    <field name="date_deadline" optional="hide" />
                                    <field name="is_quantity_done_editable" column_invisible="True" />
                                    <field name="show_quant" column_invisible="True" />
                                    <field name="show_lots_text" column_invisible="True" />
                                    <field name="show_lots_m2o" column_invisible="True" />
                                    <field name="display_assign_serial" column_invisible="True" />
                                    <field name="is_initial_demand_editable" column_invisible="True" />
                                    <field name="display_import_lot" column_invisible="True" />

                                    <field name="x_dim_number" string="DIM"
                                        optional="hide"
                                        readonly="state in ('done', 'cancel')" />
                                    <field name="product_uom_qty" string="Demand"
                                        readonly="not is_initial_demand_editable" />
                                    <field name="forecast_expected_date" column_invisible="True" />
                                    <field name="forecast_availability" string="Forecast"
                                        optional="hide"
                                        column_invisible="parent.state in ('draft', 'done') or parent.picking_type_code != 'outgoing'"
                                        widget="forecast_widget" />
                                    <field name="product_qty" readonly="1" column_invisible="True" />
                                    <field name="quantity" string="Quantity"
                                        readonly="not is_quantity_done_editable"
                                        column_invisible="parent.state=='draft'"
                                        decoration-danger="product_uom_qty and quantity &gt; product_uom_qty and parent.state not in ['done', 'cancel']" />
                                    <field name="product_uom"
                                        readonly="state != 'draft' and not additional"
                                        options="{'no_open': True, 'no_create': True}" string="Unit"
                                        groups="uom.group_uom" />
                                    <field name="product_uom" groups="!uom.group_uom"
                                        column_invisible="True" />
                                    <field name="picked" optional="hide"
                                        column_invisible="parent.state=='draft'" />
                                    <field name="lot_ids" widget="many2many_tags"
                                        column_invisible="parent.state == 'draft'"
                                        groups="stock.group_production_lot"
                                        invisible="not show_details_visible or has_tracking != 'serial'"
                                        optional="hide"
                                        options="{'create': [('parent.use_create_lots', '=', True)]}"
                                        context="{'default_company_id': company_id, 'default_product_id': product_id, 'active_picking_id': parent.id}"
                                        domain="[('product_id','=',product_id)]" />
                                    <!-- <button name="action_assign_serial" type="object"
                                        icon="fa-plus-square" role="img"
                                        title="Assign Serial Numbers"
                                        invisible="not display_assign_serial" /> -->
                                    <button type="object" name="action_product_forecast_report"
                                        title="Forecast Report" icon="fa-area-chart"
                                        invisible="quantity == 0 and forecast_availability &lt;= 0 or (parent.picking_type_code == 'outgoing' and state != 'draft')" />
                                    <button type="object" name="action_product_forecast_report"
                                        title="Forecast Report" icon="fa-area-chart text-danger"
                                        invisible="quantity &gt; 0 or forecast_availability &gt; 0 or (parent.picking_type_code == 'outgoing' and state != 'draft')" />
                                    <button type="object" name="action_open_product_form"
                                        title="Ver Producto" icon="fa-external-link"
                                        invisible="not product_id" />
                                    <button type="object" name="action_open_move_form"
                                        title="Ver Detalle" icon="fa-list"
                                        invisible="not id" />
                                </list>
                            </field>
                        </page>
                        <page string="Costs">
                            <field name="line_ids" nolabel="1" readonly="1">
                                <form string="Line">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="import_id" invisible="1" />
                                                <field name="move_id" invisible="1" />
                                                <field name="line_id" invisible="1" />
                                                <field name="currency_id" invisible="1" />
                                                <field name="company_currency_id" invisible="1" />
                                                <field name="product_id" />
                                                <field name="name" />
                                                <field name="product_qty" />
                                                <field name="product_uom" groups="uom.group_uom" />
                                                <field name="product_equal" invisible="1" />
                                                <field name="product_weight" />
                                                <field name="product_volume" />
                                            </group>
                                            <group>
                                                <field name="price_unit" />
                                                <field name="price_cost" />
                                                <field name="price_insurance" />
                                                <field name="price_freight" />
                                                <field name="price_cif" />
                                                <!-- <field name="tariffes_ids" widget="many2many_tags" /> -->
                                                <field name="price_tariff" />
                                                <!-- <field name="taxes_ids" widget="many2many_tags" /> -->
                                                <!-- <field name="price_tax" /> -->
                                                <field name="price_expense" />
                                                <field name="price_subtotal" />
                                                <field name="price_total" />
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                                <list editable="bottom" string="Lines">
                                    <field name="import_id" column_invisible="1" optional="hide" />
                                    <field name="move_id" column_invisible="1" optional="hide" />
                                    <field name="line_id" column_invisible="1" optional="hide" />
                                    <field name="currency_id" column_invisible="1" optional="hide" />
                                    <field name="product_id" />
                                    <field name="name" optional="hide" />
                                    <field name="product_qty" sum="Quantity" />
                                    <field name="product_uom" groups="uom.group_uom" />
                                    <field name="product_equal" column_invisible="1" />
                                    <field name="product_weight" optional="hide" sum="Weight" />
                                    <field name="product_volume" optional="hide" sum="Volume" />
                                    <field name="price_unit" sum="price" />
                                    <field name="price_unit_currency" optional="hide" sum="price" />
                                    <field name="price_cost" sum="Cost" />
                                    <field name="price_cost_currency" sum="Cost" optional="hide" />
                                    <field name="price_insurance" optional="hide" sum="Insurance" />
                                    <field name="price_insurance_currency" optional="hide"
                                        sum="Insurance" />
                                    <field name="price_freight" optional="hide" sum="Freight" widget="monetary" options="{'currency_field': 'currency_id'}" />
                                    <field name="price_freight_currency" optional="hide"
                                        sum="Freight" />
                                    <field name="price_cif" sum="CIF" optional="hide" />
                                    <field name="price_cif_currency" sum="CIF" optional="hide" />
                                    <!-- <field name="tariffes_ids" widget="many2many_tags"
                                        optional="hide" /> -->
                                    <field name="price_tariff" string="Tariff" sum="Tariff" optional="show" />
                                    <field name="price_tariff_currency" string="Arancel en moneda" sum="Tariff" optional="hide" />
                                    <field name="price_import_tax" string="Impuestos" sum="Impuestos" optional="show" />
                                    <field name="price_import_tax_currency" string="Impuestos en moneda" sum="Impuestos" optional="hide" />
                                    <!-- <field name="taxes_ids" widget="many2many_tags" optional="hide" /> -->
                                    <!-- <field name="price_tax" sum="Tax" optional="hide" /> -->
                                    <!-- <field name="price_tax_currency" sum="Tax" optional="hide" /> -->
                                    <field name="price_expense" string="Gasto" sum="Gastos" optional="show" />
                                    <field name="price_expense_currency" string="Gasto en moneda" sum="Gastos"
                                        optional="hide" />
                                    <field name="price_subtotal" sum="Subtotal" optional="show" />
                                    <field name="price_subtotal_currency" sum="Subtotal"
                                        optional="hide" />
                                    <field name="price_total" sum="Total" />
                                    <field name="price_total_currency" sum="Total" optional="hide" />
                                    <field name="price_total_unit" optional="hide" sum="Total" />
                                    <field name="price_total_unit_currency" sum="Total"
                                        optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page string="Invoices"
                            invisible="state in ('draft','cancel')">
                            <field name="invoices_ids"
                                readonly="state in ('done','cancel')"
                                domain="[('move_type','=','in_invoice'),('state','!=','cancel')]"
                                context="{'default_move_type': 'in_invoice'}">
                                <list>
                                    <field name="name" string="Bill" />
                                    <field name="ref" optional="show" />
                                    <field name="partner_id" />
                                    <field name="invoice_date" />
                                    <field name="import_type" />
                                    <field name="amount_untaxed_signed" string="Untaxed" />
                                    <field name="amount_total_signed" string="Total" />
                                    <field name="payment_state" widget="badge" optional="hide" />
                                    <field name="state" widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'posted'" />
                                </list>
                            </field>
                        </page>
                        <page string="Other Information">
                            <group>
                                <group name="other_info">
                                    <field name="user_id" widget="many2one_avatar_user"
                                        readonly="True" />
                                    <field name="company_id" groups="base.group_multi_company"
                                        options="{'no_create': True}" />
                                    <field name="purchase_names" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_purchase_import">
        <field name="name">Imports</field>
        <field name="res_model">purchase.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_purchase_import"
        parent="menu_purchase_import_parent"
        action="act_purchase_import"
        sequence="5" />
</odoo>