<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_import_dim_wizard_form" model="ir.ui.view">
        <field name="name">import.dim.wizard.form</field>
        <field name="model">import.dim.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar DIM">
                <group invisible="state == 'done'">
                    <group>
                        <field name="file_data" filename="file_name" widget="binary"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group>
                        <p class="text-muted">
                            El archivo debe tener las columnas:<br/>
                            <b>Recepción</b> | <b>Producto</b> | <b>DIM</b><br/>
                            Se aceptan formatos <b>.xlsx</b> y <b>.csv</b>.
                        </p>
                    </group>
                </group>
                <field name="result_log" widget="text" readonly="1"
                       invisible="state == 'draft'"
                       style="font-family: monospace; min-height: 200px;"/>
                <field name="state" invisible="1"/>
                <footer>
                    <button name="action_import" type="object" string="Importar"
                            class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_dim_wizard" model="ir.actions.act_window">
        <field name="name">Importar DIM</field>
        <field name="res_model">import.dim.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_import_dim_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_import_dim_wizard"
        name="Importar DIM"
        parent="menu_purchase_import_parent"
        action="action_import_dim_wizard"
        sequence="20"/>
</odoo>
