<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- DIM en la fila expandible inline (pestaña Operaciones) -->
    <record id="view_stock_move_line_operation_tree_dim" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.dim</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="x_dim_number"
                       string="DIM"
                       column_invisible="parent.picking_code != 'incoming'"/>
            </xpath>
        </field>
    </record>

    <!-- DIM en la vista detalle (botón Detalles / pestaña Movimientos) -->
    <record id="view_stock_move_line_detailed_operation_tree_dim" model="ir.ui.view">
        <field name="name">stock.move.line.operations.detailed.list.dim</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="before">
                <field name="x_dim_number"
                       string="DIM"
                       column_invisible="context.get('picking_code') != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
