<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_import_btn" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.import.btn</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Insertamos en la button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_imports"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-ship">
                    <field name="import_count" widget="statinfo" string="Importaciones"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
