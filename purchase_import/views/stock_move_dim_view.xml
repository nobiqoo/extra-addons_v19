<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_move_dim_list" model="ir.ui.view">
        <field name="name">stock.move.dim.list</field>
        <field name="model">stock.move</field>
        <field name="arch" type="xml">
            <list string="DIM - Recepciones" import="1" export_xlsx="1" create="0" delete="0">
                <field name="picking_id" string="Recepción" readonly="1"/>
                <field name="partner_id" string="Proveedor" readonly="1"/>
                <field name="product_id" string="Producto" readonly="1"/>
                <field name="x_dim_number" string="DIM"/>
                <field name="product_uom_qty" string="Demanda" readonly="1"/>
                <field name="quantity" string="Cantidad" readonly="1"/>
                <field name="state" string="Estado" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_stock_move_dim_receipts" model="ir.actions.act_window">
        <field name="name">DIM - Recepciones</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_stock_move_dim_list"/>
        <field name="domain">[('picking_type_id.code', '=', 'incoming'), ('state', 'not in', ['draft', 'cancel'])]</field>
    </record>

    <menuitem
        id="menu_stock_move_dim_receipts"
        name="DIM - Recepciones"
        parent="menu_purchase_import_parent"
        action="action_stock_move_dim_receipts"
        sequence="10"/>
</odoo>
