<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inventory_turnover_analysis_wizard_view_form" model="ir.ui.view">
        <field name="name">inventory.turnover.analysis.wizard.form</field>
        <field name="model">inventory.turnover.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Inventory turnover analysis">
                <sheet>
                    <div class="oe_title">
                        <h1>Inventory turnover analysis</h1>
                    </div>
                    <group >
                        <group name="select_date" string="Select Date">
                            <field name="start_date" options="{ 'no_create': True }" placeholder="Select date from..."/>
                            <field name="end_date" options="{ 'no_create': True }" placeholder="Select date to..."/>
                        </group>
                        <group name="select_features" string="Select Features">
                            <field name="product_ids" options="{ 'no_create': True }" widget="many2many_tags"/>
                            <field name="category_ids" options="{ 'no_create': True }" widget="many2many_tags"/>
                            <field name="warehouse_ids" options="{ 'no_create': True }" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Generate Report" type="object" name="button_generate_report" icon="fa-refresh" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" icon="fa-times"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_inventory_turnover_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Inventory turnover analysis</field>
        <field name="res_model">inventory.turnover.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="inventory_turnover_analysis_wizard_view_form"/>
        <field name="target">new</field>
    </record>

   
    <menuitem id="menu_inventory_turnover_analysist" name="Inventory turnover analysis" action="action_inventory_turnover_analysis_wizard" parent="stock.menu_warehouse_report" sequence="302"/>
</odoo>
