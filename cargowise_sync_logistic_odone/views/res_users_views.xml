<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">

        <record id="view_users_form_simple_modif" model="ir.ui.view">
            <field name="name">res.users.cw.inherit.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='login']" position="after">
                    <field name="code_cw"/>
                </xpath>
            </field>
        </record>

        <record id="view_users_form" model="ir.ui.view">
            <field name="name">res.users.inherit.view.form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form" />
            <field name="arch" type="xml">
                <xpath expr="//page[@name='preferences']/group" position="inside">
                    <group name="cargowise" string="CargoWise">
                        <field name="code_cw" invisible="1" />
                    </group>
                </xpath>
            </field>
        </record>

        <record id="view_users_tree" model="ir.ui.view">
            <field name="name">res.users.inherit.view.tree</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='login']" position="after">
                    <field name="code_cw" invisible="1" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>
