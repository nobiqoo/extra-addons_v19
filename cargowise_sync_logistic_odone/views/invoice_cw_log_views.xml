<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="invoice_cw_log_form" model="ir.ui.view">
            <field name="name">invoice.cw.log.form</field>
            <field name="model">invoice.cw.log</field>
            <field name="arch" type="xml">
                <form edit="0" create="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="move_id"/>
                                <field name="request" filename="request_fname"/>
                                <field name="request_fname" invisible="1"/>
                            </group>
                            <group>
                                <field name="type_doc"/>
                                <field name="response" filename="response_fname"/>
                                <field name="response_fname" invisible="1"/>
                                <field name="code_cw"/>
                                <field name="ref_inv_cw_id"/>
                            </group>
                        </group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="response_txt"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="invoice_cw_log_tree" model="ir.ui.view">
            <field name="name">invoice.cw.log.list</field>
            <field name="model">invoice.cw.log</field>
            <field name="arch" type="xml">
                <list edit="0" create="0" delete="0" default_order="create_date desc">
                    <field name="name"/>
                    <field name="code_cw"/>
                    <field name="type_doc"/>
                    <field name="create_date"/>
                    <field name="request" optional="show"/>
                    <field name="response" optional="show"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

    </data>
</odoo>
