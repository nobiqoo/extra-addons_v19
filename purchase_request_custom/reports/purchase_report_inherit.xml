<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit_version_after_ref_col"
        inherit_id="purchase.report_purchaseorder_document">

        <xpath expr="//div[@id='informations']/div[@t-if='o.partner_ref']" position="after">
            <div class="col">
                <strong>Versión:</strong>
                <div>
                    <t t-esc="o.version or 1" />
                </div>
            </div>
        </xpath>

    </template>
</odoo>