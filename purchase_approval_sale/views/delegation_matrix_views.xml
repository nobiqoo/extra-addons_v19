<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sale_delegation_authority_setting" model="ir.actions.act_window">
        <field name="name">Matriz de Delegación y Autoridad</field>
        <field name="res_model">sale.delegation.authority.setting</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
    <menuitem id="menu_sale_delegation_authority_root"
              name="Matriz de Delegación y Autoridad"
              parent="sale.menu_sales_config"
              action="action_sale_delegation_authority_setting"
              sequence="60"
              groups="sales_team.group_sale_manager"/>
    <record id="view_sale_delegation_authority_setting_list" model="ir.ui.view">
        <field name="name">sale.delegation.authority.setting.list</field>
        <field name="model">sale.delegation.authority.setting</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="is_default_to_sale"/>
                <field name="smmlv_value"/>
                <field name="approval_with_sequence"/>
                <field name="approval_automatic_send"/>
            </list>
        </field>
    </record>
    <record id="view_sale_delegation_authority_setting_form" model="ir.ui.view">
        <field name="name">sale.delegation.authority.setting.form</field>
        <field name="model">sale.delegation.authority.setting</field>
        <field name="arch" type="xml">
            <form string="Matriz de Delegación y Autoridad">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="is_default_to_sale"/>
                        </group>
                    </group>
                    <group string="Configuración SMMLV">
                        <field name="smmlv_code"/>
                        <field name="smmlv_value" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Ventas">
                            <group string="Aprobadores" name="approvers" colspan="2">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="approver_id"/>
                                        <field name="alternate_approver_id"/>
                                        <field name="smmlv_from"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                                <field name="approval_with_sequence"/>
                                <field name="approval_automatic_send"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
