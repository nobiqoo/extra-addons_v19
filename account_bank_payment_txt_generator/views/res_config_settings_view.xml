<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="res_config_settings_view_form_inherit_payment_order_txt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.payment.order.txt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Órdenes de pago">
                    <setting id="hide_txt_in_draft_setting"
                            string="Ocultar TXT en borrador"
                            help="Evita mostrar el botón TXT cuando la orden de pago está en estado borrador.">
                        <field name="hide_txt_in_draft"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>