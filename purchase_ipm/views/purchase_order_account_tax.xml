<odoo>
    <record id="purchase_order_form_lock_city" model="ir.ui.view">
        <field name="name">purchase.order.form.lock.city</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="account_tax.view_purchase_order_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='city_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

        </field>
    </record>
</odoo>