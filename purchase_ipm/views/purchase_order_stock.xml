<odoo>
    <record id="purchase_order_form_lock_stock" model="ir.ui.view">
        <field name="name">purchase.order.form.lock.stock</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='incoterm_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='incoterm_location']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

        </field>
    </record>
</odoo>