<odoo>
    <record id="purchase_order_form_lock_base" model="ir.ui.view">
        <field name="name">purchase.order.form.lock.base</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">

            <!-- Campo técnico -->
            <xpath expr="//form" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>
            <xpath expr="//sheet" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="can_edit_po" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <!-- purchase.order -->
            <xpath expr="//field[@name='partner_ref']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <!-- Other information: invoice/payment fields -->
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">invoice_status == 'invoiced' or locked or not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='fiscal_position_id']" position="attributes">
                <attribute name="readonly">invoice_status == 'invoiced' or locked or not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_mode_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='supplier_partner_bank_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <!-- approval and picking type fields -->
            <xpath expr="//field[@name='approval_config_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="readonly">not can_edit_po</attribute>
            </xpath>

            <!-- order_line - list -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='analytic_distribution']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='product_qty']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='qty_invoiced']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='tax_ids']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list//field[@name='price_subtotal']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- order_line - form -->
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='product_qty']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='tax_ids']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='analytic_distribution']" position="attributes">
                <attribute name="readonly">not order_id.can_edit_po</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='qty_invoiced']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

        </field>
    </record>
</odoo>