<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_biometric_raw_punch_importer" model="res.groups">
        <field name="name">Importar marcaciones biométricas</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="comment">
            Permite crear e importar registros en Marcaciones en Crudo sin autorizar su modificación o eliminación.
        </field>
    </record>

    <record id="group_biometric_raw_punch_editor" model="res.groups">
        <field name="name">Edición de marcaciones</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="comment">
            Permite modificar registros existentes en Marcaciones en Crudo.
            Debe asignarse únicamente a los responsables autorizados para corregir marcaciones.
        </field>
    </record>
</odoo>
