<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_biometric_device_check" model="ir.cron">
            <field name="name">Biometric: Device Health Check</field>
            <field name="model_id" ref="model_biometric_device_details"/>
            <field name="state">code</field>
            <field name="code">model.cron_connection_test()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
        </record>

        <record id="ir_cron_biometric_sync_time" model="ir.cron">
            <field name="name">Biometric: Sync Device Time</field>
            <field name="model_id" ref="model_biometric_device_details"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_time()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
