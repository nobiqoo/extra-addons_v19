<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dian_ai_rule_list" model="ir.ui.view">
        <field name="name">dian.ai.rule.list</field>
        <field name="model">dian.ai.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state" widget="badge" decoration-success="state == 'learned'"
                    decoration-warning="state == 'proposed'" decoration-danger="state == 'rejected'"/>
                <field name="origin"/>
                <field name="scope"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="user_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dian_ai_rule_form" model="ir.ui.view">
        <field name="name">dian.ai.rule.form</field>
        <field name="model">dian.ai.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group string="Regla">
                            <field name="active" widget="boolean_toggle"/>
                            <field name="field_name"/>
                            <field name="operation" invisible="field_name != 'tax'"/>
                            <field name="tax_id" invisible="field_name != 'tax'" options="{'no_create': True}"/>
                            <field name="original_value"/>
                            <field name="corrected_value"/>
                        </group>
                        <group string="Alcance">
                            <field name="scope"/>
                            <field name="partner_id" required="scope in ('partner_product', 'partner')"
                                invisible="scope not in ('partner_product', 'partner')" options="{'no_create': True}"/>
                            <field name="product_id" required="scope in ('partner_product', 'product')"
                                invisible="scope not in ('partner_product', 'product')" options="{'no_create': True}"/>
                            <field name="categ_id" required="scope == 'category'"
                                invisible="scope != 'category'" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group string="Origen">
                            <field name="origin"/>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Explicación">
                        <field name="explanation" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dian_ai_rule_search" model="ir.ui.view">
        <field name="name">dian.ai.rule.search</field>
        <field name="model">dian.ai.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="tax_id"/>
                <field name="explanation"/>
                <filter name="learned" string="Aprendidas" domain="[('state', '=', 'learned')]"/>
                <filter name="proposed" string="Propuestas" domain="[('state', '=', 'proposed')]"/>
                <filter name="inactive" string="Desactivadas" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_dian_ai_rule" model="ir.actions.act_window">
        <field name="name">Reglas aprendidas</field>
        <field name="res_model">dian.ai.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_learned': 1}</field>
    </record>

</odoo>
