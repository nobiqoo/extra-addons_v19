<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dian_document_form_ai" model="ir.ui.view">
        <field name="name">dian.document.form.ai</field>
        <field name="model">dian.document</field>
        <field name="inherit_id" ref="l10n_co_dian_invoice_synchronizer.view_dian_document_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_ai_process" type="object" string="Procesar con el agente"
                        invisible="ai_state not in (False, 'inbox', 'exception', 'error') or move_id"
                        groups="account.group_account_manager"/>
                    <button name="action_ai_refresh" type="object" string="Actualizar motivo"
                        invisible="ai_state != 'exception'"/>
                    <button name="action_ai_note_reviewed" type="object" string="Marcar nota revisada"
                        invisible="ai_state != 'note_alert'"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Agente IA" name="ai_agent">
                    <group>
                        <group string="Estado">
                            <field name="ai_state" widget="badge" readonly="1"/>
                            <field name="ai_exception_code" readonly="1" invisible="not ai_exception_code"/>
                            <field name="ai_attempts" readonly="1"/>
                        </group>
                        <group string="Datos del XML">
                            <field name="xml_issue_date" readonly="1"/>
                            <field name="xml_due_date" readonly="1"/>
                            <field name="xml_tax_level_codes" readonly="1"/>
                            <field name="xml_billing_reference" readonly="1" invisible="not xml_billing_reference"/>
                        </group>
                    </group>
                    <group string="Detalle" invisible="not ai_detail">
                        <field name="ai_detail" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <group string="Ejecuciones">
                        <field name="ai_run_ids" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

    <record id="view_dian_document_ai_list" model="ir.ui.view">
        <field name="name">dian.document.ai.list</field>
        <field name="model">dian.document</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="name"/>
                <field name="reception"/>
                <field name="sender"/>
                <field name="total_amount"/>
                <field name="purchase_id"/>
                <field name="move_id"/>
                <field name="xml_state" widget="badge" optional="hide"/>
                <field name="ie_event_display" widget="badge"/>
                <field name="ai_state" widget="badge"
                    decoration-success="ai_state in ('posted', 'note_reviewed')"
                    decoration-info="ai_state in ('inbox', 'processing')"
                    decoration-warning="ai_state in ('exception', 'draft', 'review', 'note_alert')"
                    decoration-danger="ai_state == 'error'"/>
                <field name="ai_exception_code"/>
                <field name="ai_detail" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_dian_document_ai_inbox" model="ir.actions.act_window">
        <field name="name">Bandeja del agente</field>
        <field name="res_model">dian.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_dian_document_ai_list"/>
        <field name="domain">[('ai_state', 'in', ('inbox', 'processing'))]</field>
    </record>

    <record id="action_dian_document_ai_exceptions" model="ir.actions.act_window">
        <field name="name">Excepciones</field>
        <field name="res_model">dian.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_dian_document_ai_list"/>
        <field name="domain">[('ai_state', 'in', ('exception', 'error', 'note_alert'))]</field>
    </record>

    <record id="action_dian_document_ai_review" model="ir.actions.act_window">
        <field name="name">Para revisar</field>
        <field name="res_model">dian.document</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_dian_document_ai_list"/>
        <field name="domain">[('ai_state', 'in', ('draft', 'review'))]</field>
    </record>

</odoo>
