<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dian_ai_run_list" model="ir.ui.view">
        <field name="name">dian.ai.run.list</field>
        <field name="model">dian.ai.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="document_id"/>
                <field name="move_id"/>
                <field name="outcome" widget="badge" decoration-success="outcome == 'posted'"
                    decoration-warning="outcome in ('draft', 'review', 'exception')" decoration-danger="outcome == 'error'"/>
                <field name="confidence"/>
                <field name="llm_model" optional="hide"/>
                <field name="input_tokens" sum="Entrada"/>
                <field name="output_tokens" sum="Salida"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dian_ai_run_form" model="ir.ui.view">
        <field name="name">dian.ai.run.form</field>
        <field name="model">dian.ai.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="document_id"/>
                            <field name="move_id"/>
                            <field name="outcome"/>
                            <field name="confidence"/>
                        </group>
                        <group>
                            <field name="agent_id"/>
                            <field name="llm_model"/>
                            <field name="user_id"/>
                            <field name="input_tokens"/>
                            <field name="cached_tokens"/>
                            <field name="output_tokens"/>
                        </group>
                    </group>
                    <group string="Motivos">
                        <field name="reasons" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Respuesta del agente">
                        <field name="response" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dian_ai_run_pivot" model="ir.ui.view">
        <field name="name">dian.ai.run.pivot</field>
        <field name="model">dian.ai.run</field>
        <field name="arch" type="xml">
            <pivot string="Tablero del agente">
                <field name="company_id" type="row"/>
                <field name="outcome" type="col"/>
                <field name="automatic" type="measure"/>
                <field name="input_tokens" type="measure"/>
                <field name="cached_tokens" type="measure"/>
                <field name="output_tokens" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_dian_ai_run_graph" model="ir.ui.view">
        <field name="name">dian.ai.run.graph</field>
        <field name="model">dian.ai.run</field>
        <field name="arch" type="xml">
            <graph string="Tablero del agente">
                <field name="create_date" interval="week"/>
                <field name="outcome"/>
            </graph>
        </field>
    </record>

    <record id="action_dian_ai_run" model="ir.actions.act_window">
        <field name="name">Tablero del agente</field>
        <field name="res_model">dian.ai.run</field>
        <field name="view_mode">pivot,graph,list,form</field>
    </record>

</odoo>
