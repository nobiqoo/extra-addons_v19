<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dian_ai_explain_wizard_form" model="ir.ui.view">
        <field name="name">dian.ai.explain.wizard.form</field>
        <field name="model">dian.ai.explain.wizard</field>
        <field name="arch" type="xml">
            <form string="Explicar al agente">
                <group>
                    <field name="move_id" readonly="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="explanation" placeholder="A este proveedor no se le practica ReteIVA porque es gran contribuyente."/>
                    <field name="line_id" options="{'no_create': True}"/>
                    <field name="scope"/>
                    <field name="operation"/>
                    <field name="tax_id" options="{'no_create': True}" required="operation"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Guardar regla" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
