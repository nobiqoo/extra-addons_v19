<odoo>
    <record id="view_account_group_form" model="ir.ui.view">
        <field name="name">view.account.group.form</field>
        <field name="model">account.group</field>
        <field name="inherit_id" ref="account.view_account_group_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="code" required="True" />
            </xpath>
            <xpath expr="//group" position="after">
                <notebook>
                    <page name="c_acc_ids" string="Cuentas calculadas">
                        <!-- <button name="update_compute_accounts_ids" string="Actualizar cuentas" type="object" class="oe_link"/>
                        <newline/> -->
                        <field name="compute_account_ids" nolabel="1" options="{'no_create_edit': True}">
                            <list>
                                <field name="code"/>
                                <field name="name"/>
                                <!-- <field name="account_type"/> -->
                                <!-- <field name="reconcile"/> -->
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_account_group_tree" model="ir.ui.view">
        <field name="name">view.account.group.tree</field>
        <field name="model">account.group</field>
        <field name="inherit_id" ref="account.view_account_group_tree"/>
        <field name="arch" type="xml">
            <field name="code_prefix_start" position="before">
                <field name="code"/>
            </field>
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">code</attribute>
            </xpath>
        </field>
    </record>

</odoo>