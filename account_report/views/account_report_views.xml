<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="account_report_form_inh" model="ir.ui.view">
            <field name="name">account.report.form.inh</field>
            <field name="model">account.report</field>
            <field name="inherit_id" ref="account_reports.account_report_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='filter_partner']" position="after">
                    <field name="filter_seller"/>
                    <field name="filter_sale_team"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>