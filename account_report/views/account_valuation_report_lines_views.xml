<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="account_valuation_report_lines_view_form">
        <field name="name">account.valuation.report.lines.view.form</field>
        <field name="model">account.valuation.report.lines</field>
        <field name="arch" type="xml">
            <form string="Informe Valorización">
                <sheet>
                    <group>
                        <group>
                            <field name="account_id" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="invoice_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group>
                            <field name="amount_income" readonly="1"/>
                            <field name="amount_invoiced" readonly="1"/>
                            <field name="amount_difference" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="account_valuation_report_lines_view_tree">
        <field name="name">account.valuation.report.lines.view.tree</field>
        <field name="model">account.valuation.report.lines</field>
        <field name="arch" type="xml">
            <list string="Informe Valorización" create="false" edit="false">
                <field name="account_id"/>
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="invoice_ids" widget="many2many_tags"/>
                <field name="move_ids" widget="many2many_tags"/>
                <field name="amount_income"/>
                <field name="amount_invoiced"/>
                <field name="amount_difference"/>
            </list>
        </field>
    </record>
</odoo>