<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="l10n_co_tr_dri_ica" model="account.report">
            <field name="name">DRI - Declaración de Retenciones del Impuesto de Industria y Comercio</field>
            <field name="root_report_id" ref="account.generic_tax_report"/>
            <field name="country_id" ref="base.co"/>
            <field name="availability_condition">country</field>
            <field name="filter_multi_company">tax_units</field>
            <field name="filter_hierarchy">never</field>
            <field name="default_opening_date_filter">previous_month</field>
            <field name="only_tax_exigible" eval="True"/>
            <field name="filter_date_range" eval="True"/>
            <field name="filter_show_draft" eval="True"/>
            <field name="filter_unreconciled" eval="False"/>
            <field name="filter_unfold_all" eval="False"/>
            <field name="filter_period_comparison" eval="True"/>
            <field name="filter_growth_comparison" eval="True"/>
            <field name="filter_journals" eval="False"/>
            <field name="filter_analytic" eval="True"/>
            <field name="filter_partner" eval="False"/>
            <field name="filter_analytic_groupby" eval="False"/>
            <field name="filter_account_type">disabled</field>
            <field name="prefix_groups_threshold">4000</field>
            <field name="column_ids">
                <record id="l10n_co_tr_dri_ica_column_0" model="account.report.column">
                    <field name="name">Balance</field>
                    <field name="expression_label">balance</field>
                    <field name="figure_type">monetary</field>
                    <field name="sequence">0</field>
                    <field name="blank_if_zero" eval="True"/>
                </record>
            </field>
        </record>

        <record id="l10n_co_tr_dri_ica_line_id311" model="account.report.line">
            <field name="report_id" ref="l10n_co_tr_dri_ica"/>
            <field name="name">Base de la Retención</field>
            <field name="sequence">0</field>
            <field name="hierarchy_level">1</field>
            <field name="foldable" eval="False"/>
        </record>

        <record id="l10n_co_tr_dri_ica_line_i01_com" model="account.report.line">
            <field name="report_id" ref="l10n_co_tr_dri_ica"/>
            <field name="name">Retenciones Comerciales</field>
            <field name="code">CODRI_I01_COM</field>
            <field name="sequence">1</field>
            <field name="hierarchy_level">3</field>
            <field name="parent_id" ref="l10n_co_tr_dri_ica_line_id311"/>
            <field name="groupby">account_id</field>
            <field name="foldable" eval="True"/>
            <field name="expression_ids">
                <record id="l10n_co_tr_dri_ica_line_i01_com_expr_0" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">tax_tags</field>
                    <field name="formula">I01_COM</field>
                    <field name="date_scope">strict_range</field>
                    <field name="green_on_positive" eval="True"/>
                    <field name="auditable" eval="True"/>
                </record>
            </field>
        </record>

        <record id="l10n_co_tr_dri_ica_line_i01_serv" model="account.report.line">
            <field name="report_id" ref="l10n_co_tr_dri_ica"/>
            <field name="name">Retenciones Servicios</field>
            <field name="code">CODRI_I01_SERV</field>
            <field name="sequence">2</field>
            <field name="hierarchy_level">3</field>
            <field name="parent_id" ref="l10n_co_tr_dri_ica_line_id311"/>
            <field name="groupby">account_id</field>
            <field name="foldable" eval="True"/>
            <field name="expression_ids">
                <record id="l10n_co_tr_dri_ica_line_i01_serv_expr_0" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">tax_tags</field>
                    <field name="formula">I01_SERV</field>
                    <field name="date_scope">strict_range</field>
                    <field name="green_on_positive" eval="True"/>
                    <field name="auditable" eval="True"/>
                </record>
            </field>
        </record>

        <record id="l10n_co_tr_dri_ica_line_i01" model="account.report.line">
            <field name="report_id" ref="l10n_co_tr_dri_ica"/>
            <field name="name">Base Total de la Retención</field>
            <field name="code">CODRI_I01</field>
            <field name="sequence">3</field>
            <field name="hierarchy_level">3</field>
            <field name="parent_id" ref="l10n_co_tr_dri_ica_line_id311"/>
            <field name="foldable" eval="False"/>
            <field name="groupby"></field>
            <field name="user_groupby"></field>
            <field name="expression_ids">
                <record id="l10n_co_tr_dri_ica_line_i01_expr_0" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">aggregation</field>
                    <field name="formula">CODRI_I01_COM.balance + CODRI_I01_SERV.balance</field>
                    <field name="date_scope">strict_range</field>
                    <field name="green_on_positive" eval="True"/>
                    <field name="auditable" eval="True"/>
                </record>
            </field>
        </record>

        <record id="l10n_co_tr_dri_ica_line_id314" model="account.report.line">
            <field name="report_id" ref="l10n_co_tr_dri_ica"/>
            <field name="name">Retención</field>
            <field name="sequence">4</field>
            <field name="hierarchy_level">1</field>
            <field name="foldable" eval="False"/>
        </record>

        <record id="l10n_co_tr_dri_ica_line_i02_com" model="account.report.line">
            <field name="report_id" ref="l10n_co_tr_dri_ica"/>
            <field name="name">Retenciones Comerciales</field>
            <field name="code">CODRI_I02_COM</field>
            <field name="sequence">5</field>
            <field name="hierarchy_level">3</field>
            <field name="parent_id" ref="l10n_co_tr_dri_ica_line_id314"/>
            <field name="groupby">account_id</field>
            <field name="foldable" eval="True"/>
            <field name="expression_ids">
                <record id="l10n_co_tr_dri_ica_line_i02_com_expr_0" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">tax_tags</field>
                    <field name="formula">I02_COM</field>
                    <field name="date_scope">strict_range</field>
                    <field name="green_on_positive" eval="True"/>
                    <field name="auditable" eval="True"/>
                </record>
            </field>
        </record>

        <record id="l10n_co_tr_dri_ica_line_i02_serv" model="account.report.line">
            <field name="report_id" ref="l10n_co_tr_dri_ica"/>
            <field name="name">Retenciones Servicios</field>
            <field name="code">CODRI_I02_SERV</field>
            <field name="sequence">6</field>
            <field name="hierarchy_level">3</field>
            <field name="parent_id" ref="l10n_co_tr_dri_ica_line_id314"/>
            <field name="groupby">account_id</field>
            <field name="foldable" eval="True"/>
            <field name="expression_ids">
                <record id="l10n_co_tr_dri_ica_line_i02_serv_expr_0" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">tax_tags</field>
                    <field name="formula">I02_SERV</field>
                    <field name="date_scope">strict_range</field>
                    <field name="green_on_positive" eval="True"/>
                    <field name="auditable" eval="True"/>
                </record>
            </field>
        </record>

        <record id="l10n_co_tr_dri_ica_line_i02" model="account.report.line">
            <field name="report_id" ref="l10n_co_tr_dri_ica"/>
            <field name="name">Total Retención</field>
            <field name="code">CODRI_I02</field>
            <field name="sequence">7</field>
            <field name="hierarchy_level">3</field>
            <field name="parent_id" ref="l10n_co_tr_dri_ica_line_id314"/>
            <field name="foldable" eval="False"/>
            <field name="groupby"></field>
            <field name="user_groupby"></field>
            <field name="expression_ids">
                <record id="l10n_co_tr_dri_ica_line_i02_expr_0" model="account.report.expression">
                    <field name="label">balance</field>
                    <field name="engine">aggregation</field>
                    <field name="formula">CODRI_I02_COM.balance + CODRI_I02_SERV.balance</field>
                    <field name="date_scope">strict_range</field>
                    <field name="green_on_positive" eval="True"/>
                    <field name="auditable" eval="True"/>
                </record>
            </field>
        </record>

    </data>
</odoo>
