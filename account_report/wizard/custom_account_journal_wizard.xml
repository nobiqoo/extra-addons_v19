<odoo>
    <record model="ir.ui.view" id="custom_account_journal_wizard_form">
        <field name="name">view.custom.account.journal.wizard.form</field>
        <field name="model">custom.account.journal.wizard</field>
        <field name="arch" type="xml">
            <form string="Journal">
                <sheet>
                    <group>
                        <group>
                            <field name="report_type" />
                            <label for="date_from" string="Date" />
                            <div class="o_row">
                                <div class="o_row">
                                    <field name="date_from" required="True" />
                                </div>
                                <field name="date_to" required="True" />
                            </div>
                            <field name="date_process"/>
                        </group>
                        <group>
                            <field name="no_zero" invisible="0"/>
                            <field name="filter_code" invisible="0"/>
                            <field name="group_by_move"/>
                            <field name="line_state" invisible="True"/>
                            <!-- <field name="group_by" invisible="True"/> -->
                            <field name="partner_by" invisible="True"/>
                        </group>
                        <group name="filter_by_range_code" string="Defina el rango" invisible="not filter_code">
                            <label for="len_code_min" string="Rango"/>
                            <div class="o_row">
                                <div class="o_row">
                                    <field name="len_code_min" required="filter_code"/>
                                </div>
                                <span class="oe_inline">A</span>
                                <field name="len_code_max" required="filter_code" />
                            </div>
                        </group>
                    </group>
                    <group string="Filters" invisible="0">
                        <group string="Diarios">
                            <field name="journal_ids" widget="many2many_tags" />
                        </group>
                        <group string="Accounts" invisible="1">
                            <field name="accounts_ids" widget="many2many_tags" />
                        </group>
                        <group string="Partners" invisible="not partner_by">
                            <field name="partners_ids" widget="many2many_tags" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="VER" class="btn-primary" name="button_preview_html" type="object" />
                    or
                    <button string="PDF" class="btn-primary" name="button_export_pdf" type="object" />
                    or
                    <button string="EXCEL" class="btn-primary" name="action_confirm" type="object" />
                    or
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="custom_action_account_journal_wizard" model="ir.actions.act_window">
        <field name="name">Otros informes libro diario</field>
        <field name="res_model">custom.account.journal.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>