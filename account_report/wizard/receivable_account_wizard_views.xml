<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="receivable_account_wizard_view_form">
            <field name="name">Informes Contables</field>
            <field name="model">receivable.account.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="report_type" required="1"/>
                                <field name="init_date" widget="datetime"
                                       invisible="report_type != 'collection'"/>
                                <field name="end_date" widget="datetime"/>
                                <field name="journal_ids" widget="many2many_tags"
                                       options="{'no_quick_create': True, 'no_create_edit': True}"/>
                                <field name="account_ids" widget="many2many_tags"
                                       options="{'no_quick_create': True, 'no_create_edit': True}"
                                       invisible="report_type != 'account'"/>
                                <field name="account_collection_ids" widget="many2many_tags"
                                       options="{'no_quick_create': True, 'no_create_edit': True}"
                                       invisible="report_type != 'collection'"/>
                                <field name="account_credit_data_ids" widget="many2many_tags"
                                       options="{'no_quick_create': True, 'no_create_edit': True}"
                                       invisible="report_type != 'credit_data'"/>
                                <field name="partner_ids" widget="many2many_tags"
                                       options="{'no_quick_create': True, 'no_create_edit': True}"/>
                                <field name="partner_tags_ids" widget="many2many_tags"
                                       options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Generar Informe" class="oe_highlight"
                                type="object" name="action_approve_request"/>
                        <button string="Cancelar" class="btn btn-secondary"
                                special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="receivable_account_wizard_action">
            <field name="name">Generar Informes Contables</field>
            <field name="res_model">receivable.account.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
            id="account_receivable_approve_wizard"
            name="Generar Informes Contables"
            parent="account_report.menu_account_report"
            action="receivable_account_wizard_action"
            groups="account.group_account_readonly"
            sequence="99"
            />

    </data>
</odoo>
