msgstr "Asiento contable"

#. module: account_move_currency_conversion
#: model:ir.model.fields,field_description:account_move_currency_conversion.field_account_bank_statement_line__line_amounts_currency_id
#: model:ir.model.fields,field_description:account_move_currency_conversion.field_account_move__line_amounts_currency_id
msgid "Line Amounts Currency"
msgstr "Montos de línea Moneda"

#. module: account_move_currency_conversion
#: model:ir.model.fields.selection,name:account_move_currency_conversion.selection__res_partner__conditioned_rate_type__percentage
msgid "Percentage"
msgstr "Porcentaje"

#. module: account_move_currency_conversion
#: model:ir.model.fields,help:account_move_currency_conversion.field_account_bank_statement_line__line_amounts_currency_id
#: model:ir.model.fields,help:account_move_currency_conversion.field_account_move__line_amounts_currency_id
msgid ""
"Technical field remembering the currency the invoice line amounts are "
"currently expressed in, so that the next time the invoice currency is "
"changed the lines can be converted from the right rate."
msgstr ""
"Campo técnico que recuerda la moneda en la que se expresan actualmente los "
"importes de las líneas de la factura, de modo que, la próxima vez que se "
"modifique la moneda de la factura, las líneas se puedan convertir aplicando "
"el tipo de cambio adecuado."

#. module: account_move_currency_conversion
#. odoo-python
#: code:addons/account_move_currency_conversion/models/account_move.py:0
msgid ""
"The line amounts were converted from %(old_currency)s to %(new_currency)s "
"using an exchange rate (TRM) of %(adjusted_trm)s %(company_currency)s per %"
"(foreign_currency)s (%(adjustment_description)s)."
msgstr ""
"Los importes de las líneas se convirtieron de %(old_currency)s a %"
"(new_currency)s utilizando un tipo de cambio (TRM) de %(adjusted_trm)s %"
"(company_currency)s por %(foreign_currency)s (%(adjustment_description)s)."

#. module: account_move_currency_conversion
#. odoo-python
#: code:addons/account_move_currency_conversion/models/account_move.py:0
msgid ""
"The line amounts were converted from %(old_currency)s to %(new_currency)s "
"using an exchange rate of %(rate)s."
msgstr ""
"Los importes de las líneas se han convertido de %(old_currency)s a %"
"(new_currency)s utilizando un tipo de cambio de %(rate)s."

#. module: account_move_currency_conversion
#. odoo-python
#: code:addons/account_move_currency_conversion/models/account_move.py:0
msgid ""
"The line amounts were converted from %(old_currency)s to %(new_currency)s "
"using the standard exchange rate (TRM) of %(base_trm)s %(company_currency)s "
"per %(foreign_currency)s (%(partner)s has no conditioned exchange rate "
"configured, or its adjustment value is zero)."
msgstr ""
"Los importes de las líneas se han convertido de %(old_currency)s a %"
"(new_currency)s utilizando el tipo de cambio estándar (TRM) de %(base_trm)s "
"%(company_currency)s por %(foreign_currency)s (%(partner)s no tiene "
"configurado ningún tipo de cambio condicionado, o su valor de ajuste es "
"cero)."

#. module: account_move_currency_conversion
#. odoo-python
#: code:addons/account_move_currency_conversion/models/account_move.py:0
msgid ""
"standard rate %(base_trm)s + a %(value)s%% conditioned adjustment "
"configured on %(partner)s"
msgstr ""
"tarifa estándar %(base_trm)s + un ajuste condicionado %(value)s%% "
"configurado en %(partner)s"

#. module: account_move_currency_conversion
#. odoo-python
#: code:addons/account_move_currency_conversion/models/account_move.py:0
msgid ""
"standard rate %(base_trm)s + the fixed conditioned adjustment of %(value)s "
"configured on %(partner)s"
msgstr ""
"tarifa estándar %(base_trm)s + el ajuste fijo condicionado de %(value)s "
"configurado en %(partner)s"

