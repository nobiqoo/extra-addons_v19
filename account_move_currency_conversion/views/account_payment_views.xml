<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_applied_exchange_rate" model="ir.ui.view">
        <field name="name">account.payment.form.applied.exchange.rate</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form" />
        <field name="arch" type="xml">
            <div name="amount_div" position="after">
                <field name="applied_exchange_rate"
                       invisible="not applied_exchange_rate"
                       readonly="1"
                       groups="base.group_multi_currency" />
            </div>
        </field>
    </record>
</odoo>
