<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_res_config_settings_account_journal" model="ir.ui.view">
            <field name="name">view.res.config.settings.account.journal</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="80" />
            <field name="inherit_id" ref="account.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <setting id="use_invoice_terms" position="after">
                    <setting class="col-xs-12 col-md-6 o_setting_box" id="active_payment_advance_div">
                        <div class="o_setting_left_pane">
                            <field name="active_payment_advance" widget="upgrade_boolean" />
                        </div>
                        <div class="o_setting_right_pane" name="show_sale_receipts_right_pane">
                            <label for="active_payment_advance" />
                            <div class="text-muted">
                                Activate functionality and restrictions for advance payments.
                            </div>
                        </div>
                    </setting>
                    <setting class="col-xs-12 col-md-6 o_setting_box" id="journal_id_div" invisible="active_payment_advance != True">
                        <div>
                            <field name="journal_id" required="active_payment_advance != False" />
                        </div>
                        <div class="o_setting_right_pane" name="show_sale_receipts_right_pane">
                            <label for="journal_id" />
                            <div class="text-muted">
                                Account Journal related to payment advance model.
                            </div>
                        </div>
                    </setting>
                    <setting class="col-xs-12 col-md-6 o_setting_box" id="voucher_account_div" invisible="active_payment_advance != True">
                        <div>
                            <field name="voucher_account_id" required="active_payment_advance != False" />
                        </div>
                        <div class="o_setting_right_pane" name="show_sale_receipts_right_pane">
                            <label for="voucher_account_id" />
                            <div class="text-muted">
                                Account for the difference in payments.
                            </div>
                        </div>
                    </setting>
                    <setting class="col-xs-12 col-md-6 o_setting_box" id="voucher_in_payment_state_div">
                        <div class="o_setting_left_pane">
                            <field name="voucher_in_payment_state" widget="upgrade_boolean" />
                        </div>
                        <div class="o_setting_right_pane" name="show_sale_receipts_right_pane">
                            <label for="voucher_in_payment_state" />
                            <div class="text-muted">
                                Set 'In Payment' state when voucher is confirm.
                            </div>
                        </div>
                    </setting>
                </setting>
                <setting id="use_invoice_terms" position="after">
                    <setting class="col-xs-12 col-md-6 o_setting_box" id="use_transient_account_div" help="Usar cuenta transitoria en pagos">
                        <field name="use_transient_account"/>
                    </setting>
                </setting>
                <xpath expr="//div[./field[@name='transfer_account_id']]" position="after">
                    <div class="row mt8">
                        <label for="advance_account_loan_id" class="col-lg-5 o_light_label" />
                        <field name="advance_account_loan_id" />
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>